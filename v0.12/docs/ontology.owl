                        <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#UnusualRestingState"/>
                        <swrl:argument2>RL_PROLONGED_RESTING_DEVIATION_INTENSITY</swrl:argument2>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
