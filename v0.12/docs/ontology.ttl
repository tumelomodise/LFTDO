:hostsDatabase rdf:type owl:ObjectProperty ;
               owl:inverseOf :isStoredOn ;
               rdfs:domain :CloudService ;
               rdfs:range :Database ;
               rdfs:comment "Cloud Service hosts some Database" ;
               rdfs:label "hostsDatabase" .


###  https://github.com/tumelomodise/LFTDO#identifies
:identifies rdf:type owl:ObjectProperty ;
            owl:inverseOf :isIdentifiedBy ;
            rdfs:domain :DetectionMethod ;
            rdfs:range :BehaviourState ;
            rdfs:comment "DetectionMethod identifies some BehaviourState" ;
            rdfs:label "identifies" .


###  https://github.com/tumelomodise/LFTDO#implements
:implements rdf:type owl:ObjectProperty ;
            owl:inverseOf :isImplementedBy ;
            rdfs:domain :SoftwareApplication ;
            rdfs:range :DetectionMethod ;
            rdfs:comment """SoftwareApplication implements some DetectionMethod.
A single App (like SoftwareApp001) can contain multiple detection \"modules\" (e.g., one for Theft, one for Health, one for Heat Detection). It can also exist with Zero methods if it’s just a data-viewer app.""" ;
            rdfs:label "implements" .


###  https://github.com/tumelomodise/LFTDO#indicatedBy
:indicatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :TheftIndicator ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :AbnormalState
                                        :EnvironmentalCondition
                                        :HealthCondition
                                      )
                        ] ;
             rdfs:comment "TheftIndicator is indicated by some Abnorma behaviour state" ;
             rdfs:label "indicatedBy" .


###  https://github.com/tumelomodise/LFTDO#influences
:influences rdf:type owl:ObjectProperty ;
            owl:inverseOf :isInfluencedBy ;
            rdfs:domain :EnvironmentalCondition ;
            rdfs:range :BehaviourState ;
            rdfs:comment "EnvironmentalCondition influences Livestock Behaviour." ;
            rdfs:label "influences" .


###  https://github.com/tumelomodise/LFTDO#initiateStatusUpdate
:initiateStatusUpdate rdf:type owl:ObjectProperty ;
                      owl:inverseOf :statusInitiatedBy ;
                      rdfs:domain :BehaviourState ;
                      rdfs:range :StatusUpdateEvent ;
                      rdfs:comment "Software Application initiate some StatusUpdateEvent" ;
                      rdfs:label "initiateStatusUpdate" .


###  https://github.com/tumelomodise/LFTDO#initiatesAlert
:initiatesAlert rdf:type owl:ObjectProperty ;
                owl:inverseOf :isAlertInitiatedBy ;
                rdfs:domain :LivestockIndicator ;
                rdfs:range :LivestockEvent ;
                rdfs:comment "TheftIndicator initiates TheftEvent" ;
                rdfs:label "initiatesAlert" .


###  https://github.com/tumelomodise/LFTDO#isAccessedBy
:isAccessedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :Database ;
              rdfs:range :SoftwareApplication ;
              rdfs:comment "Database is accessed by some SoftwareApplication" ;
              rdfs:label "isAccessedBy" .


