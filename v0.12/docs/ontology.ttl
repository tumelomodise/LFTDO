###  https://github.com/tumelomodise/LFTDO#SheepWanderingState
:SheepWanderingState rdf:type owl:Class ;
                     rdfs:subClassOf :NormalState ;
                     rdfs:comment "SheepWanderingState" ;
                     rdfs:label "SheepWanderingState" .


###  https://github.com/tumelomodise/LFTDO#SheepWithFever
:SheepWithFever rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Sheep
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :experiences ;
                                                             owl:someValuesFrom :Fever
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :hasBodyTemperature ;
                                                             owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                  owl:onDatatype xsd:decimal ;
                                                                                  owl:withRestrictions ( [ xsd:minExclusive 39.3
                                                                                                         ]
                                                                                                       )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:comment "Sheep  that hasBodyTemperature >= 40 celsius, is a Sheep with Fever" ;
                rdfs:label "SheepWithFever" .


###  https://github.com/tumelomodise/LFTDO#Sick
:Sick rdf:type owl:Class ;
      rdfs:subClassOf :HealthCondition ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :healthInfluencesBehaviourState ;
                        owl:someValuesFrom :BehaviourState
