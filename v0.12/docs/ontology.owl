        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDataTimeStamp"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>DataTransmission: Represent the flow of data between devices and cloud services.</rdfs:comment>
        <rdfs:label>DataTransmission</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Database -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Database">
