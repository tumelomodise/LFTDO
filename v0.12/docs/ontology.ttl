###  https://github.com/tumelomodise/LFTDO#GoatWithFever
:GoatWithFever rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Goat
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :experiences ;
                                                            owl:someValuesFrom :Fever
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :hasBodyTemperature ;
                                                            owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                 owl:onDatatype xsd:decimal ;
                                                                                 owl:withRestrictions ( [ xsd:minExclusive 39.3
                                                                                                        ]
                                                                                                      )
                                                                               ]
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:comment "Goat that hasBodyTemperature >= 39.7 celsius, is a Goat with Fever" ;
               rdfs:label "GoatWithFever" .


