LFTDO4:Veterinarian a owl:Class ;
    rdfs:label "Veterinarian" ;
    rdfs:comment "The veterinarian understands the behavior of domestic animals and often treats the domestic animals for diseases." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasParticipantName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasParticipantRole ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasContactNumber ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty LFTDO4:hasParticipantID ],
        LFTDO4:Participant .

LFTDO4:cowRunning001 a owl:NamedIndividual,
        LFTDO4:Running ;
    rdfs:label "CowRunning001" ;
    LFTDO4:hasBehaviourEndTime "2024-02-01T13:00:00"^^xsd:dateTime ;
    LFTDO4:hasBehaviourStartTime "2024-02-01T12:30:00"^^xsd:dateTime .

LFTDO4:hasBaseLineTemp a owl:DatatypeProperty ;
    rdfs:label "hasBaseLineTemp" ;
    rdfs:range xsd:decimal .

LFTDO4:hasCurrentStatus a owl:ObjectProperty ;
    rdfs:label "hasCurrentStatus" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range LFTDO4:StatusUpdateEvent ;
    owl:inverseOf LFTDO4:isCurrentStatusOf .

LFTDO4:hasEnvironmentDescription a owl:DatatypeProperty ;
    rdfs:label "hasEnvironmentDescription" ;
    rdfs:comment "EnvironmentCondition has some Description" ;
    rdfs:domain LFTDO4:EnvironmentalCondition ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasGeoPosition a owl:DatatypeProperty ;
    rdfs:label "hasGeoPosition" ;
    rdfs:comment "Location has some Georgraphical position" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:Device LFTDO4:Location ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasMaxLat a owl:DatatypeProperty ;
    rdfs:label "hasMaxLat" ;
    rdfs:comment "Northern Boundary" .

LFTDO4:hasPrecipitation a owl:DatatypeProperty ;
    rdfs:label "hasPrecipitation" ;
    rdfs:comment "Environmental condition has some precipitation e.g. No rain." ;
    rdfs:domain LFTDO4:EnvironmentalCondition ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasRunningSpeed a owl:DatatypeProperty ;
    rdfs:label "hasRunningSpeed" ;
    rdfs:comment "Livestock has some average running speed in (meters per seconds or kilometers per seconds)." ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasStatus a owl:DatatypeProperty ;
    rdfs:label "hasStatus" ;
    rdfs:comment """Active (Default)
Processing
Pending
Ignored
Accepted
Rejected""" ;
    rdfs:domain LFTDO4:StatusUpdateEvent ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "Accepted" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Active" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Pending" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "Rejected" ;
                                            rdf:rest () ] ] ] ] ],
        xsd:string .

LFTDO4:hasSystemStatus a owl:DatatypeProperty ;
    rdfs:label "hasSystemStatus" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:Device LFTDO4:SoftwareApplication ) ] ;
    rdfs:range xsd:string .

LFTDO4:hasWeatherCondition a owl:DatatypeProperty ;
    rdfs:label "hasWeatherCondition" ;
    rdfs:comment "Enviromental Condition has some WeatherCondition" ;
    rdfs:domain LFTDO4:EnvironmentalCondition ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:isAdjacentTo a owl:ObjectProperty ;
    rdfs:label "isAdjacentTo" ;
    rdfs:comment "A Point of Reference a location may be next to or adjacent to." ;
    rdfs:range LFTDO4:Location .

LFTDO4:isGeneratedByDevice a owl:ObjectProperty ;
    rdfs:label "isGeneratedByDevice" ;
    rdfs:comment "SensorData isGeneratedBy of some Device" ;
    rdfs:domain LFTDO4:SensorData ;
    rdfs:range LFTDO4:Device .

LFTDO4:isOwnerOfLivestock a owl:ObjectProperty ;
    rdfs:label "isOwnerOfLivestock" ;
    rdfs:comment "Farmer is an owner of some Livestock." ;
    rdfs:domain LFTDO4:Farmer ;
    rdfs:range LFTDO4:Livestock .

LFTDO4:isSuspectedOfTheft a owl:DatatypeProperty ;
    rdfs:label "isSuspectedOfTheft" ;
    rdfs:comment "is the Livestock suspected of Theft?" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:notifies a owl:ObjectProperty ;
    rdfs:label "notifies" ;
    rdfs:comment "Software Application notify some Participant" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range LFTDO4:Participant .

LFTDO4:storeData a owl:ObjectProperty ;
    rdfs:label "storeData" ;
    rdfs:comment "Database stores some Data from Sensors, SystemLogs .e.t.c." ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( LFTDO4:RoutineLogEvent LFTDO4:SensorData LFTDO4:StatusUpdateEvent ) ] ;
    rdfs:subPropertyOf owl:topObjectProperty .

LFTDO4:usesFarm a owl:ObjectProperty ;
    rdfs:label "usesFarm" ;
    rdfs:comment "Farmer uses some Farm" ;
    rdfs:domain LFTDO4:Farmer ;
    rdfs:range LFTDO4:Farm .

LFTDO4:validateStatusOfEvent a owl:ObjectProperty ;
    rdfs:label "validateStatusOfEvent" ;
    rdfs:comment "Farmer updates the status of some TheftEvent" ;
    rdfs:domain LFTDO4:Participant ;
    rdfs:range LFTDO4:StatusUpdateEvent .

:anyBehaviour a swrl:Variable .

:cSpeed a swrl:Variable .

:cattle a swrl:Variable .

:d a swrl:Variable .

:g a swrl:Variable .

:r a swrl:Variable .

