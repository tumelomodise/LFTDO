:Database001 rdf:type owl:NamedIndividual ,
                      :Database ;
             :storeData :GoatSensorData001 ,
                        :SensorData002 ,
                        :SensorData003 ,
                        :SensorData004 ;
             rdfs:label "Database001" .


###  https://github.com/tumelomodise/LFTDO#Database003
:Database003 rdf:type owl:NamedIndividual .


###  https://github.com/tumelomodise/LFTDO#DayAmbientTemp001
:DayAmbientTemp001 rdf:type owl:NamedIndividual ,
                            :EnvironmentalCondition ;
                   :OccursAtLocation :OpenFieldLocation001 ;
                   :hasEnvValue 30 ;
                   :hasEnvironmentDescription "DayTime Heat" ;
                   :hasTemporalContext "DayTime" ;
                   rdfs:label "DayAmbientTemp001" .


###  https://github.com/tumelomodise/LFTDO#EscapeDetectionMethod
:EscapeDetectionMethod rdf:type owl:NamedIndividual ,
                                :DetectionMethod ;
                       :analyses :Database003 ;
                       :isImplementedBy :SoftwareApp001 ;
                       :uses :Algorithm004 ;
                       :hasDetectionLatencyMs 1 ;
                       :hasDetectionMethodAccuracy 0.97 ;
                       :hasDetectionPriority 1 ;
                       :hasID "DET-ESCAPE-001" ;
                       :hasLastScanTime "2024-02-15T13:05:01"^^xsd:dateTime ;
                       :hasReliabilityScore 3 ;
                       :hasSensitivityLevel "High" ;
                       :hasTrainingData "true"^^xsd:boolean ;
                       :isDetectionActive "true"^^xsd:boolean ;
                       rdfs:label "EscapeDetectionMethod" .


###  https://github.com/tumelomodise/LFTDO#EscapedActivityIndicator
:EscapedActivityIndicator rdf:type owl:NamedIndividual ,
                                   :EscapeIndicator ;
                          :isDetectedBy :EscapeDetectionMethod ;
                          :triggersAlertLevel "Medium" ;
                          rdfs:label "EscapedActivityIndicator" .


###  https://github.com/tumelomodise/LFTDO#EscapedEvent
:EscapedEvent rdf:type owl:NamedIndividual ,
                       :EscapedLivestock ;
              :isDetectedBy :EscapeDetectionMethod ;
              :isRecordedIn :Database001 ;
              :isSupportedBy :EscapedActivityIndicator ;
              rdfs:label "EscapedEvent" .


###  https://github.com/tumelomodise/LFTDO#EscapedSheepState
:EscapedSheepState rdf:type owl:NamedIndividual ,
                            :AbnormalState ;
                   :isCharacterisedBy :EscapedActivityIndicator ;
                   :isOutsideGeofence "true"^^xsd:boolean ;
                   rdfs:label "EscapedSheepState" .


