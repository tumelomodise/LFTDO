:GPSTrackingMethod rdf:type owl:NamedIndividual ,
                            :DetectionMethod ;
                   :analyses :Database001 ;
                   :triggers :GoatHighTheftEvent001 ;
                   rdfs:comment "GPSTrackingSystem" .


