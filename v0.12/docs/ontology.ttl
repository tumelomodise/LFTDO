                             owl:onProperty :hasPurpose ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasResourceRequirements ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasVersion ;
                             owl:someValuesFrom xsd:string
                           ] ;
           rdfs:comment """1.Machine Learning(ML) algorithm is part of the cloud computing service for some behaviour analysis
2.ML Algorithm(MLA) uses data in the Database to detect theft""" ;
           rdfs:label "Algorithm" .


###  https://github.com/tumelomodise/LFTDO#AmbientTemperature
:AmbientTemperature rdf:type owl:Class ;
                    rdfs:subClassOf :EnvironmentalCondition ;
                    rdfs:comment """Ambient Temperature: Refers to the temperature of the surroundings, often measured in degrees Celsius or Fahrenheit. It is the temperature experienced by a person in their environment, not the temperature of the person themselves.

These refers to the warmth or coldness of the air, which influences areas such as livestock farming and human health.""" ;
                    rdfs:label "AmbientTemperature" .


