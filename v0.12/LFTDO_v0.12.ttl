LFTDO4:EscapeIndicator a owl:Class ;
    rdfs:label "EscapeIndicator" ;
    rdfs:comment "Escape Indicator may indicate that the Livestock might have escaped the Farm or restricted area." ;
    rdfs:subClassOf LFTDO4:LivestockIndicator .

LFTDO4:Fever a owl:Class ;
    rdfs:comment "Fever  is a health condition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:healthInfluencesBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasHealthDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSymptoms ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:HealthCondition .

LFTDO4:HealthDetectionMethod a owl:NamedIndividual,
        LFTDO4:DetectionMethod ;
    rdfs:label "HealthDetectionMethod"^^xsd:string ;
    LFTDO4:analyses LFTDO4:Database001 ;
    LFTDO4:hasDetectionLatencyMs 1.0 ;
    LFTDO4:hasDetectionMethodAccuracy 0.86 ;
    LFTDO4:hasDetectionPriority 1 ;
    LFTDO4:hasID "DET-HEALTH-001"^^xsd:string ;
    LFTDO4:hasLastScanTime "2024-02-15T13:05:02"^^xsd:dateTime ;
    LFTDO4:hasReliabilityScore 5.0 ;
    LFTDO4:hasSensitivityLevel "High"^^xsd:string ;
    LFTDO4:hasTrainingData true ;
    LFTDO4:isDetectionActive true ;
    LFTDO4:isImplementedBy LFTDO4:SoftwareApp002 ;
    LFTDO4:uses LFTDO4:Algorithm003 .

LFTDO4:HealthIndicator a owl:Class ;
    rdfs:label "HealthIndicator" ;
    rdfs:comment "HealthIndicator may indicate that the Livestock might have experienced some health issues in the Farm." ;
