    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasSoftwareAppType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Software has some Application Type.</rdfs:comment>
        <rdfs:label>hasSoftwareAppType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasSoftwareVersion -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasSoftwareVersion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The software application has some version.</rdfs:comment>
        <rdfs:label>hasSoftwareVersion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasSpecies -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasSpecies">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Livestock has belong to a specific type of species
&quot;Livestock species are defined as domesticated farm animals, such as buffalo, chicken, sheep, goats, pigs, cattle, duck, camel, horse, mole, and turkey, primarily raised for labor, meat, eggs, milk, fur, leather, and wool. They play a crucial role in agriculture and contribute significantly to the livelihoods of farm families.&quot; https://www.sciencedirect.com/topics/agricultural-and-biological-sciences/livestock-species</rdfs:comment>
        <rdfs:label>hasSpecies</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasSpeed -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasSpeed">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Livestock BehaviourState has some Speed measured in meters per second</rdfs:comment>
        <rdfs:comment>Livestock hasSpeed movement that can be measured based on the type of Livestock for e.g. Sheep and Goat is in meters per seconds(m/s), Cattle is in Kilometer per hour(km/h).</rdfs:comment>
        <rdfs:label>hasSpeed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasStatus -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasStatus">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Accepted</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Active</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Pending</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>Rejected</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>Active (Default)
Processing
Pending
Ignored
Accepted
Rejected</rdfs:comment>
        <rdfs:label>hasStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasStorageCapacity -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasStorageCapacity">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#CloudService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>To define the limits of the RoutineLogEvent storage.</rdfs:comment>
        <rdfs:label>hasStorageCapacity</rdfs:label>
    </owl:DatatypeProperty>
    


