}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#CloudService",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Cloud Computing Service enables the on-demand and convenient delivery of shared configurable computing resources and services over a network (Kuo, 2011, Paul and Ghose, 2012). CC plays a key role in enabling the ability of IoT devices to send, store, analyze data, and receive analyzed data remotely. CC service includes machine learning algorithms to analyze livestock behavior to detect and indicate livestock theft."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CloudService"
  } ],
