        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checks if the device is Suitable to use for rural areas?</rdfs:comment>
        <rdfs:label>isSuitableForRuralAreas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isSuspectedOfTheft -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#isSuspectedOfTheft">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>is the Livestock suspected of Theft?</rdfs:comment>
        <rdfs:label>isSuspectedOfTheft</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#lastVetCheck -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#lastVetCheck">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>lastVetCheck</rdfs:comment>
        <rdfs:label>lastVetCheck</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#representsDataType -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#representsDataType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SensorData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>SensorData has present some DataType.
&quot;Motion,&quot; &quot;Position,&quot; or &quot;Biometric&quot;</rdfs:comment>
        <rdfs:label>representsDataType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#triggersAlertLevel -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#triggersAlertLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>TheftIndicator has a triggersAlertLevel</rdfs:comment>
        <rdfs:label>triggersAlertLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://github.com/tumelomodise/LFTDO#AbnormalBodyTemperature -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#AbnormalBodyTemperature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#BodyTemperature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#healthConditionBelongsTo"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#BodyTemperature"/>
        <rdfs:comment>The Abnormal body temperature is the opposite of any normal defined body temperature for Livestock.</rdfs:comment>
        <rdfs:label>AbnormalBodyTemperature</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#AbnormalState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#AbnormalState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCharacterisedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#TheftIndicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateConfidenceScore"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateContext"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSeverityLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpeed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>Behaviour state that breaks a social norm, that is statistically infrequent and prevents livestock from functioning.

Sub-classes:
1.DistressVocalization
2.Restlessness
3.UnusualMovement</rdfs:comment>
        <rdfs:label>AbnormalState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Agression -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Agression">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>1.Aggression is a behaviour
Referenced Ontology: Aggression (ATOL:0001782)=Aggregative  behaviour (Meunier-Salaün et. al,2015)
Under Behavior trait-&gt;Motor activity-&gt;aggregative behavior.</rdfs:comment>
        <rdfs:label>Aggression</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Algorithm -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Algorithm">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAlgorithmName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasInputFeatures"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasOutputFormat"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasPurpose"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasResourceRequirements"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasVersion"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>1.Machine Learning(ML) algorithm is part of the cloud computing service for some behaviour analysis
2.ML Algorithm(MLA) uses data in the Database to detect theft</rdfs:comment>
        <rdfs:label>Algorithm</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#AmbientTemperature -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#AmbientTemperature">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
        <rdfs:comment>Ambient Temperature: Refers to the temperature of the surroundings, often measured in degrees Celsius or Fahrenheit. It is the temperature experienced by a person in their environment, not the temperature of the person themselves.

These refers to the warmth or coldness of the air, which influences areas such as livestock farming and human health.</rdfs:comment>
        <rdfs:label>AmbientTemperature</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#AudioMonitoringSystem -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#AudioMonitoringSystem">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#analyses"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#uses"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDetectionMethodAccuracy"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDetectionMethodType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasFalsePositiveRate"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasMethodAttribute"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTrainingData"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>AudioMonitoringSystem is a theft DetectionMethod</rdfs:comment>
        <rdfs:label>AudioMonitoringSystem</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#BehaviorMonitoringSystem -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#BehaviorMonitoringSystem">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#analyses"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#uses"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDetectionMethodAccuracy"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDetectionMethodType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasFalsePositiveRate"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasMethodAttribute"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTrainingData"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>BehaviourMonitoringSystem is a theft DetectionMethod</rdfs:comment>
        <rdfs:label>BehaviourMonitoringSystem</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Behaviour -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Behaviour">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Livestock behavior includes a broader range of activities exhibited by an animal over a period. It includes actions, reactions, and responses to various stimuli and situations. 

Sub-classess
1.Sleeping
2.Breeding
3.Grazing
4.Feeding
5.Sitting
6.AbnormalBehaviour
7.Agreession
8.NormalBehaviour
9.Running</rdfs:comment>
        <rdfs:label>Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#BehaviourState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#BehaviourState">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateConfidenceScore"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateContext"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpeed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Livestock behavior state the actions that are are likely and less likely to happen at any point in time such as normal behavior state that includes grazing and feeding, and abnormal behavior states such as restlessness and aggression (Dieng et al., 2017, Risteska Stojkoska et al., 2018). Behavior states are influenced by health, environmental, body conditions, and their locations at any point in time.

sub-classes:
1.NormalState
2.AbnormalState</rdfs:comment>
        <rdfs:label>BehaviourState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#BodyTemperature -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#BodyTemperature">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:comment>Body temperature serves as a key vital sign in assessing livestock health, offering important  insights into the physiological status and general well-being of animals.</rdfs:comment>
        <rdfs:label>BodyTemperature</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Boundary -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Boundary">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Location"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAdjacentTo"/>
                                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isComponentOf"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#RestrictedArea"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isMonitoredByDevice"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isUsedByFarmer"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasFence"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLatitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLongitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The RestrictedArea is a location in a farm that isSecuredGuardedBy only EndUser device.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Breeding -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Breeding">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>1.Breeding is a behaviour</rdfs:comment>
        <rdfs:label>Breeding</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Cattle -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Cattle">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibits"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#experiences"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentLocation"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#healthConfirmedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAttachedToDevice"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EndDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isLocatedAtFarm"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isOwnedByFarmer"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAge"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBreed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCattleBodyConditionScore"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minExclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGender"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGroupSize"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasRunningDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSittingDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSleepingDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpecies"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTagMark"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasWeightInKg"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isPregnant"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAnimalID"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Cattle is a livestock</rdfs:comment>
        <rdfs:label>Cattle</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CattleGrazingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CattleGrazingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>CattleGrazingState is a NormalState</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CattleRestingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CattleRestingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>CattleRestingState is a NormalState</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CattleRunningState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CattleRunningState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>CattleRunningState is a NormalState</rdfs:comment>
        <rdfs:label>CattleRunningState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CattleWanderingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CattleWanderingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:label>CattleWanderingState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CattleWithFever -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CattleWithFever">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Cattle"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#experiences"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Fever"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBodyTemperature"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">39.3</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Cattle that hasBodyTemperature &gt;= 39.4 celsius, is a Cattle with Fever</rdfs:comment>
        <rdfs:label>CattleWithFever</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CattleWithHighAbnormalBodyTempareture -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CattleWithHighAbnormalBodyTempareture">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Cattle"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBodyTemperature"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">39.3</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow&apos;s Body temperature
deviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. 

e.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [&gt;=38,&gt;39.3]</rdfs:comment>
        <rdfs:label>CattleWithHighAbnormalBodyTempareture</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CattleWithLowAbnormalBodyTempareture -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CattleWithLowAbnormalBodyTempareture">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Cattle"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBodyTemperature"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">38</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow&apos;s Body temperature
deviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. 

e.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [&gt;=38,&gt;39.3]</rdfs:comment>
        <rdfs:label>CattleWithLowAbnormalBodyTempareture</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CattleWithNormalBodyTempareture -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CattleWithNormalBodyTempareture">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Cattle"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBodyTemperature"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">38</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">39.3</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow&apos;s Body temperature
deviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. 

e.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [&gt;=38,&gt;39.3]</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#CloudService -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#CloudService">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#executesApplication"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hostsDatabase"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#cloudServiceName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCloudSecurityFeatures"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCloudServiceDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCloudServiceProvider"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCloudServiceType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Cloud Computing Service enables the on-demand and convenient delivery of shared configurable computing resources and services over a network (Kuo, 2011, Paul and Ghose, 2012). CC plays a key role in enabling the ability of IoT devices to send, store, analyze data, and receive analyzed data remotely. CC service includes machine learning algorithms to analyze livestock behavior to detect and indicate livestock theft.</rdfs:comment>
        <rdfs:label>CloudService</rdfs:label>
    </owl:Class>
    


