              rdfs:label "hasComponent" .


###  https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState
:hasCurrentBehaviourState rdf:type owl:ObjectProperty ;
                          owl:inverseOf :isCurrentBehaviourStateOf ;
                          rdfs:domain :Behaviour ;
                          rdfs:range :BehaviourState ;
                          rdfs:comment "Behaviour has some current BehaviourState" ;
                          rdfs:label "hasCurrentBehaviourState" .


###  https://github.com/tumelomodise/LFTDO#hasCurrentLocation
:hasCurrentLocation rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isCurrentLocationOf ;
                    rdfs:range :Location ;
                    rdfs:comment "Evironment condition and Livestock has a current Location at any point in time" ;
                    rdfs:label "hasCurrentLocation" .


###  https://github.com/tumelomodise/LFTDO#hasCurrentStatus
:hasCurrentStatus rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isCurrentStatusOf ;
                  rdfs:domain :Livestock ;
                  rdfs:range :StatusUpdateEvent ;
                  rdfs:label "hasCurrentStatus" .


###  https://github.com/tumelomodise/LFTDO#hasDevice
:hasDevice rdf:type owl:ObjectProperty ;
           rdfs:domain :Farm ;
           rdfs:range :Device ;
           rdfs:comment "Farm hasDevice" ;
           rdfs:label "hasDevice" .


###  https://github.com/tumelomodise/LFTDO#hasEnvironmentalContext
:hasEnvironmentalContext rdf:type owl:ObjectProperty ;
                         owl:inverseOf :isContextOf ;
                         rdfs:domain :BehaviourState ;
                         rdfs:range :EnvironmentalCondition ;
