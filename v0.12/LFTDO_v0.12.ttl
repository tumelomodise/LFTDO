LFTDO4:Database003 a owl:NamedIndividual .

LFTDO4:Drinking a owl:Class ;
    rdfs:label "Drinking" ;
    rdfs:comment """Referenced Ontology: Drinking = Drinking Behavior (ATOL:0000361) "any measurable or observable characteristic related to the consumption of liquids ressources such as water or milk" (Meunier-Salaün et. al,2015)
under: Animal trait of livestock ->pyschroneuroendocrinological state trait->ingestive behaviour->drinking behavior""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:Behaviour .

LFTDO4:EscapedEvent a owl:NamedIndividual,
        LFTDO4:EscapedLivestock ;
    rdfs:label "EscapedEvent"^^xsd:string ;
    LFTDO4:isDetectedBy LFTDO4:EscapeDetectionMethod ;
    LFTDO4:isRecordedIn LFTDO4:Database001 ;
    LFTDO4:isSupportedBy LFTDO4:EscapedActivityIndicator .

LFTDO4:EscapedLivestock a owl:Class ;
    rdfs:label "EscapedLivestock" ;
    rdfs:comment "EscapedLivestock: Is trigged by some EscapeIndicator that is identified as a Livestock that has Escaped the Farm or Known Area." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventStatus ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isTriggeredBy ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue "High" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Low" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Medium" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] ) ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventResolution ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:affectsLivestock ;
            owl:someValuesFrom LFTDO4:Livestock ],
        LFTDO4:LivestockEvent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty LFTDO4:hasAbnormalBehaviourState ;
                        owl:someValuesFrom LFTDO4:AbnormalState ] [ a owl:Restriction ;
                        owl:onProperty LFTDO4:isAlertInitiatedBy ;
                        owl:someValuesFrom LFTDO4:EscapeIndicator ] ) ] .

LFTDO4:ExtremeDayTimeHeat a owl:Class ;
    rdfs:label "ExtremeDayTimeHeat" ;
    rdfs:comment "Extereme Day Time Heat Temperature that is above than 35 degree celcius during 'DayTime'." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( LFTDO4:AmbientTemperature [ a owl:Restriction ;
                        owl:onProperty LFTDO4:hasEnvValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 35.0 ] ) ] ] [ a owl:Restriction ;
                        owl:hasValue "DayTime" ;
                        owl:onProperty LFTDO4:hasTemporalContext ] ) ] .

LFTDO4:ExtremeHeat a owl:Class ;
    rdfs:label "ExtremeHeat" ;
    rdfs:comment "ExtremeHeat is an environmental condition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasWeatherCondition ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasEnvValue ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasPrecipitation ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasEnvironmentDescription ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:AmbientTemperature .

LFTDO4:Farm001BoundaryFence a owl:NamedIndividual,
        LFTDO4:Boundary ;
    rdfs:label "Farm001BoundaryFence" .

LFTDO4:Feeding a owl:Class ;
    rdfs:label "Feeding" ;
    rdfs:comment """Referenced Ontology:
1.Feeding is a behaviour  =  feeding behavior(ATOL:0000363) "any measurable or observable characteristic related to the consumption of solid ressources for nutritionnal needs."(Meunier-Salaün et. al,2015).

In ATOL under: animal trait of livestock->animal welfare trait->psychoneuroendocrinological state trait->behaviour trait->ingestive behavior->feeding behavior""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        LFTDO4:Behaviour .

LFTDO4:GPSTrackingMethod a owl:NamedIndividual,
        LFTDO4:DetectionMethod ;
    rdfs:comment "GPSTrackingSystem" ;
    LFTDO4:analyses LFTDO4:Database001 ;
    LFTDO4:triggers LFTDO4:GoatHighTheftEvent001 .

