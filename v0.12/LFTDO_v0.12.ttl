LFTDO4:HealthAlertEvent a owl:Class ;
    rdfs:label "HealthAlertEvent" ;
    rdfs:comment "HealthAlertEvent: Alert related to Livestock Health" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue "High" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Low" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Medium" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] ) ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:affectsLivestock ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isTriggeredBy ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventStatus ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventResolution ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:LivestockEvent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty LFTDO4:hasAbnormalBehaviourState ;
                        owl:someValuesFrom LFTDO4:AbnormalState ] [ a owl:Restriction ;
                        owl:onProperty LFTDO4:isAlertInitiatedBy ;
                        owl:someValuesFrom LFTDO4:EscapeIndicator ] ) ] .

LFTDO4:HighHealthTheftIndicator002 a owl:NamedIndividual,
        LFTDO4:HealthIndicator ;
    rdfs:label "HighHealthTheftIndicator002" ;
    LFTDO4:initiatesAlert LFTDO4:ComplexTheftEvent001 ;
    LFTDO4:triggersAlertLevel "High"^^xsd:string .

LFTDO4:ModerateAmbientTemperature a owl:Class ;
    rdfs:label "ModerateAmbientTemperature" ;
    rdfs:comment "Moderate Ambient Temperature range that applies to many populated areas might be considered:Daytime: Around 20 °C to  34.9 °C." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( LFTDO4:AmbientTemperature [ a owl:Restriction ;
                        owl:onProperty LFTDO4:hasEnvValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 19.0 ] [ xsd:maxInclusive 34.9 ] ) ] ] [ a owl:Restriction ;
                        owl:hasValue "DayTime" ;
                        owl:onProperty LFTDO4:hasTemporalContext ] ) ] .

LFTDO4:MotionSensorDevice001 a owl:NamedIndividual,
        LFTDO4:Device ;
    rdfs:label "MotionSensorDevice001" ;
    LFTDO4:hasCurrentLocation LFTDO4:Farm001 ;
    LFTDO4:hasPowerStatus "Off"^^xsd:string ;
    LFTDO4:isDeviceOnline false .

LFTDO4:Movement a owl:Class ;
    rdfs:label "Movement" ;
    rdfs:comment """Referenced Ontology:
1.Movement is a behaviour
3.Different behaviour states may be observed based  on Movement rate, distance covered and  Geopositions.
Reference:
Movement = Member movement (ATOL:000842) (Meunier-Salaün et. al,2015)
Under Behavior trait->Motor activity->body movement->member movement behavior.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        LFTDO4:Behaviour .

LFTDO4:NormalGrazingIndicator a owl:Class ;
    rdfs:label "NormalGrazingIndicator" ;
    rdfs:comment "Normal Grazing Indicator may indicate that livestock is normally grazing on the Farm or Restricted area." ;
    rdfs:subClassOf LFTDO4:LivestockIndicator .

LFTDO4:Panting a owl:Class ;
    rdfs:label "Panting" ;
    rdfs:comment """Referenced Ontology:
Panting = Panting(ATOL:00832)
"any measurable or observable characteristic related to the ability of increasing breathing by polypnea or hyperpnea performed with open mouth and distinct thoracic movements, to increase O2-CO2 exchanges and/or to increase evaporative heat loss." (Meunier-Salaün et. al,2015)""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        LFTDO4:Behaviour .

LFTDO4:RestingState a owl:Class ;
    rdfs:label "RestingState" ;
    rdfs:subClassOf LFTDO4:NormalState .

