        <hasAlgorithmType>Moving Average</hasAlgorithmType>
        <hasAlgorithmVersion>v0.1</hasAlgorithmVersion>
        <hasComplexity>HIGH</hasComplexity>
        <hasDetectionMethodAccuracy rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.98</hasDetectionMethodAccuracy>
        <isOptimized rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isOptimized>
        <rdfs:comment>Algorithm002</rdfs:comment>
        <rdfs:label>Algorithm002</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://github.com/tumelomodise/LFTDO#Algorithm003 -->


