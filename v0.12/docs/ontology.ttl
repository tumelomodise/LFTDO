                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasDatabaseBackupAndRecovery ;
                            owl:someValuesFrom xsd:boolean
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasDatabaseSchema ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasDatabaseStorageCapacity ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasDatabaseType ;
                            owl:someValuesFrom xsd:string
