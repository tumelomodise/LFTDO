        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>How many milliseconds it takes to process the data. This proves &quot;Real-time&quot; capability for theft.</rdfs:comment>
        <rdfs:label>hasDetectionLatencyMs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasDetectionMethodAccuracy -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasDetectionMethodAccuracy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Algorithm"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>DetectionMethod has some Accuracy</rdfs:comment>
        <rdfs:label>hasAccuracyRate</rdfs:label>
    </owl:DatatypeProperty>
    


