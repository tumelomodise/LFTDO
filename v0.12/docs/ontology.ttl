:hasUpdateFrequency rdf:type owl:DatatypeProperty ;
                    rdfs:domain :StatusUpdateEvent ;
                    rdfs:range xsd:string ;
                    rdfs:comment """hasUpdateFrequency

hasUpdateFrequency ∈ {
  \"real-time\",
  \"near-real-time\",
  \"secondly\",
  \"sub-minute\",
  \"minutely\",
  \"five-minute\",
  \"quarter-hourly\",
  \"half-hourly\",
  \"hourly\",
  \"daily\",
  \"on-demand\",
  \"event-driven\",
  \"irregular\"
}""" ;
                    rdfs:label "hasUpdateFrequency" .


