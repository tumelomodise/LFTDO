        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#transitionsTo"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#normalState"/>
                        <swrl:argument2 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftState"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#inferredByRule"/>
                                <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftState"/>
                                <swrl:argument2>RL_COMPLEXTHEFT_CORRELATION</swrl:argument2>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasSystemStatus"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#dev"/>
                                        <swrl:argument2>Complex Theft Event detected: Multiple biological indicators to be verified</swrl:argument2>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#isCharacterisedBy"/>
                                                <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftState"/>
