}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#AmbientTemperature",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Ambient Temperature: Refers to the temperature of the surroundings, often measured in degrees Celsius or Fahrenheit. It is the temperature experienced by a person in their environment, not the temperature of the person themselves.\n\nThese refers to the warmth or coldness of the air, which influences areas such as livestock farming and human health."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "AmbientTemperature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"
  } ]
