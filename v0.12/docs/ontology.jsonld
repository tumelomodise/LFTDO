  }, {
    "@id" : "_:genid138"
  }, {
    "@id" : "_:genid139"
  }, {
    "@id" : "_:genid140"
  } ]
}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#BodyTemperature",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Body temperature serves as a key vital sign in assessing livestock health, offering important  insights into the physiological status and general well-being of animals."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BodyTemperature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://github.com/tumelomodise/LFTDO#HealthCondition"
  } ]
}, {
