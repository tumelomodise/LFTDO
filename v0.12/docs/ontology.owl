    <!-- https://github.com/tumelomodise/LFTDO#EnvironmentalCondition -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvironmentDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasPrecipitation"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasWeatherCondition"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Environmental condition influence livestock behavior, such as grazing, sleeping, and feeding, are also significantly influenced by their environmental conditions and weather changes such as rain, heat, and cold (Chaudhry et al., 2020).

Sub-classes:
1.ExtreamHeat</rdfs:comment>
        <rdfs:label>EnvironmentalCondition</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#EnvironmentalIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#EnvironmentalIndicator">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#EscapeIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#EscapeIndicator">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>Escape Indicator may indicate that the Livestock might have escaped the Farm or restricted area.</rdfs:comment>
        <rdfs:label>EscapeIndicator</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#EscapedLivestock -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#EscapedLivestock">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAbnormalBehaviourState"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EscapeIndicator"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>High</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Low</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Medium</owl:hasValue>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#affectsLivestock"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isTriggeredBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventResolution"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventStatus"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>EscapedLivestock: Is trigged by some EscapeIndicator that is identified as a Livestock that has Escaped the Farm or Known Area.</rdfs:comment>
        <rdfs:label>EscapedLivestock</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#ExtendedOfficer -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#ExtendedOfficer">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasContactNumber"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantRole"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantID"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>ExtendedOfficer assist with managing some Livestock.
Extended officers, work on a farm, to manage livestock such as feeding, keeping count, managing their well-being, and protecting against theft.</rdfs:comment>
        <rdfs:label>ExtendedOfficer</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#ExtremeDayTimeHeat -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#ExtremeDayTimeHeat">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#AmbientTemperature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTemporalContext"/>
                        <owl:hasValue>DayTime</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Extereme Day Time Heat Temperature that is above than 35 degree celcius during &apos;DayTime&apos;.</rdfs:comment>
        <rdfs:label>ExtremeDayTimeHeat</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#ExtremeHeat -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#ExtremeHeat">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#AmbientTemperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvironmentDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasPrecipitation"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasWeatherCondition"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>ExtremeHeat is an environmental condition</rdfs:comment>
        <rdfs:label>ExtremeHeat</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#ExtremeNightTimeHeat -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#ExtremeNightTimeHeat">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#AmbientTemperature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTemporalContext"/>
                        <owl:hasValue>NightTime</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Extereme Night Time Heat Temperature that is above than 25 degree celcius</rdfs:comment>
        <rdfs:label>ExtremeNightTimeHeat</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Farm -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Farm">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isMonitoredByDevice"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isUsedByFarmer"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasFence"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLatitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLongitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The farm is a location with some livestock.</rdfs:comment>
        <rdfs:label>Farm</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Farmer -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Farmer">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isOwnerOfLivestock"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#usesFarm"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasContactNumber"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantRole"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantID"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Farmer is the owner of some Livestock.
A Farmer owns various domestic animals such as cattle, sheep, and goats.</rdfs:comment>
        <rdfs:label>Farmer</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Feeding -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Feeding">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology:
1.Feeding is a behaviour  =  feeding behavior(ATOL:0000363) &quot;any measurable or observable characteristic related to the consumption of solid ressources for nutritionnal needs.&quot;(Meunier-Salaün et. al,2015).

In ATOL under: animal trait of livestock-&gt;animal welfare trait-&gt;psychoneuroendocrinological state trait-&gt;behaviour trait-&gt;ingestive behavior-&gt;feeding behavior</rdfs:comment>
        <rdfs:label>Feeding</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Fever -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Fever">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#healthInfluencesBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasHealthDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSymptoms"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Fever  is a health condition</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#GPSMonitoringSystem -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#GPSMonitoringSystem">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#analyses"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#uses"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDetectionMethodAccuracy"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDetectionMethodType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasFalsePositiveRate"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasMethodAttribute"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTrainingData"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>GPSTrackingSystem is a theft DetectionMethod</rdfs:comment>
        <rdfs:label>GPSTrackingSystem</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Goat -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Goat">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibits"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#experiences"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentLocation"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#healthConfirmedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAttachedToDevice"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EndDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isLocatedAtFarm"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isOwnedByFarmer"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAge"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBreed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGender"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGoatBodyConditionScore"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minExclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGroupSize"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasRunningDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSittingDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSleepingDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpecies"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTagMark"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasWeightInKg"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isPregnant"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAnimalID"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Goat is a livestock</rdfs:comment>
        <rdfs:label>Goat</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#GoatGrazingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#GoatGrazingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateBaselineValues"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateConfidenceScore"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateContext"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDeviation"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpeed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid395"/>
        <rdfs:subClassOf rdf:nodeID="genid397"/>
        <rdfs:comment>GoatGrazingState is normalState</rdfs:comment>
        <rdfs:label>GoatGrazingState</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid395">
        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateBaselineValues"/>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</owl:hasValue>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid397">
        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDeviation"/>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</owl:hasValue>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://github.com/tumelomodise/LFTDO#GoatGrazingState"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid395"/>
        <rdfs:comment>This is base line value of  the maximum Goat Speed of 1.5m/s
N.B: This values be added into application parameters and can be adjusted to as needed.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://github.com/tumelomodise/LFTDO#GoatGrazingState"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid397"/>
        <rdfs:comment>20% in Goat Speed deviation from the base line speed allowed, anything more than indicates a possible abnormal behaviour.
N.B: This values be added into application parameters and can be adjusted to as needed.</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://github.com/tumelomodise/LFTDO#GoatRestingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#GoatRestingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>GoatRestingState is a NormalState</rdfs:comment>
        <rdfs:label>GoatRestingState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#GoatRunningState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#GoatRunningState"/>
    


    <!-- https://github.com/tumelomodise/LFTDO#GoatWanderingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#GoatWanderingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:label>GoatWanderingState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#GoatWithFever -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#GoatWithFever">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Goat"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#experiences"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Fever"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBodyTemperature"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">39.3</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Goat that hasBodyTemperature &gt;= 39.7 celsius, is a Goat with Fever</rdfs:comment>
        <rdfs:label>GoatWithFever</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Grazing -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Grazing">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
