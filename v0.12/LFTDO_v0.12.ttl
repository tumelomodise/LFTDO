owl:topDataProperty rdfs:label "topDataProperty" .

LFTDO4:Behaviour a owl:Class ;
    rdfs:label "Behaviour" ;
    rdfs:comment """Livestock behavior includes a broader range of activities exhibited by an animal over a period. It includes actions, reactions, and responses to various stimuli and situations. 

Sub-classess
1.Sleeping
2.Breeding
3.Grazing
4.Feeding
5.Sitting
6.AbnormalBehaviour
7.Agreession
8.NormalBehaviour
9.Running""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ] .

LFTDO4:PastureLocation001 a owl:NamedIndividual,
        LFTDO4:Location ;
    rdfs:label "PastureLocation001" ;
    rdfs:comment "Small Paddock inside the Field" ;
    LFTDO4:hasCity "Pretoria" ;
    LFTDO4:hasFarmSizeInHa 0.28 ;
    LFTDO4:hasLocationName "SouthWestPasture"^^xsd:string ;
    LFTDO4:hasMaxLat -25.8875 ;
    LFTDO4:hasMaxLon 28.1610 ;
    LFTDO4:hasMinLat -25.8880 ;
    LFTDO4:hasMinLon 28.1605 ;
    LFTDO4:isPartOfLocation LFTDO4:Farm001 .

LFTDO4:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "1.Sensor is a Device that detect the changes on livestock and the environment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationFrequencyRange ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasManufacturerName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDevicePrice ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSensorType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSerialNumber ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceBatteryLife ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceCapacity ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty LFTDO4:hasDeviceID ],
        LFTDO4:Device .

LFTDO4:SoftwareApp001 a owl:NamedIndividual,
        LFTDO4:SoftwareApplication ;
    rdfs:label "SoftwareApp001" ;
    rdfs:comment "SoftwareApp001" ;
    LFTDO4:accesses LFTDO4:Database001 ;
    LFTDO4:hasID "APP-SEC-2024-001"^^xsd:string ;
    LFTDO4:hasLastSyncTime "2024-02-15T13:05:00"^^xsd:dateTime ;
    LFTDO4:hasResponseTimeMs 99.0 ;
    LFTDO4:hasSoftwareAppName "OntoGuard-Security"^^xsd:string ;
    LFTDO4:hasSoftwareVersion "v1.0"^^xsd:string ;
    LFTDO4:implements LFTDO4:TheftDetectionSystem ;
    LFTDO4:isDeployedOn LFTDO4:CloudService001 ;
    LFTDO4:isOnline true ;
    LFTDO4:notifies LFTDO4:Farmer001 ;
    LFTDO4:uiUpdatedBy LFTDO4:GoatStatusUpdate001 .

LFTDO4:DataTransmission1 a owl:NamedIndividual,
        LFTDO4:DataTransmission ;
    rdfs:label "DataTransmission001" ;
    LFTDO4:hasCloudService LFTDO4:CloudService001 .

LFTDO4:Farm001 a owl:NamedIndividual,
        LFTDO4:Farm ;
    rdfs:label "Farm001" ;
    LFTDO4:hasFarmID "10001"^^xsd:string ;
    LFTDO4:hasFarmName "TUTFarm"^^xsd:string ;
    LFTDO4:hasFarmSizeInHa 10.00 ;
    LFTDO4:hasLatitude -25.89 ;
    LFTDO4:hasLongitude 28.16 ;
    LFTDO4:hasMaxLat -25.8870 ;
    LFTDO4:hasMaxLon 28.1600 ;
