         :isMonitoredByDevice :MotionSensorDevice001 ;
         :isUsedByFarmer :Farmer001 ;
         :hasFarmID "10001" ;
         :hasFarmName "TUTFarm" ;
         :hasFarmSizeInHa 10.00 ;
         :hasLatitude -25.89 ;
         :hasLongitude 28.16 ;
         :hasMaxLat -25.8870 ;
         :hasMaxLon 28.1600 ;
         :hasMinLat -25.8900 ;
         :hasMinLon 28.1635 ;
         rdfs:label "Farm001" .


