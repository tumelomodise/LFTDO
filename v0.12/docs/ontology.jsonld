}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#Behaviour",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Livestock behavior includes a broader range of activities exhibited by an animal over a period. It includes actions, reactions, and responses to various stimuli and situations. \n\nSub-classess\n1.Sleeping\n2.Breeding\n3.Grazing\n4.Feeding\n5.Sitting\n6.AbnormalBehaviour\n7.Agreession\n8.NormalBehaviour\n9.Running"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Behaviour"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid131"
  }, {
    "@id" : "_:genid132"
  }, {
    "@id" : "_:genid133"
  } ]
}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#BehaviourState",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Livestock behavior state the actions that are are likely and less likely to happen at any point in time such as normal behavior state that includes grazing and feeding, and abnormal behavior states such as restlessness and aggression (Dieng et al., 2017, Risteska Stojkoska et al., 2018). Behavior states are influenced by health, environmental, body conditions, and their locations at any point in time.\n\nsub-classes:\n1.NormalState\n2.AbnormalState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BehaviourState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid134"
  }, {
    "@id" : "_:genid135"
  }, {
    "@id" : "_:genid136"
  }, {
