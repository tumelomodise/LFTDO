    rdfs:label "GoatTrackerSensor098_1"^^xsd:string ;
    rdfs:comment "GoatTrackerSensor098_1"^^xsd:string ;
    LFTDO4:generatesData LFTDO4:GoatSensorData098 ;
    LFTDO4:hasSensorType "WirelessTransceiver"^^xsd:string ;
    LFTDO4:hasUoM "dBm"^^xsd:string ;
    LFTDO4:isSensorCalibrated true ;
    LFTDO4:isSensorOf LFTDO4:GoatTrackerCollar098 .

