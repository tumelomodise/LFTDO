                                                                                                                                                <rdf:first>
                                                                                                                                                    <rdf:Description>
                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                                                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasDuration"/>
                                                                                                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#grazing"/>
                                                                                                                                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#duration"/>
