###  https://github.com/tumelomodise/LFTDO#SlaughterTheft
:SlaughterTheft rdf:type owl:Class ;
                rdfs:subClassOf :TheftEvent ;
                rdfs:comment "The illegal killing and stealing of livestock for meat." ;
