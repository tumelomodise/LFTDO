                                owl:onProperty :isCurrentBehaviourStateOf ;
                                owl:someValuesFrom :Behaviour
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :isInfluencedBy ;
                                owl:someValuesFrom :EnvironmentalCondition
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :isInfluencedByHealthCondition ;
                                owl:someValuesFrom :HealthCondition
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasBehaviourStateConfidenceScore ;
                                owl:someValuesFrom xsd:integer
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasBehaviourStateContext ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasBehaviourStateDescription ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasSeverityLevel ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasSpeed ;
                                owl:someValuesFrom xsd:decimal
                              ] ;
              rdfs:comment "Restlessness is an AbnormalState of Behaviour of Livestock" ;
              rdfs:label "Restlessness" .


###  https://github.com/tumelomodise/LFTDO#RestrictedArea
:RestrictedArea rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Location
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :isSecurelyGuarded ;
                                                             owl:allValuesFrom :EndDevice
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Location ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isMonitoredByDevice ;
                                  owl:someValuesFrom :Device
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isUsedByFarmer ;
                                  owl:someValuesFrom :Farmer
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasFence ;
                                  owl:someValuesFrom xsd:boolean
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasLatitude ;
                                  owl:someValuesFrom xsd:decimal
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasLocationDescription ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasLocationName ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasLocationType ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasLongitude ;
                                  owl:someValuesFrom xsd:decimal
                                ] ;
                rdfs:comment "The RestrictedArea is a location in a farm that isSecuredGuardedBy only EndUser device." ;
                rdfs:label "RestrictedArea" .


###  https://github.com/tumelomodise/LFTDO#RoutineLogEvent
:RoutineLogEvent rdf:type owl:Class ;
                 rdfs:subClassOf :SystemEvent ;
                 owl:disjointWith :StatusUpdateEvent ;
                 rdfs:comment "Classifies the a Data-Persistence Event" ;
                 rdfs:label "RoutineLogEvent" .


###  https://github.com/tumelomodise/LFTDO#Running
:Running rdf:type owl:Class ;
         rdfs:subClassOf :Behaviour ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :exhibitedBy ;
                           owl:someValuesFrom :Livestock
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasCurrentBehaviourState ;
                           owl:someValuesFrom :BehaviourState
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasBehaviourStartTime ;
                           owl:someValuesFrom xsd:dateTime
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIntensity ;
                           owl:someValuesFrom xsd:string
                         ] ;
         rdfs:comment """Referenced Ontology:
1.Running is a behaviour = running behavior(ATOL:0000806), \"any measurable or observable characteristic related to rapidely coordinated displacement of the body on foot or limbs\"  (Meunier-Salaün et. al,2015)
2.Running can have normal or abnomal behaviour state based on the livestock speed and running duration.

AOL Under: Animal trait of livestock->animal welfar trait->psychoneuroendocrinological state trait->motor activity->locomotor activity->running behaviour""" ;
         rdfs:label "Running" .


###  https://github.com/tumelomodise/LFTDO#Rustling
:Rustling rdf:type owl:Class ;
          rdfs:subClassOf :TheftEvent ;
          rdfs:comment "Rustling: The illegal taking of livestock from a farm or ranch without permission of the farmer(Dieng,2017)." ;
          rdfs:label "Rustling" .


###  https://github.com/tumelomodise/LFTDO#SabotageIndicator
:SabotageIndicator rdf:type owl:Class ;
                   rdfs:subClassOf :LivestockIndicator ;
                   rdfs:comment "Sabotage Theft Indicator may indicate that there is a potential theft indicator" ;
                   rdfs:label "SabotageIndicator" .


###  https://github.com/tumelomodise/LFTDO#SecurityBreach
:SecurityBreach rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty :isAlertInitiatedBy ;
                                      owl:someValuesFrom :SabotageIndicator
                                    ] ;
                rdfs:subClassOf :LivestockEvent ,
                                [ rdf:type owl:Class ;
                                  owl:unionOf ( [ rdf:type owl:Restriction ;
                                                  owl:onProperty :triggersAlertLevel ;
                                                  owl:hasValue "High"
                                                ]
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :triggersAlertLevel ;
                                                  owl:hasValue "Low"
                                                ]
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :triggersAlertLevel ;
                                                  owl:hasValue "Medium"
                                                ]
                                              )
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :affectsLivestock ;
                                  owl:someValuesFrom :Livestock
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isTriggeredBy ;
                                  owl:someValuesFrom :BehaviourState
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasTheftEventResolution ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasTheftEventStatus ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasTheftEventTime ;
                                  owl:someValuesFrom xsd:dateTime
                                ] ;
                rdfs:comment "SecurityBreach: is triggered by Sabotage indicators that related to technologies misfunctions or fence cut or collar removed from Livestock." ;
                rdfs:label "SecurityBreach" .


###  https://github.com/tumelomodise/LFTDO#Sensor
:Sensor rdf:type owl:Class ;
        rdfs:subClassOf :Device ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceBatteryLife ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceCapacity ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceName ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDevicePrice ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceSensorType ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceSerialNumber ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceType ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasManufacturerName ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasModulationFrequencyRange ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasModulationType ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceID ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:integer
                        ] ;
        rdfs:comment "1.Sensor is a Device that detect the changes on livestock and the environment" ;
        rdfs:label "Sensor" .


###  https://github.com/tumelomodise/LFTDO#SensorData
:SensorData rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :isGeneratedByDevice ;
                              owl:someValuesFrom :Device
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasSensorDataValue ;
                              owl:someValuesFrom xsd:decimal
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasSensorTimeStamp ;
                              owl:someValuesFrom xsd:dateTime
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :representsDataType ;
                              owl:someValuesFrom xsd:string
                            ] ;
            rdfs:comment "SensorData: Represents data collected from device sensors attached to the livestock and environment, providing various behaviour states." ;
            rdfs:label "SensorData" .


###  https://github.com/tumelomodise/LFTDO#Sheep
:Sheep rdf:type owl:Class ;
       rdfs:subClassOf :Livestock ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :exhibits ;
                         owl:someValuesFrom :Behaviour
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :experiences ;
                         owl:someValuesFrom :HealthCondition
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasCurrentLocation ;
                         owl:someValuesFrom :Location
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :healthConfirmedBy ;
                         owl:someValuesFrom :Participant
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isAttachedToDevice ;
                         owl:someValuesFrom :EndDevice
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isLocatedAtFarm ;
                         owl:someValuesFrom :Farm
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isOwnedByFarmer ;
                         owl:someValuesFrom :Farmer
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasAge ;
                         owl:someValuesFrom xsd:integer
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasBreed ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasGender ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasGroupSize ;
                         owl:someValuesFrom xsd:integer
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasRunningDuration ;
                         owl:someValuesFrom xsd:decimal
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasSheepBodyConditionScore ;
                         owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                              owl:onDatatype xsd:integer ;
                                              owl:withRestrictions ( [ xsd:minExclusive 0
                                                                     ]
                                                                   )
                                            ]
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasSittingDuration ;
                         owl:someValuesFrom xsd:decimal
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasSleepingDuration ;
                         owl:someValuesFrom xsd:integer
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasSpecies ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasTagMark ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasWeightInKg ;
                         owl:someValuesFrom xsd:decimal
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isPregnant ;
                         owl:someValuesFrom xsd:boolean
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasAnimalID ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ;
       rdfs:comment "Sheep is a livestock" ;
       rdfs:label "Sheep" .


###  https://github.com/tumelomodise/LFTDO#SheepGrazingState
:SheepGrazingState rdf:type owl:Class ;
                   rdfs:subClassOf :NormalState ;
                   owl:disjointWith :SheepRestingState ;
                   rdfs:comment "SheepGrazingState is normalState" ;
