###  https://github.com/tumelomodise/LFTDO#Cattle
:Cattle rdf:type owl:Class ;
        rdfs:subClassOf :Livestock ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :exhibits ;
                          owl:someValuesFrom :Behaviour
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :experiences ;
                          owl:someValuesFrom :HealthCondition
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasCurrentLocation ;
                          owl:someValuesFrom :Location
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :healthConfirmedBy ;
                          owl:someValuesFrom :Participant
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isAttachedToDevice ;
                          owl:someValuesFrom :EndDevice
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isLocatedAtFarm ;
                          owl:someValuesFrom :Farm
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isOwnedByFarmer ;
                          owl:someValuesFrom :Farmer
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasAge ;
                          owl:someValuesFrom xsd:integer
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasBreed ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasCattleBodyConditionScore ;
                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                               owl:onDatatype xsd:integer ;
                                               owl:withRestrictions ( [ xsd:minExclusive 0
                                                                      ]
                                                                    )
                                             ]
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasGender ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasGroupSize ;
                          owl:someValuesFrom xsd:integer
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasRunningDuration ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasSittingDuration ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasSleepingDuration ;
                          owl:someValuesFrom xsd:integer
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasSpecies ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasTagMark ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasWeightInKg ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isPregnant ;
                          owl:someValuesFrom xsd:boolean
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasAnimalID ;
                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ;
        rdfs:comment "Cattle is a livestock" ;
        rdfs:label "Cattle" .


