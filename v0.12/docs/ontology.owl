                                                                                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#generatesData"/>
                                                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#sensorComp"/>
                                                                                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#sensorData"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
                                                                                                <rdf:rest>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                        <rdf:first>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                                                <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
                                                                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#grazing"/>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:first>
                                                                                                        <rdf:rest>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                                <rdf:first>
                                                                                                                    <rdf:Description>
                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasUoM"/>
