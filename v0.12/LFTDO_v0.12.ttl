LFTDO4:GoatWithFever a owl:Class ;
    rdfs:label "GoatWithFever" ;
    rdfs:comment "Goat that hasBodyTemperature >= 39.7 celsius, is a Goat with Fever" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( LFTDO4:Goat [ a owl:Restriction ;
                        owl:onProperty LFTDO4:experiences ;
                        owl:someValuesFrom LFTDO4:Fever ] [ a owl:Restriction ;
                        owl:onProperty LFTDO4:hasBodyTemperature ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minExclusive 39.3 ] ) ] ] ) ] .

LFTDO4:HighSlaugterTheftEvent001 a owl:NamedIndividual,
        LFTDO4:TheftEvent ;
    rdfs:label "HighSlaugterTheftEvent001" ;
    LFTDO4:affectsLivestock LFTDO4:Sheep001 ;
    LFTDO4:atIncidentLocation LFTDO4:TUTFarmLakeLocation1 ;
    LFTDO4:hasTheftEventStatus "In progress"^^xsd:string ;
    LFTDO4:hasTheftEventTime "2024-04-20T20:00:00"^^xsd:dateTime ;
    LFTDO4:triggersAlertLevel "High" .

LFTDO4:InferredComplexTheftEvent a owl:ObjectProperty ;
    rdfs:label "InferredComplexTheftEvent" ;
    rdfs:domain LFTDO4:TheftEvent .

LFTDO4:LegInjury a owl:Class ;
    rdfs:label "LegInjury" ;
    rdfs:comment "LegInjury is a health condition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:healthInfluencesBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasHealthDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSymptoms ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:HealthCondition .

LFTDO4:Resting a owl:Class ;
    rdfs:comment """1.Resting is a behaviour
2.Resting can be a normal or abnormal behaviour state based on duration of the rest""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        LFTDO4:Behaviour .

LFTDO4:Restlessness a owl:Class ;
    rdfs:label "Restlessness" ;
    rdfs:comment "Restlessness is an AbnormalState of Behaviour of Livestock" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateConfidenceScore ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSeverityLevel ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isCharacterisedBy ;
            owl:someValuesFrom LFTDO4:TheftIndicator ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isCurrentBehaviourStateOf ;
            owl:someValuesFrom LFTDO4:Behaviour ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isInfluencedByHealthCondition ;
            owl:someValuesFrom LFTDO4:HealthCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSpeed ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isInfluencedBy ;
            owl:someValuesFrom LFTDO4:EnvironmentalCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateContext ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:AbnormalState,
        LFTDO4:BehaviourState .

LFTDO4:RestrictedArea001 a owl:NamedIndividual,
        LFTDO4:RestrictedArea ;
    rdfs:label "RestrictedArea001" ;
    LFTDO4:isPartOfLocation LFTDO4:PastureLocation001 .

LFTDO4:RustlingTheft001 a owl:NamedIndividual,
        LFTDO4:Rustling ;
    rdfs:label "RustlingTheft001" .

LFTDO4:SecurityBreach a owl:Class ;
    rdfs:label "SecurityBreach" ;
    rdfs:comment "SecurityBreach: is triggered by Sabotage indicators that related to technologies misfunctions or fence cut or collar removed from Livestock." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventResolution ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue "High" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Low" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Medium" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] ) ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventStatus ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:affectsLivestock ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isTriggeredBy ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        LFTDO4:LivestockEvent ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty LFTDO4:isAlertInitiatedBy ;
            owl:someValuesFrom LFTDO4:SabotageIndicator ] .

