                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasDeviceCapacity ;
                             owl:someValuesFrom xsd:decimal
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasDeviceName ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasDevicePrice ;
                             owl:someValuesFrom xsd:decimal
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasDeviceSensorType ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasDeviceSerialNumber ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasDeviceType ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasManufacturerName ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasModulationFrequencyRange ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasModulationType ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasDeviceID ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:integer
                           ] ;
           rdfs:comment """1.End device is device attached to a livestock fitted with sensors 
2.Some end device has some sensor""" ;
           rdfs:label "EndDevice" .


###  https://github.com/tumelomodise/LFTDO#EnvironmentalCondition
:EnvironmentalCondition rdf:type owl:Class ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasEnvValue ;
                                          owl:someValuesFrom xsd:decimal
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasEnvironmentDescription ;
                                          owl:someValuesFrom xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasPrecipitation ;
                                          owl:someValuesFrom xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasWeatherCondition ;
                                          owl:someValuesFrom xsd:string
                                        ] ;
                        rdfs:comment """Environmental condition influence livestock behavior, such as grazing, sleeping, and feeding, are also significantly influenced by their environmental conditions and weather changes such as rain, heat, and cold (Chaudhry et al., 2020).

Sub-classes:
1.ExtreamHeat""" ;
                        rdfs:label "EnvironmentalCondition" .


###  https://github.com/tumelomodise/LFTDO#EnvironmentalIndicator
:EnvironmentalIndicator rdf:type owl:Class ;
                        rdfs:subClassOf :LivestockIndicator .


###  https://github.com/tumelomodise/LFTDO#EscapeIndicator
:EscapeIndicator rdf:type owl:Class ;
                 rdfs:subClassOf :LivestockIndicator ;
                 rdfs:comment "Escape Indicator may indicate that the Livestock might have escaped the Farm or restricted area." ;
                 rdfs:label "EscapeIndicator" .


###  https://github.com/tumelomodise/LFTDO#EscapedLivestock
:EscapedLivestock rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasAbnormalBehaviourState ;
                                                               owl:someValuesFrom :AbnormalState
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :isAlertInitiatedBy ;
                                                               owl:someValuesFrom :EscapeIndicator
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :LivestockEvent ,
                                  [ rdf:type owl:Class ;
                                    owl:unionOf ( [ rdf:type owl:Restriction ;
                                                    owl:onProperty :triggersAlertLevel ;
                                                    owl:hasValue "High"
                                                  ]
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :triggersAlertLevel ;
                                                    owl:hasValue "Low"
                                                  ]
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :triggersAlertLevel ;
                                                    owl:hasValue "Medium"
                                                  ]
                                                )
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :affectsLivestock ;
                                    owl:someValuesFrom :Livestock
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isTriggeredBy ;
                                    owl:someValuesFrom :BehaviourState
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasTheftEventResolution ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasTheftEventStatus ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasTheftEventTime ;
                                    owl:someValuesFrom xsd:dateTime
                                  ] ;
                  rdfs:comment "EscapedLivestock: Is trigged by some EscapeIndicator that is identified as a Livestock that has Escaped the Farm or Known Area." ;
                  rdfs:label "EscapedLivestock" .


###  https://github.com/tumelomodise/LFTDO#ExtendedOfficer
:ExtendedOfficer rdf:type owl:Class ;
                 rdfs:subClassOf :Participant ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasContactNumber ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasParticipantName ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasParticipantRole ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasParticipantID ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
                 rdfs:comment """ExtendedOfficer assist with managing some Livestock.
Extended officers, work on a farm, to manage livestock such as feeding, keeping count, managing their well-being, and protecting against theft.""" ;
                 rdfs:label "ExtendedOfficer" .


###  https://github.com/tumelomodise/LFTDO#ExtremeDayTimeHeat
:ExtremeDayTimeHeat rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :AmbientTemperature
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :hasEnvValue ;
                                                                 owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                      owl:onDatatype xsd:decimal ;
                                                                                      owl:withRestrictions ( [ xsd:minInclusive 35
                                                                                                             ]
                                                                                                           )
                                                                                    ]
                                                               ]
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :hasTemporalContext ;
                                                                 owl:hasValue "DayTime"
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:comment "Extereme Day Time Heat Temperature that is above than 35 degree celcius during 'DayTime'." ;
                    rdfs:label "ExtremeDayTimeHeat" .


###  https://github.com/tumelomodise/LFTDO#ExtremeHeat
:ExtremeHeat rdf:type owl:Class ;
             rdfs:subClassOf :AmbientTemperature ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasEnvValue ;
                               owl:someValuesFrom xsd:decimal
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasEnvironmentDescription ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasPrecipitation ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasWeatherCondition ;
                               owl:someValuesFrom xsd:string
                             ] ;
             rdfs:comment "ExtremeHeat is an environmental condition" ;
             rdfs:label "ExtremeHeat" .


###  https://github.com/tumelomodise/LFTDO#ExtremeNightTimeHeat
:ExtremeNightTimeHeat rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :AmbientTemperature
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasEnvValue ;
                                                                   owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                        owl:onDatatype xsd:decimal ;
                                                                                        owl:withRestrictions ( [ xsd:minInclusive 25
                                                                                                               ]
                                                                                                             )
                                                                                      ]
                                                                 ]
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasTemporalContext ;
                                                                   owl:hasValue "NightTime"
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:comment "Extereme Night Time Heat Temperature that is above than 25 degree celcius" ;
                      rdfs:label "ExtremeNightTimeHeat" .


###  https://github.com/tumelomodise/LFTDO#Farm
:Farm rdf:type owl:Class ;
      rdfs:subClassOf :Location ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isMonitoredByDevice ;
                        owl:someValuesFrom :Device
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isUsedByFarmer ;
                        owl:someValuesFrom :Farmer
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasFence ;
                        owl:someValuesFrom xsd:boolean
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasLatitude ;
                        owl:someValuesFrom xsd:decimal
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasLocationDescription ;
                        owl:someValuesFrom xsd:string
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasLocationName ;
                        owl:someValuesFrom xsd:string
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasLocationType ;
                        owl:someValuesFrom xsd:string
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasLongitude ;
                        owl:someValuesFrom xsd:decimal
                      ] ;
      rdfs:comment "The farm is a location with some livestock." ;
      rdfs:label "Farm" .


###  https://github.com/tumelomodise/LFTDO#Farmer
:Farmer rdf:type owl:Class ;
        rdfs:subClassOf :Participant ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isOwnerOfLivestock ;
                          owl:someValuesFrom :Livestock
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :usesFarm ;
                          owl:someValuesFrom :Farm
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasContactNumber ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasParticipantName ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasParticipantRole ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasParticipantID ;
                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ;
        rdfs:comment """Farmer is the owner of some Livestock.
A Farmer owns various domestic animals such as cattle, sheep, and goats.""" ;
        rdfs:label "Farmer" .


###  https://github.com/tumelomodise/LFTDO#Feeding
:Feeding rdf:type owl:Class ;
         rdfs:subClassOf :Behaviour ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :exhibitedBy ;
                           owl:someValuesFrom :Livestock
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasCurrentBehaviourState ;
                           owl:someValuesFrom :BehaviourState
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasBehaviourStartTime ;
                           owl:someValuesFrom xsd:dateTime
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIntensity ;
                           owl:someValuesFrom xsd:string
                         ] ;
         rdfs:comment """Referenced Ontology:
1.Feeding is a behaviour  =  feeding behavior(ATOL:0000363) \"any measurable or observable characteristic related to the consumption of solid ressources for nutritionnal needs.\"(Meunier-Salaün et. al,2015).

In ATOL under: animal trait of livestock->animal welfare trait->psychoneuroendocrinological state trait->behaviour trait->ingestive behavior->feeding behavior""" ;
         rdfs:label "Feeding" .


###  https://github.com/tumelomodise/LFTDO#Fever
:Fever rdf:type owl:Class ;
       rdfs:subClassOf :HealthCondition ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :healthInfluencesBehaviourState ;
                         owl:someValuesFrom :BehaviourState
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasHealthDescription ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasSymptoms ;
                         owl:someValuesFrom xsd:string
                       ] ;
       rdfs:comment "Fever  is a health condition" .


###  https://github.com/tumelomodise/LFTDO#GPSMonitoringSystem
:GPSMonitoringSystem rdf:type owl:Class ;
                     rdfs:subClassOf :DetectionMethod ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :analyses ;
                                       owl:someValuesFrom :Database
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :uses ;
                                       owl:someValuesFrom :Algorithm
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasDetectionMethodAccuracy ;
                                       owl:someValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasDetectionMethodType ;
                                       owl:someValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasFalsePositiveRate ;
                                       owl:someValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasMethodAttribute ;
                                       owl:someValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasTrainingData ;
                                       owl:someValuesFrom xsd:boolean
                                     ] ;
                     rdfs:comment "GPSTrackingSystem is a theft DetectionMethod" ;
                     rdfs:label "GPSTrackingSystem" .


###  https://github.com/tumelomodise/LFTDO#Goat
:Goat rdf:type owl:Class ;
      rdfs:subClassOf :Livestock ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :exhibits ;
                        owl:someValuesFrom :Behaviour
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :experiences ;
                        owl:someValuesFrom :HealthCondition
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasCurrentLocation ;
                        owl:someValuesFrom :Location
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :healthConfirmedBy ;
                        owl:someValuesFrom :Participant
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isAttachedToDevice ;
                        owl:someValuesFrom :EndDevice
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isLocatedAtFarm ;
                        owl:someValuesFrom :Farm
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isOwnedByFarmer ;
                        owl:someValuesFrom :Farmer
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasAge ;
                        owl:someValuesFrom xsd:integer
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasBreed ;
                        owl:someValuesFrom xsd:string
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasGender ;
                        owl:someValuesFrom xsd:string
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasGoatBodyConditionScore ;
                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                             owl:onDatatype xsd:integer ;
                                             owl:withRestrictions ( [ xsd:minExclusive 0
                                                                    ]
                                                                  )
                                           ]
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasGroupSize ;
                        owl:someValuesFrom xsd:integer
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasRunningDuration ;
                        owl:someValuesFrom xsd:decimal
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasSittingDuration ;
                        owl:someValuesFrom xsd:decimal
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasSleepingDuration ;
                        owl:someValuesFrom xsd:integer
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasSpecies ;
                        owl:someValuesFrom xsd:string
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasTagMark ;
                        owl:someValuesFrom xsd:string
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasWeightInKg ;
                        owl:someValuesFrom xsd:decimal
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :isPregnant ;
                        owl:someValuesFrom xsd:boolean
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasAnimalID ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onDataRange xsd:string
                      ] ;
      rdfs:comment "Goat is a livestock" ;
      rdfs:label "Goat" .


###  https://github.com/tumelomodise/LFTDO#GoatGrazingState
:GoatGrazingState rdf:type owl:Class ;
                  rdfs:subClassOf :BehaviourState ,
                                  :NormalState ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isCurrentBehaviourStateOf ;
                                    owl:someValuesFrom :Behaviour
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isInfluencedBy ;
                                    owl:someValuesFrom :EnvironmentalCondition
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isInfluencedByHealthCondition ;
                                    owl:someValuesFrom :HealthCondition
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasBehaviourStateBaselineValues ;
                                    owl:someValuesFrom xsd:decimal
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasBehaviourStateConfidenceScore ;
                                    owl:someValuesFrom xsd:integer
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasBehaviourStateContext ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasBehaviourStateDescription ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasBehaviourStateDeviation ;
                                    owl:someValuesFrom xsd:decimal
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasSpeed ;
                                    owl:someValuesFrom xsd:decimal
                                  ] ,
                                  _:genid395 ,
                                  _:genid397 ;
                  rdfs:comment "GoatGrazingState is normalState" ;
                  rdfs:label "GoatGrazingState" .

_:genid395 rdf:type owl:Restriction ;
            owl:onProperty :hasBehaviourStateBaselineValues ;
            owl:hasValue 1.5 .

_:genid397 rdf:type owl:Restriction ;
            owl:onProperty :hasBehaviourStateDeviation ;
            owl:hasValue 20 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :GoatGrazingState ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid395 ;
   rdfs:comment """This is base line value of  the maximum Goat Speed of 1.5m/s
N.B: This values be added into application parameters and can be adjusted to as needed."""
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :GoatGrazingState ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid397 ;
   rdfs:comment """20% in Goat Speed deviation from the base line speed allowed, anything more than indicates a possible abnormal behaviour.
N.B: This values be added into application parameters and can be adjusted to as needed."""
 ] .


###  https://github.com/tumelomodise/LFTDO#GoatRestingState
:GoatRestingState rdf:type owl:Class ;
