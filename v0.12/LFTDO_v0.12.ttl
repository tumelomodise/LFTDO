[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:NormalSheepRestingState LFTDO4:NormalSheepRunningState_Midnight ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:Sheep031 LFTDO4:Sheep032 ) .

