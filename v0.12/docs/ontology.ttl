                                                   :EnvironmentalCondition
                                                   :HealthCondition
                                                 )
                                   ] ;
                       rdfs:range :LivestockIndicator ;
                       rdfs:comment "LivestockIndicators are indicated by some Livestock Abnormal Behaviour or Device or Health or Environment conditions" ;
                       rdfs:label "hasLivestockIndicator" .


###  https://github.com/tumelomodise/LFTDO#hasPartLocation
:hasPartLocation rdf:type owl:ObjectProperty ;
                 rdfs:comment "The standard inverse for an \"isPartOfLocation\" relationship is typically named hasPartLocation." ;
                 rdfs:label "hasPartLocation" .


###  https://github.com/tumelomodise/LFTDO#hasTheftEventLocation
:hasTheftEventLocation rdf:type owl:ObjectProperty ;
                       rdfs:domain :TheftEvent ;
                       rdfs:range :Location ;
                       rdfs:comment "TheftEvent happens at some Location" ;
                       rdfs:label "hasTheftEventLocation" .


###  https://github.com/tumelomodise/LFTDO#healthConditionBelongsTo
:healthConditionBelongsTo rdf:type owl:ObjectProperty ;
                          rdfs:domain :HealthCondition ;
                          rdfs:range :Livestock ;
                          rdfs:comment "HealthConditionBelongsTo to a specific Livestock type such Cattle, Sheep or Goat." ;
                          rdfs:label "healthConditionBelongsTo" .


###  https://github.com/tumelomodise/LFTDO#healthConfirmedBy
:healthConfirmedBy rdf:type owl:ObjectProperty ;
                   rdfs:domain :Livestock ;
