LFTDO4:HighCattleBehaviourTheftIndicator002 a owl:NamedIndividual,
        LFTDO4:TheftIndicator ;
    rdfs:label "HighCattleBehaviourTheftIndicator002" ;
    LFTDO4:initiatesAlert LFTDO4:ComplexTheftEvent001,
        LFTDO4:GoatHighTheftEvent001 ;
    LFTDO4:triggersAlertLevel "High"^^xsd:string .

LFTDO4:HighEnvTheftIndicator001 a owl:NamedIndividual,
        LFTDO4:TheftIndicator ;
    rdfs:label "HighEnvTheftIndicator001" ;
    LFTDO4:triggersAlertLevel "High"^^xsd:string .

LFTDO4:Isolation a owl:Class ;
    rdfs:label "Isolation" ;
    rdfs:comment "Livestock exhibits some Isolation behaviour." ;
    rdfs:subClassOf LFTDO4:Behaviour .

LFTDO4:LawEnforcementAgency a owl:Class ;
    rdfs:label "LawEnforcementAgency" ;
    rdfs:comment "Law enforcement agents, enforce the law of the country pertaining to Livestock if not being adhered to such as theft, and abuse of livestock." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasParticipantName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasParticipantRole ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasContactNumber ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty LFTDO4:hasParticipantID ],
        LFTDO4:Participant .

LFTDO4:NormalSheepRunningState_Midnight a owl:NamedIndividual,
        LFTDO4:SheepRunningState ;
    rdfs:label "NormalSheepRunningState_Midnight"^^xsd:string ;
    LFTDO4:hasBaseLineHeadingDirection 45.00 ;
    LFTDO4:hasBaseLineHeadingDirectionUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaseLineSignalStrength -100.0 ;
    LFTDO4:hasBaseLineSignalStrengthUoM "dBm"^^xsd:string ;
    LFTDO4:hasBaseLineType "Maximum Normal"^^xsd:string ;
    LFTDO4:hasBaselinePosture 0.0 ;
    LFTDO4:hasBaselinePostureUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaselineStepCount 80 ;
    LFTDO4:hasBaselineStepCountUoM "count"^^xsd:string ;
    LFTDO4:hasBehaviourStateBaselineValues 4.50 ;
    LFTDO4:hasBehaviourStateContext "NightTime"^^xsd:string ;
    LFTDO4:hasDurationBaseline 180.0 ;
    LFTDO4:hasUoM "m/s"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:NormalActivityIndicator ;
    LFTDO4:isOutsideGeofence false .

LFTDO4:OccursAtLocation a owl:ObjectProperty ;
    rdfs:label "OccursAtLocation" ;
    rdfs:comment "Some Enviromental Condition, TheftIndicator, TheftEvent Occurrs at some Location" ;
    rdfs:domain LFTDO4:EnvironmentalCondition ;
    rdfs:range LFTDO4:Location .

LFTDO4:Restless a owl:Class ;
    rdfs:label "Restless" ;
    rdfs:comment "Livestock may exhibit some restless behaviour." ;
    rdfs:subClassOf LFTDO4:Behaviour .

