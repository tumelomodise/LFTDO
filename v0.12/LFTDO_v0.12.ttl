LFTDO4:isTriggeredBy a owl:ObjectProperty ;
    rdfs:label "isTriggeredBy" ;
    rdfs:comment """Event(s) such as SystemEvent or LivestockEvent or LivestockIndicator are triggered by BehaviourState. 

A LivestockEvent is usually triggered by exactly one method. However, a SystemEvent (like a "System Overload") might be triggered by many detection methods running at once. An event could also have zero detection methods if it was triggered manually by a human (Farmer).""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:LivestockEvent LFTDO4:SystemEvent ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( LFTDO4:BehaviourState LFTDO4:DetectionMethod LFTDO4:LivestockIndicator ) ] ;
    owl:inverseOf LFTDO4:triggers .

:NormSheepGrazingState a swrl:Variable .

:bv a swrl:Variable .

:crs a swrl:Variable .

:dv a swrl:Variable .

:lat a swrl:Variable .

:result1 a swrl:Variable .

:result2 a swrl:Variable .

:result3 a swrl:Variable .

:statusEventUpd a swrl:Variable .

LFTDO4:AmbientTemperature a owl:Class ;
    rdfs:label "AmbientTemperature" ;
    rdfs:comment """Ambient Temperature: Refers to the temperature of the surroundings, often measured in degrees Celsius or Fahrenheit. It is the temperature experienced by a person in their environment, not the temperature of the person themselves.

These refers to the warmth or coldness of the air, which influences areas such as livestock farming and human health.""" ;
    rdfs:subClassOf LFTDO4:EnvironmentalCondition .

LFTDO4:Goat001 a owl:NamedIndividual,
        LFTDO4:Goat,
        LFTDO4:Livestock ;
    rdfs:label "Goat001" ;
    LFTDO4:exhibits LFTDO4:GoatGrazing,
        LFTDO4:GoatGrazing1 ;
    LFTDO4:hasAnimalID "Goat100"^^xsd:string ;
    LFTDO4:hasBreed "Alpine"^^xsd:string ;
    LFTDO4:hasCurrentLocation LFTDO4:PastureLocation001 ;
    LFTDO4:hasGoatBodyConditionScore 3 ;
    LFTDO4:hasSpecies "Goat"^^xsd:string ;
    LFTDO4:isAttachedToDevice LFTDO4:GoatTrackerCollar001 ;
    LFTDO4:isLocatedAtFarm LFTDO4:Farm001 ;
    LFTDO4:isOwnedByFarmer LFTDO4:Farmer001 .

LFTDO4:GoatGrazingState a owl:Class ;
    rdfs:label "GoatGrazingState" ;
    rdfs:comment "GoatGrazingState is normalState" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:hasValue 1.5 ;
            owl:onProperty LFTDO4:hasBehaviourStateBaselineValues ],
        [ a owl:Restriction ;
            owl:hasValue 20 ;
            owl:onProperty LFTDO4:hasBehaviourStateDeviation ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isCurrentBehaviourStateOf ;
            owl:someValuesFrom LFTDO4:Behaviour ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateConfidenceScore ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateBaselineValues ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateContext ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isInfluencedBy ;
            owl:someValuesFrom LFTDO4:EnvironmentalCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isInfluencedByHealthCondition ;
            owl:someValuesFrom LFTDO4:HealthCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateDeviation ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSpeed ;
            owl:someValuesFrom xsd:decimal ],
        LFTDO4:BehaviourState,
        LFTDO4:NormalState .

LFTDO4:HighSpeedTheftIndicator a owl:NamedIndividual,
        LFTDO4:TheftIndicator ;
    rdfs:label "HighSpeedTheftIndicator"^^xsd:string ;
    LFTDO4:isDetectedBy LFTDO4:TheftDetectionSystem ;
    LFTDO4:triggersAlertLevel "High"^^xsd:string .

LFTDO4:TheftDetectionSystem a owl:NamedIndividual,
        LFTDO4:DetectionMethod ;
    rdfs:label "TheftDetectionSystem" ;
    rdfs:comment "TheftDetectionSystem" ;
    LFTDO4:analyses LFTDO4:Database001 ;
    LFTDO4:isImplementedBy LFTDO4:SoftwareApp001 ;
    LFTDO4:uses LFTDO4:Algorithm001 .

LFTDO4:UnsualGoatMovement a owl:NamedIndividual,
        LFTDO4:BehaviourState ;
    rdfs:label "UnsualGoatMovement" ;
    rdfs:comment "UnsualGoatMovement" ;
    LFTDO4:hasBehaviourStateContext "NightTime" ;
    LFTDO4:isCharacterisedBy LFTDO4:HighGoatBehaviourTheftIndicator001 ;
    LFTDO4:isCurrentBehaviourStateOf LFTDO4:GoatGrazing ;
    LFTDO4:isTransitionedFrom LFTDO4:GoatGrazingState1 .

LFTDO4:hasBehaviourStateConfidenceScore a owl:DatatypeProperty ;
    rdfs:label "hasBehaviourStateConfidenceScore" ;
    rdfs:comment "BehaviourState has some ConfidenceScore" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasBehaviourStateDescription a owl:DatatypeProperty ;
    rdfs:label "hasBehaviourStateDescription" ;
    rdfs:comment "BehaviourState has some Description" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasLongitude a owl:DatatypeProperty ;
    rdfs:label "hasLongitude" ;
    rdfs:comment "Geo location has some Longitude" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:Device LFTDO4:Location ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf LFTDO4:hasGeoPosition .

LFTDO4:isAlertInitiatedBy a owl:ObjectProperty ;
    rdfs:label "isAlertInitiatedBy" ;
    rdfs:comment "HighTheftEvent is isInitiated by some TheftIndicator a logical cause (the data anomaly)" ;
    rdfs:domain LFTDO4:LivestockEvent ;
    rdfs:range LFTDO4:LivestockIndicator .

LFTDO4:uses a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:comment """TheftDetectionMethod uses some Algorithm
The software runs the code.""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:DetectionMethod LFTDO4:SoftwareApplication ) ] ;
    rdfs:range LFTDO4:Algorithm .

owl:topObjectProperty rdfs:label "owl:topObjectProperty" .

LFTDO4:LethargyIndicator a owl:NamedIndividual,
        LFTDO4:HealthIndicator ;
    rdfs:label "LethargyIndicator"^^xsd:string ;
    LFTDO4:isDetectedBy LFTDO4:HealthDetectionMethod ;
    LFTDO4:triggersAlertLevel "High"^^xsd:string .

LFTDO4:UnusualHealthState a owl:NamedIndividual,
        LFTDO4:AbnormalState ;
    rdfs:label "UnusualHealthState" ;
    rdfs:comment "UnusualHealthState" ;
    LFTDO4:isCharacterisedBy LFTDO4:FeverIndicator,
        LFTDO4:LethargyIndicator .

LFTDO4:experiences a owl:ObjectProperty ;
    rdfs:label "Livestock experiences some HealthCondition",
        "experiences" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range LFTDO4:HealthCondition ;
    owl:inverseOf LFTDO4:isExperiencedBy .

LFTDO4:hasBodyTemperature a owl:DatatypeProperty ;
    rdfs:label "hasBodyTemperature" ;
    rdfs:comment "Livestock has some Body Tempareture" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:decimal .

LFTDO4:hasEnvValue a owl:DatatypeProperty ;
    rdfs:label "hasEnvValue" ;
    rdfs:comment "EnvironmentCondition has some Tempareture" ;
    rdfs:domain LFTDO4:EnvironmentalCondition ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasHealthIndicator a owl:ObjectProperty ;
    rdfs:label "hasHealthIndicator" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range LFTDO4:HealthIndicator .

LFTDO4:hasLatitude a owl:DatatypeProperty ;
    rdfs:label "hasLatitude" ;
    rdfs:comment "Geo location has some Latitude" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:Device LFTDO4:Location ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf LFTDO4:hasGeoPosition .

LFTDO4:isCurrentBehaviourStateOf a owl:ObjectProperty ;
    rdfs:label "isCurrentBehaviourStateOf" ;
    rdfs:comment "BehaviourState is related to some Behaviour" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range LFTDO4:Behaviour .

LFTDO4:isInfluencedBy a owl:ObjectProperty ;
    rdfs:label "isInfluencedBy" ;
    rdfs:comment """BehaviourState is influenced by some EnvironmentalConditions

isInfluencedBy (Active/Causal): This means the environment is changing the behavior.
Example: "The sheep stopped grazing because the rain became a heavy storm.\"""" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range LFTDO4:EnvironmentalCondition .

LFTDO4:isInfluencedByHealthCondition a owl:ObjectProperty ;
    rdfs:label "isInfluencedByHealthCondition" ;
    rdfs:comment "BehaviourState is influencedBy some HealthCondition" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range LFTDO4:HealthCondition .

:wandering a swrl:Variable .

LFTDO4:hasBehaviourStateDeviation a owl:DatatypeProperty ;
    rdfs:label "hasBehaviourStateDeviation" ;
    rdfs:comment "Normal BehaviourState has some DeviationThresholdIn%" ;
    rdfs:domain LFTDO4:NormalState ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

:sp a swrl:Variable .

LFTDO4:SystemEvent a owl:Class ;
    rdfs:label "SystemEvent" ;
    rdfs:comment "SystemEvent (Events related to the software's operations)" .

:speed a swrl:Variable .

LFTDO4:TheftIndicator a owl:Class ;
    rdfs:label "TheftIndicator" ;
    rdfs:comment "Factors suggesting a potential of theft, linking them to relevant behavior states, environment, and health conditions." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue "High" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Low" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Medium" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] ) ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:initiatesAlert ;
            owl:someValuesFrom LFTDO4:TheftEvent ],
        LFTDO4:LivestockIndicator .

LFTDO4:hasSpeed a owl:DatatypeProperty ;
    rdfs:label "hasSpeed" ;
    rdfs:comment "Livestock BehaviourState has some Speed measured in meters per second",
        "Livestock hasSpeed movement that can be measured based on the type of Livestock for e.g. Sheep and Goat is in meters per seconds(m/s), Cattle is in Kilometer per hour(km/h)." ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

:NormSheepWanderingState a swrl:Variable .

:ggs a swrl:Variable .

:t a swrl:Variable .

LFTDO4:DataTransmission a owl:Class ;
    rdfs:label "DataTransmission" ;
    rdfs:comment "DataTransmission: Represent the flow of data between devices and cloud services." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDataSize ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDataTimeStamp ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCloudService ;
            owl:someValuesFrom LFTDO4:CloudService ] .

LFTDO4:EndDevice a owl:Class ;
    rdfs:label "EndDevice" ;
    rdfs:comment """1.End device is device attached to a livestock fitted with sensors 
2.Some end device has some sensor""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty LFTDO4:hasDeviceID ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationFrequencyRange ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSerialNumber ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasManufacturerName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:generatesData ;
            owl:someValuesFrom LFTDO4:SensorData ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isAttachedTo ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceCapacity ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceBatteryLife ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDevicePrice ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSensorType ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:Device .

LFTDO4:SoftwareApp002 a owl:NamedIndividual,
        LFTDO4:SoftwareApplication ;
    rdfs:label "SoftwareApp002" ;
    rdfs:comment "SoftwareApp002" ;
    LFTDO4:accesses LFTDO4:Database001 ;
    LFTDO4:hasID "APP-BIO-2024-001"^^xsd:string ;
    LFTDO4:hasLastSyncTime "2024-02-15T13:05:00"^^xsd:dateTime ;
    LFTDO4:hasResponseTimeMs 90.0 ;
    LFTDO4:hasSoftwareAppName "BioTrack-Health"^^xsd:string ;
    LFTDO4:hasSoftwareVersion "v0.0"^^xsd:string ;
    LFTDO4:isDeployedOn LFTDO4:CloudService001 ;
    LFTDO4:isOnline true .

LFTDO4:hasCurrentLocation a owl:ObjectProperty ;
    rdfs:label "hasCurrentLocation" ;
    rdfs:comment "Evironment condition and Livestock has a current Location at any point in time" ;
    rdfs:range LFTDO4:Location ;
    owl:inverseOf LFTDO4:isCurrentLocationOf .

LFTDO4:isCharacterisedBy a owl:ObjectProperty ;
    rdfs:label "isCharacterisedBy" ;
    rdfs:comment "AbnormalState isCharacterisedBy TheftIndicator" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:BehaviourState LFTDO4:EnvironmentalCondition LFTDO4:HealthCondition ) ] ;
    rdfs:range LFTDO4:LivestockIndicator ;
    rdfs:subPropertyOf owl:topObjectProperty .

LFTDO4:triggers a owl:ObjectProperty ;
    rdfs:label "triggers" ;
    rdfs:comment """BehaviourState or DetectionMethod triggers some Event(Livestock or System Event)

A DetectionMethod (like TheftDetection) may trigger zero events if everything is normal. However, if a theft is detected, it might trigger many events simultaneously (e.g., a TheftEvent for the farmer and a StatusUpdateEvent for the system log).""" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:BehaviourState LFTDO4:DetectionMethod LFTDO4:LivestockIndicator ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( LFTDO4:LivestockEvent LFTDO4:SystemEvent ) ] .

:running a swrl:Variable .

LFTDO4:hasComponent a owl:ObjectProperty ;
    rdfs:label "hasComponent" ;
    rdfs:comment "Device has some Sensor Components" ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range LFTDO4:Sensor ;
    owl:inverseOf LFTDO4:isSensorOf .

LFTDO4:hasDurationBaseline a owl:DatatypeProperty ;
    rdfs:label "hasDurationBaseline" ;
    rdfs:comment "hasDurationBaseline define the NormalState" ;
    rdfs:domain LFTDO4:NormalState ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasUoM a owl:DatatypeProperty ;
    rdfs:label "hasUoM" ;
    rdfs:comment "Measuring unit tools has different unit of measures for e.g. speed measured in meters per seconds(m/s) or kilometers per hour(km/h)" ;
    rdfs:range xsd:string .

LFTDO4:hasValue a owl:DatatypeProperty ;
    rdfs:label "hasValue" ;
    rdfs:comment "SensorData has some Value." ;
    rdfs:domain LFTDO4:SensorData ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:generatesData a owl:ObjectProperty ;
    rdfs:label "generatesData" ;
    rdfs:comment "Device generates some Data" ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range LFTDO4:SensorData ;
    owl:inverseOf LFTDO4:isGeneratedByDevice .

:baseSpeed a swrl:Variable .

LFTDO4:Farmer a owl:Class ;
    rdfs:label "Farmer" ;
    rdfs:comment """Farmer is the owner of some Livestock.
A Farmer owns various domestic animals such as cattle, sheep, and goats.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasParticipantRole ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty LFTDO4:hasParticipantID ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasParticipantName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isOwnerOfLivestock ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:usesFarm ;
            owl:someValuesFrom LFTDO4:Farm ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasContactNumber ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:Participant .

:currLoc a swrl:Variable .

LFTDO4:Farm a owl:Class ;
    rdfs:label "Farm" ;
    rdfs:comment "The farm is a location with some livestock." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLatitude ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isMonitoredByDevice ;
            owl:someValuesFrom LFTDO4:Device ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLongitude ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasFence ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isUsedByFarmer ;
            owl:someValuesFrom LFTDO4:Farmer ],
        LFTDO4:Location .

LFTDO4:exhibitedBy a owl:ObjectProperty ;
    rdfs:label "exhibitedBy" ;
    rdfs:comment "Behaviour is exhibitedBy Livestock" ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range LFTDO4:Livestock ;
    owl:inverseOf LFTDO4:exhibits .

LFTDO4:hasBehaviourStartTime a owl:DatatypeProperty ;
    rdfs:label "hasBehaviourStartTime" ;
    rdfs:comment "Behaviour has Start Time" ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasIntensity a owl:DatatypeProperty ;
    rdfs:label "hasIntensity" ;
    rdfs:comment "Behaviour has some level of intensity." ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:Duration a swrl:Variable .

LFTDO4:AbnormalState a owl:Class ;
    rdfs:label "AbnormalState" ;
    rdfs:comment """Behaviour state that breaks a social norm, that is statistically infrequent and prevents livestock from functioning.

Sub-classes:
1.DistressVocalization
2.Restlessness
3.UnusualMovement""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:isCharacterisedBy ;
            owl:someValuesFrom LFTDO4:TheftIndicator ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isCurrentBehaviourStateOf ;
            owl:someValuesFrom LFTDO4:Behaviour ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isInfluencedByHealthCondition ;
            owl:someValuesFrom LFTDO4:HealthCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSpeed ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateConfidenceScore ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateContext ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isInfluencedBy ;
            owl:someValuesFrom LFTDO4:EnvironmentalCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSeverityLevel ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:BehaviourState ;
    owl:disjointWith LFTDO4:NormalState .

LFTDO4:TheftEvent a owl:Class ;
    rdfs:label "TheftEvent" ;
    rdfs:comment "TheftEvent: Is trigged by some TheftIndicator that is identified as a theft attempts or suspicious event and is caused by some UnauthorisedPerson" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventResolution ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isTriggeredBy ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue "High" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Low" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Medium" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] ) ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventStatus ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:affectsLivestock ;
            owl:someValuesFrom LFTDO4:Livestock ],
        LFTDO4:LivestockEvent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty LFTDO4:causedBy ;
                        owl:someValuesFrom LFTDO4:UnauthorisedPerson ] [ a owl:Restriction ;
                        owl:onProperty LFTDO4:hasAbnormalBehaviourState ;
                        owl:someValuesFrom LFTDO4:AbnormalState ] [ a owl:Restriction ;
                        owl:onProperty LFTDO4:isAlertInitiatedBy ;
                        owl:someValuesFrom LFTDO4:TheftIndicator ] ) ] .

LFTDO4:hasDuration a owl:DatatypeProperty ;
    rdfs:label "hasDuration" ;
    rdfs:comment "Behaviour has Duration in seconds (seconds/60 = Minutes)" ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:transitionsTo a owl:ObjectProperty ;
    rdfs:label "transitionsTo" ;
    rdfs:comment "NormalState get transitioned to AbnormalState" ;
    rdfs:domain LFTDO4:NormalState ;
    rdfs:range LFTDO4:AbnormalState ;
    rdfs:subPropertyOf owl:topObjectProperty .

LFTDO4:NormalSheepRestingState a owl:NamedIndividual,
        LFTDO4:SheepRestingState ;
    rdfs:label "NormalSheepRestingState"^^xsd:string ;
    LFTDO4:hasBaseLineHeadingDirection 45.00 ;
    LFTDO4:hasBaseLineHeadingDirectionUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaseLineSignalStrength -100.0 ;
    LFTDO4:hasBaseLineSignalStrengthUoM "dBm"^^xsd:string ;
    LFTDO4:hasBaseLineType "Average"^^xsd:string ;
    LFTDO4:hasBaselinePosture 90.0 ;
    LFTDO4:hasBaselinePostureUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaselineStepCount 0 ;
    LFTDO4:hasBaselineStepCountUoM "count"^^xsd:string ;
    LFTDO4:hasBehaviourStateBaselineValues 0.05 ;
    LFTDO4:hasBehaviourStateContext "DayTime"^^xsd:string ;
    LFTDO4:hasDurationBaseline 4000.0 ;
    LFTDO4:hasUoM "m/s"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:NormalActivityIndicator ;
    LFTDO4:isOutsideGeofence false .

:context a swrl:Variable .

:ls a swrl:Variable .

LFTDO4:EscapedSheepState a owl:NamedIndividual,
        LFTDO4:AbnormalState ;
    rdfs:label "EscapedSheepState"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:EscapedActivityIndicator ;
    LFTDO4:isOutsideGeofence true .

LFTDO4:hasBehaviourStateBaselineValues a owl:DatatypeProperty ;
    rdfs:label "hasBehaviourBaselineValues" ;
    rdfs:comment "NormalState has some BaselineValue" ;
    rdfs:domain LFTDO4:NormalState ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:isOutsideGeofence a owl:DatatypeProperty ;
    rdfs:label "isOutsideGeofence" ;
    rdfs:comment "Livestock isOutsideGeofence, True or False." .

LFTDO4:triggersAlertLevel a owl:DatatypeProperty ;
    rdfs:label "triggersAlertLevel" ;
    rdfs:comment "TheftIndicator has a triggersAlertLevel" ;
    rdfs:domain LFTDO4:LivestockIndicator ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:LivestockEvent a owl:Class ;
    rdfs:label "LivestockEvent" ;
    rdfs:comment "LivestockEvent  is the \"Outcome\" or \"Alert\" of the Livestock Indicators." .

LFTDO4:NormalActivityIndicator a owl:NamedIndividual,
        LFTDO4:NormalGrazingIndicator ;
    rdfs:label "NormalActivityIndicator" ;
    rdfs:comment "NormalActivityIndicator" ;
    LFTDO4:isDetectedBy LFTDO4:TheftDetectionSystem ;
    LFTDO4:triggersAlertLevel "Low"^^xsd:string .

:baseDuration a swrl:Variable .

LFTDO4:NormalGoatRunningState a owl:NamedIndividual,
        LFTDO4:GoatRunningState ;
    rdfs:label "NormalGoatRunningState"^^xsd:string ;
    LFTDO4:hasBaseLineHeadingDirection 45.0 ;
    LFTDO4:hasBaseLineHeadingDirectionUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaseLineSignalStrength -100.0 ;
    LFTDO4:hasBaseLineSignalStrengthUoM "dBm"^^xsd:string ;
    LFTDO4:hasBaseLineType "Maximum Normal"^^xsd:string ;
    LFTDO4:hasBaselinePosture 0.0 ;
    LFTDO4:hasBaselinePostureUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaselineStepCount 200 ;
    LFTDO4:hasBaselineStepCountUoM "count"^^xsd:string ;
    LFTDO4:hasBehaviourStateBaselineValues 6.0 ;
    LFTDO4:hasBehaviourStateContext "DayTime"^^xsd:string ;
    LFTDO4:hasDurationBaseline 300.0 ;
    LFTDO4:hasUoM "m/s"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:NormalActivityIndicator ;
    LFTDO4:isOutsideGeofence false .

LFTDO4:Algorithm a owl:Class ;
    rdfs:label "Algorithm" ;
    rdfs:comment """1.Machine Learning(ML) algorithm is part of the cloud computing service for some behaviour analysis
2.ML Algorithm(MLA) uses data in the Database to detect theft""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasAlgorithmName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasOutputFormat ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasPurpose ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasInputFeatures ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasResourceRequirements ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasVersion ;
            owl:someValuesFrom xsd:string ] .

LFTDO4:CloudService a owl:Class ;
    rdfs:label "CloudService" ;
    rdfs:comment "Cloud Computing Service enables the on-demand and convenient delivery of shared configurable computing resources and services over a network (Kuo, 2011, Paul and Ghose, 2012). CC plays a key role in enabling the ability of IoT devices to send, store, analyze data, and receive analyzed data remotely. CC service includes machine learning algorithms to analyze livestock behavior to detect and indicate livestock theft." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCloudServiceProvider ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCloudServiceType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:cloudServiceName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:executesApplication ;
            owl:someValuesFrom LFTDO4:SoftwareApplication ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCloudServiceDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hostsDatabase ;
            owl:someValuesFrom LFTDO4:Database ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCloudSecurityFeatures ;
            owl:someValuesFrom xsd:string ] .

LFTDO4:NormalState a owl:Class ;
    rdfs:label "NormalState" ;
    rdfs:comment """Behaviour state that are a social norm, that is statistically frequent and prevents livestock from functioning.
Sub-classes:
1.CatleRunningState
2.GoatGrazingState""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateContext ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isInfluencedByHealthCondition ;
            owl:someValuesFrom LFTDO4:HealthCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateBaselineValues ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSpeed ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isInfluencedBy ;
            owl:someValuesFrom LFTDO4:EnvironmentalCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateDeviation ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isCurrentBehaviourStateOf ;
            owl:someValuesFrom LFTDO4:Behaviour ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStateConfidenceScore ;
            owl:someValuesFrom xsd:integer ],
        LFTDO4:BehaviourState .

LFTDO4:UnusualRestingState a owl:NamedIndividual,
        LFTDO4:AbnormalState ;
    rdfs:label "UnusualRestingState" ;
    rdfs:comment "UnusualRestingState" ;
    LFTDO4:isCharacterisedBy LFTDO4:LethargyIndicator .

LFTDO4:exhibits a owl:ObjectProperty ;
    rdfs:label "exhibits" ;
    rdfs:comment "Livestock exhibit some Behaviour" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range LFTDO4:Behaviour .

LFTDO4:hasBehaviourStateContext a owl:DatatypeProperty ;
    rdfs:label "hasBehaviourStateContext" ;
    rdfs:comment "BehaviourState has some Context" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:isAttachedToDevice a owl:ObjectProperty ;
    rdfs:label "isAttachedToDevice" ;
    rdfs:comment "Livestock is attached to some Device(EndDevice)" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range LFTDO4:EndDevice .

LFTDO4:LivestockIndicator a owl:Class ;
    rdfs:label "LivestockIndicator" ;
    rdfs:comment "LivestockIndicators satisfy the necessary and sufficient conditions to infer a different high-level LivestockEvent (e.g., TheftEvent), providing a clear audit trail from raw data to actionable alert." .

LFTDO4:Database a owl:Class ;
    rdfs:label "Database" ;
    rdfs:comment "The database is part of the cloud computing services for storing, accessing, and displaying data from livestock farming devices." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDatabaseBackupAndRecovery ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDatabaseStorageCapacity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDatabaseSchema ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDatabaseAccessControl ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:storeData ;
            owl:someValuesFrom LFTDO4:SensorData ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDatabaseType ;
            owl:someValuesFrom xsd:string ] .

:resting a swrl:Variable .

LFTDO4:NormalCattleRunningState a owl:NamedIndividual,
        LFTDO4:CattleRunningState ;
    rdfs:label "NormalCattleRunningState"^^xsd:string ;
    LFTDO4:hasBaseLineHeadingDirection 45.0 ;
    LFTDO4:hasBaseLineHeadingDirectionUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaseLineSignalStrength -100.0 ;
    LFTDO4:hasBaseLineSignalStrengthUoM "dBm"^^xsd:string ;
    LFTDO4:hasBaseLineTemp 39.4 ;
    LFTDO4:hasBaseLineTempUoM "Celsius"^^xsd:string ;
    LFTDO4:hasBaseLineType "Maximum Normal"^^xsd:string ;
    LFTDO4:hasBaselinePosture 0.0 ;
    LFTDO4:hasBaselinePostureUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaselineStepCount 100 ;
    LFTDO4:hasBaselineStepCountUoM "count"^^xsd:string ;
    LFTDO4:hasBehaviourStateBaselineValues 4.5 ;
    LFTDO4:hasBehaviourStateContext "DayTime"^^xsd:string ;
    LFTDO4:hasDurationBaseline 300.0 ;
    LFTDO4:hasUoM "km/h"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:NormalActivityIndicator ;
    LFTDO4:isOutsideGeofence false .

LFTDO4:Participant a owl:Class ;
    rdfs:label "Participant" ;
    rdfs:comment """A participant in livestock farming such as Farmers, and others such as extended officers, veterinarians, and Law enforcement agents.
A Farmer owns various domestic animals such as cattle, sheep, and goats. 
The veterinarian understands the behavior of domestic animals and often treats the domestic animals for diseases.    
Extended officers, work on a farm, to manage livestock such as feeding, keeping count, managing their well-being, and protecting against theft.
Law enforcement agents, enforce the law of the country if not being adhered to such as theft, and abuse of livestock.

Sub-classes:
1. Farmer
2.ExtendedOfficer
3.LawEnforcementAgency
4.Veterinarian""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasParticipantName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty LFTDO4:hasParticipantID ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:validateStatusOfEvent ;
            owl:someValuesFrom LFTDO4:StatusUpdateEvent ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasContactNumber ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasParticipantRole ;
            owl:someValuesFrom xsd:string ] .

LFTDO4:SoftwareApplication a owl:Class ;
    rdfs:label "SoftwareApplication" ;
    rdfs:comment """1.Software application is part of cloud computing services and uses some Machine Learning algorithm
2.Software Application uses results from ML Algorithm
(MLA)""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasFunctionality ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:implements ;
            owl:someValuesFrom LFTDO4:DetectionMethod ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:notifies ;
            owl:someValuesFrom LFTDO4:Participant ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSoftwareAppName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCompatibility ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSoftwareAppType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSoftwareVersion ;
            owl:someValuesFrom xsd:string ] .

LFTDO4:inferredByRule a owl:DatatypeProperty ;
    rdfs:label "inferredByRule" ;
    rdfs:comment "Indicates which SWRL rule was executed and Inferred results." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:BehaviourState LFTDO4:Livestock LFTDO4:LivestockEvent LFTDO4:LivestockIndicator ) ] ;
    rdfs:range xsd:string .

LFTDO4:EnvironmentalCondition a owl:Class ;
    rdfs:label "EnvironmentalCondition" ;
    rdfs:comment """Environmental condition influence livestock behavior, such as grazing, sleeping, and feeding, are also significantly influenced by their environmental conditions and weather changes such as rain, heat, and cold (Chaudhry et al., 2020).

Sub-classes:
1.ExtreamHeat""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasPrecipitation ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasEnvValue ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasWeatherCondition ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasEnvironmentDescription ;
            owl:someValuesFrom xsd:string ] .

LFTDO4:hasCurrentBehaviourState a owl:ObjectProperty ;
    rdfs:label "hasCurrentBehaviourState" ;
    rdfs:comment "Behaviour has some current BehaviourState" ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range LFTDO4:BehaviourState ;
    owl:inverseOf LFTDO4:isCurrentBehaviourStateOf .

LFTDO4:HealthCondition a owl:Class ;
    rdfs:label "HealthCondition" ;
    rdfs:comment """Health condition indicates various health situations of a livestock, related to Livestock behavior pertaining to livestock theft situations.
Sub-routine:
1.LegInjurty
2.Sick""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:healthInfluencesBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSymptoms ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasHealthDescription ;
            owl:someValuesFrom xsd:string ] .

LFTDO4:DetectionMethod a owl:Class ;
    rdfs:label "DetectionMethod" ;
    rdfs:comment """Detection Method: Represent the algorithms used to detect the theft events.
Sub-classes:
1.AudioMonitoringSystem
2.BehaviourMonitoringSystem
3.GPSTrackingSystem
4.VideoMonitoringSystem""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDetectionMethodType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:uses ;
            owl:someValuesFrom LFTDO4:Algorithm ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDetectionMethodAccuracy ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:analyses ;
            owl:someValuesFrom LFTDO4:Database ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTrainingData ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasFalsePositiveRate ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasMethodAttribute ;
            owl:someValuesFrom xsd:string ] .

:sensorComp a swrl:Variable .

LFTDO4:NormalGoatWanderingState a owl:NamedIndividual,
        LFTDO4:GoatWanderingState ;
    rdfs:label "NormalGoatWanderingState"^^xsd:string ;
    LFTDO4:hasBaseLineHeadingDirection 45.0 ;
    LFTDO4:hasBaseLineHeadingDirectionUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaseLineSignalStrength -100.0 ;
    LFTDO4:hasBaseLineSignalStrengthUoM "dBm"^^xsd:string ;
    LFTDO4:hasBaseLineType "Maximum Normal"^^xsd:string ;
    LFTDO4:hasBaselinePosture 0.0 ;
    LFTDO4:hasBaselinePostureUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaselineStepCount 80 ;
    LFTDO4:hasBaselineStepCountUoM "count"^^xsd:string ;
    LFTDO4:hasBehaviourStateBaselineValues 2.5 ;
    LFTDO4:hasBehaviourStateContext "DayTime"^^xsd:string ;
    LFTDO4:hasDurationBaseline 1800.0 ;
    LFTDO4:hasUoM "m/s"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:NormalActivityIndicator ;
    LFTDO4:isOutsideGeofence false .

LFTDO4:Sitting a owl:Class ;
    rdfs:label "Sitting" ;
    rdfs:comment """1.Sitting is a behaviour
2.Sitting can be a normal or abnormal behaviour state based on duration of sitting""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        LFTDO4:Behaviour .

LFTDO4:NormalCattleWanderingState a owl:NamedIndividual,
        LFTDO4:CattleWanderingState ;
    rdfs:label "NormalCattleWanderingState"^^xsd:string ;
    LFTDO4:hasBaseLineHeadingDirection 45.0 ;
    LFTDO4:hasBaseLineHeadingDirectionUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaseLineSignalStrength -100.0 ;
    LFTDO4:hasBaseLineSignalStrengthUoM "dBm"^^xsd:string ;
    LFTDO4:hasBaseLineTemp 39.4 ;
    LFTDO4:hasBaseLineTempUoM "Celsius"^^xsd:string ;
    LFTDO4:hasBaseLineType "Maximum Normal"^^xsd:string ;
    LFTDO4:hasBaselinePosture 0.0 ;
    LFTDO4:hasBaselinePostureUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaselineStepCount 40 ;
    LFTDO4:hasBaselineStepCountUoM "count"^^xsd:string ;
    LFTDO4:hasBehaviourStateBaselineValues 1.8 ;
    LFTDO4:hasBehaviourStateContext "DayTime"^^xsd:string ;
    LFTDO4:hasDurationBaseline 1800.0 ;
    LFTDO4:hasUoM "km/h"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:NormalActivityIndicator ;
    LFTDO4:isOutsideGeofence false .

LFTDO4:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment """Locations are farmer area where the livestock are being kept is referred to as a Farm.It can be at an urban, rural, or semi-urban location, and may have pen and open fields that are fenced or unfenced. 

The position of livestock within a farm location is constrained to date and time, and their behavior influences their movement. The livestock position within a location may be indicated with coordinates such as longitude and latitude, which are used to precisely determine the location of livestock within a farm area, as discussed by  (Symeonaki et al., 2020).

Relationships:
1.Location (e.g., a farm) has a specific time period(startTime and endTime) during which certain events or activities occurs.
2.Location (e.g., a farm) has a specific geographical position defined by latitude and longitude coordinates.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLongitude ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLatitude ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationDescription ;
            owl:someValuesFrom xsd:string ] .

LFTDO4:NormalSheepRunningState a owl:NamedIndividual,
        LFTDO4:SheepRunningState ;
    rdfs:label "NormalSheepRunningState"^^xsd:string ;
    LFTDO4:hasBaseLineHeadingDirection 45.00 ;
    LFTDO4:hasBaseLineHeadingDirectionUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaseLineSignalStrength -100.0 ;
    LFTDO4:hasBaseLineSignalStrengthUoM "dBm"^^xsd:string ;
    LFTDO4:hasBaseLineType "Maximum Normal"^^xsd:string ;
    LFTDO4:hasBaselinePosture 0.0 ;
    LFTDO4:hasBaselinePostureUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaselineStepCount 120 ;
    LFTDO4:hasBaselineStepCountUoM "count"^^xsd:string ;
    LFTDO4:hasBehaviourStateBaselineValues 4.5,
        4.50 ;
    LFTDO4:hasBehaviourStateContext "DayTime"^^xsd:string ;
    LFTDO4:hasDurationBaseline 300.0 ;
    LFTDO4:hasUoM "m/s"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:NormalActivityIndicator ;
    LFTDO4:isOutsideGeofence false .

LFTDO4:NormalSheepWanderingState a owl:NamedIndividual,
        LFTDO4:SheepWanderingState ;
    rdfs:label "NormalSheepWanderingState"^^xsd:string ;
    LFTDO4:hasBaseLineHeadingDirection 45.00 ;
    LFTDO4:hasBaseLineHeadingDirectionUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaseLineSignalStrength -100.0 ;
    LFTDO4:hasBaseLineSignalStrengthUoM "dBm"^^xsd:string ;
    LFTDO4:hasBaseLineType "Maximum Normal"^^xsd:string ;
    LFTDO4:hasBaselinePosture 0.0 ;
    LFTDO4:hasBaselinePostureUoM "degrees"^^xsd:string ;
    LFTDO4:hasBaselineStepCount 60 ;
    LFTDO4:hasBaselineStepCountUoM "count"^^xsd:string ;
    LFTDO4:hasBehaviourStateBaselineValues 4.00 ;
    LFTDO4:hasBehaviourStateContext "DayTime"^^xsd:string ;
    LFTDO4:hasDurationBaseline 1800.0 ;
    LFTDO4:hasUoM "m/s"^^xsd:string ;
    LFTDO4:isCharacterisedBy LFTDO4:NormalActivityIndicator ;
    LFTDO4:isOutsideGeofence false .

LFTDO4:Running a owl:Class ;
    rdfs:label "Running" ;
    rdfs:comment """Referenced Ontology:
1.Running is a behaviour = running behavior(ATOL:0000806), "any measurable or observable characteristic related to rapidely coordinated displacement of the body on foot or limbs"  (Meunier-Salaün et. al,2015)
2.Running can have normal or abnomal behaviour state based on the livestock speed and running duration.

AOL Under: Animal trait of livestock->animal welfar trait->psychoneuroendocrinological state trait->motor activity->locomotor activity->running behaviour""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        LFTDO4:Behaviour .

:sensorData a swrl:Variable .

:NormState a swrl:Variable .

:dev a swrl:Variable .

LFTDO4:Wandering a owl:Class ;
    rdfs:label "Wandering" ;
    rdfs:comment "Wandering is a Behaviour." ;
    rdfs:subClassOf LFTDO4:Behaviour .

