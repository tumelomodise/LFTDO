    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Sleeping -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Sleeping">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology:
1.Sleeping is a behaviour
2.Sleeping can be a normal or abnormal state based on the sleeping duration
Sleeping = Sleep pattern(ATOL:000369) &quot;any measurable or observable characteristic related to the wake/sleep cycle&quot; (Meunier-Salaün et. al,2015)
Under: Animal Trait-&gt;Pyschoneuroendocrinological state trait-&gt;biological rhythm-&gt;sleep pattern</rdfs:comment>
        <rdfs:label>Sleeping</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SoftwareApplication -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SoftwareApplication">
