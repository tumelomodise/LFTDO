        <hasAlgorithmVersion>v0.1</hasAlgorithmVersion>
        <hasComplexity>HIGH</hasComplexity>
        <hasDetectionMethodAccuracy rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.98</hasDetectionMethodAccuracy>
        <isOptimized rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isOptimized>
        <rdfs:comment>Algorithm003</rdfs:comment>
        <rdfs:label>Algorithm003</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://github.com/tumelomodise/LFTDO#Algorithm004 -->


