###  https://github.com/tumelomodise/LFTDO#Behaviour
:Behaviour rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :exhibitedBy ;
                             owl:someValuesFrom :Livestock
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasBehaviourStartTime ;
                             owl:someValuesFrom xsd:dateTime
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasIntensity ;
                             owl:someValuesFrom xsd:string
                           ] ;
           rdfs:comment """Livestock behavior includes a broader range of activities exhibited by an animal over a period. It includes actions, reactions, and responses to various stimuli and situations. 

Sub-classess
1.Sleeping
2.Breeding
3.Grazing
4.Feeding
5.Sitting
6.AbnormalBehaviour
7.Agreession
8.NormalBehaviour
9.Running""" ;
           rdfs:label "Behaviour" .


###  https://github.com/tumelomodise/LFTDO#BehaviourState
:BehaviourState rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :isCurrentBehaviourStateOf ;
                                  owl:someValuesFrom :Behaviour
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isInfluencedBy ;
                                  owl:someValuesFrom :EnvironmentalCondition
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isInfluencedByHealthCondition ;
                                  owl:someValuesFrom :HealthCondition
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasBehaviourStateConfidenceScore ;
                                  owl:someValuesFrom xsd:integer
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasBehaviourStateContext ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasBehaviourStateDescription ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasSpeed ;
                                  owl:someValuesFrom xsd:decimal
                                ] ;
                rdfs:comment """Livestock behavior state the actions that are are likely and less likely to happen at any point in time such as normal behavior state that includes grazing and feeding, and abnormal behavior states such as restlessness and aggression (Dieng et al., 2017, Risteska Stojkoska et al., 2018). Behavior states are influenced by health, environmental, body conditions, and their locations at any point in time.

sub-classes:
1.NormalState
2.AbnormalState""" ;
                rdfs:label "BehaviourState" .


###  https://github.com/tumelomodise/LFTDO#BodyTemperature
:BodyTemperature rdf:type owl:Class ;
                 rdfs:subClassOf :HealthCondition ;
                 rdfs:comment "Body temperature serves as a key vital sign in assessing livestock health, offering important  insights into the physiological status and general well-being of animals." ;
                 rdfs:label "BodyTemperature" .


###  https://github.com/tumelomodise/LFTDO#Boundary
:Boundary rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:unionOf ( [ owl:intersectionOf ( :Location
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :isAdjacentTo ;
                                                                       owl:someValuesFrom :Location
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ]
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty :isComponentOf ;
                                                owl:someValuesFrom :RestrictedArea
                                              ]
                                            )
                              ] ;
          rdfs:subClassOf :Location ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :isMonitoredByDevice ;
                            owl:someValuesFrom :Device
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :isUsedByFarmer ;
                            owl:someValuesFrom :Farmer
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasFence ;
                            owl:someValuesFrom xsd:boolean
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLatitude ;
                            owl:someValuesFrom xsd:decimal
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLocationDescription ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLocationName ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLocationType ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLongitude ;
                            owl:someValuesFrom xsd:decimal
                          ] ;
          rdfs:comment "The RestrictedArea is a location in a farm that isSecuredGuardedBy only EndUser device." .


###  https://github.com/tumelomodise/LFTDO#Breeding
:Breeding rdf:type owl:Class ;
          rdfs:subClassOf :Behaviour ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :exhibitedBy ;
                            owl:someValuesFrom :Livestock
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasCurrentBehaviourState ;
                            owl:someValuesFrom :BehaviourState
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBehaviourStartTime ;
                            owl:someValuesFrom xsd:dateTime
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIntensity ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment "1.Breeding is a behaviour" ;
