###  https://github.com/tumelomodise/LFTDO#Sleeping
:Sleeping rdf:type owl:Class ;
          rdfs:subClassOf :Behaviour ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :exhibitedBy ;
                            owl:someValuesFrom :Livestock
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasCurrentBehaviourState ;
                            owl:someValuesFrom :BehaviourState
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBehaviourStartTime ;
                            owl:someValuesFrom xsd:dateTime
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIntensity ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment """Referenced Ontology:
1.Sleeping is a behaviour
2.Sleeping can be a normal or abnormal state based on the sleeping duration
Sleeping = Sleep pattern(ATOL:000369) \"any measurable or observable characteristic related to the wake/sleep cycle\" (Meunier-Salaün et. al,2015)
Under: Animal Trait->Pyschoneuroendocrinological state trait->biological rhythm->sleep pattern""" ;
          rdfs:label "Sleeping" .


###  https://github.com/tumelomodise/LFTDO#SoftwareApplication
:SoftwareApplication rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :implements ;
                                       owl:someValuesFrom :DetectionMethod
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :notifies ;
                                       owl:someValuesFrom :Participant
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasCompatibility ;
                                       owl:someValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasFunctionality ;
                                       owl:someValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasSoftwareAppName ;
                                       owl:someValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasSoftwareAppType ;
                                       owl:someValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasSoftwareVersion ;
                                       owl:someValuesFrom xsd:string
                                     ] ;
                     rdfs:comment """1.Software application is part of cloud computing services and uses some Machine Learning algorithm
2.Software Application uses results from ML Algorithm
(MLA)""" ;
                     rdfs:label "SoftwareApplication" .


###  https://github.com/tumelomodise/LFTDO#SpaceUse
:SpaceUse rdf:type owl:Class ;
          rdfs:subClassOf :Behaviour ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :exhibitedBy ;
                            owl:someValuesFrom :Livestock
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasCurrentBehaviourState ;
                            owl:someValuesFrom :BehaviourState
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBehaviourStartTime ;
                            owl:someValuesFrom xsd:dateTime
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIntensity ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment "Referenced Ontology: SpaceUse = Space use(ATOL0000831:) \"any measurable or observable characteristic related to the behavior of the animals to use their physical environment according to the social or physical stimuli within this environment  (e.g. use of perches, use of specific area, geographic location)\" (Meunier-Salaün et. al,2015)" ;
          rdfs:label "SpaceUse" .


###  https://github.com/tumelomodise/LFTDO#Startle
:Startle rdf:type owl:Class ;
         rdfs:subClassOf :Behaviour ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :exhibitedBy ;
                           owl:someValuesFrom :Livestock
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasCurrentBehaviourState ;
                           owl:someValuesFrom :BehaviourState
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasBehaviourStartTime ;
                           owl:someValuesFrom xsd:dateTime
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIntensity ;
                           owl:someValuesFrom xsd:string
                         ] ;
         rdfs:comment """Referenced Ontology:
1. Startle is a Behaviour = startle reponses(ATOL:0000368), \"any measurable or observable characteristic related to the response of the whole body to triggering stimulus without any voluntary orientation towards this given stimulus\"

In ATOL under:Aninmal trait of livestock->animal welfare trait->psychoneuroendcrinological state trait->behavior trait->motor activity->body movement->locomotor activity->startle response""" ;
         rdfs:label "Startle" .


###  https://github.com/tumelomodise/LFTDO#StatusUpdateEvent
:StatusUpdateEvent rdf:type owl:Class ;
                   rdfs:subClassOf :SystemEvent ;
                   rdfs:comment "Classified the state change event." ;
                   rdfs:label "StatusUpdateEvent" .


###  https://github.com/tumelomodise/LFTDO#Suckling
:Suckling rdf:type owl:Class ;
          rdfs:subClassOf :Behaviour ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :exhibitedBy ;
                            owl:someValuesFrom :Livestock
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasCurrentBehaviourState ;
                            owl:someValuesFrom :BehaviourState
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBehaviourStartTime ;
                            owl:someValuesFrom xsd:dateTime
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIntensity ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment """Referenced Ontology:
1.Suckling = suckling behavior(ATOL:0000365)\"any measurable or observable beahvioral characteristic related to the intake of milk by a preweaning organism\"(Meunier-Salaün et. al,2015)
2.Suckling indicates the baby of livestock sucking miik from their mother, it had different rates, and number of times it does in an hour/day. 
3. it may have a abnormal behaviour state based on decreased suckling rate, which could indicate a baby livestock is separated from its mother

In ATOL under: animal trait of livestock->animal welfare trait->psychoneuroendocrinological state trait->behaviour trait->ingestive behavior->suckling behavior""" ;
          rdfs:label "Suckling" .


###  https://github.com/tumelomodise/LFTDO#SuspiciousEvent
:SuspiciousEvent rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                              owl:onProperty :hasAbnormalBehaviourState ;
                                                              owl:someValuesFrom :AbnormalState
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :isAlertInitiatedBy ;
                                                              owl:someValuesFrom :SuspiciousIndicator
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf :LivestockEvent ,
                                 [ rdf:type owl:Class ;
                                   owl:unionOf ( [ rdf:type owl:Restriction ;
                                                   owl:onProperty :triggersAlertLevel ;
                                                   owl:hasValue "High"
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :triggersAlertLevel ;
                                                   owl:hasValue "Low"
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :triggersAlertLevel ;
                                                   owl:hasValue "Medium"
                                                 ]
                                               )
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :affectsLivestock ;
                                   owl:someValuesFrom :Livestock
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :isTriggeredBy ;
                                   owl:someValuesFrom :BehaviourState
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTheftEventResolution ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTheftEventStatus ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTheftEventTime ;
                                   owl:someValuesFrom xsd:dateTime
                                 ] ;
                 rdfs:comment "SuspiciousEvent: Is trigged by some SuspiciousIndicator that is identified as a Livestock Behaviour changes that could indicate suspicious activities." ;
                 rdfs:label "SuspiciousEvent" .


###  https://github.com/tumelomodise/LFTDO#SuspiciousIndicator
:SuspiciousIndicator rdf:type owl:Class ;
                     rdfs:subClassOf :LivestockIndicator ;
                     rdfs:comment "Suspicious Indicator may indicate that there is a suspecious activity event." ;
                     rdfs:label "SuspiciousIndicator" .


###  https://github.com/tumelomodise/LFTDO#SystemEvent
:SystemEvent rdf:type owl:Class ;
             rdfs:comment "SystemEvent (Events related to the software's operations)" ;
             rdfs:label "SystemEvent" .


###  https://github.com/tumelomodise/LFTDO#TechnicalIndicator
:TechnicalIndicator rdf:type owl:Class ;
                    rdfs:subClassOf :LivestockIndicator .


###  https://github.com/tumelomodise/LFTDO#TheftEvent
:TheftEvent rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty :causedBy ;
                                                         owl:someValuesFrom :UnauthorisedPerson
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasAbnormalBehaviourState ;
                                                         owl:someValuesFrom :AbnormalState
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :isAlertInitiatedBy ;
                                                         owl:someValuesFrom :TheftIndicator
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :LivestockEvent ,
                            [ rdf:type owl:Class ;
                              owl:unionOf ( [ rdf:type owl:Restriction ;
                                              owl:onProperty :triggersAlertLevel ;
                                              owl:hasValue "High"
                                            ]
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :triggersAlertLevel ;
                                              owl:hasValue "Low"
                                            ]
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :triggersAlertLevel ;
                                              owl:hasValue "Medium"
                                            ]
                                          )
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :affectsLivestock ;
                              owl:someValuesFrom :Livestock
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :isTriggeredBy ;
                              owl:someValuesFrom :BehaviourState
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTheftEventResolution ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTheftEventStatus ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTheftEventTime ;
                              owl:someValuesFrom xsd:dateTime
                            ] ;
            rdfs:comment "TheftEvent: Is trigged by some TheftIndicator that is identified as a theft attempts or suspicious event and is caused by some UnauthorisedPerson" ;
            rdfs:label "TheftEvent" .


###  https://github.com/tumelomodise/LFTDO#TheftIndicator
:TheftIndicator rdf:type owl:Class ;
                rdfs:subClassOf :LivestockIndicator ,
                                [ rdf:type owl:Class ;
                                  owl:unionOf ( [ rdf:type owl:Restriction ;
                                                  owl:onProperty :triggersAlertLevel ;
                                                  owl:hasValue "High"
                                                ]
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :triggersAlertLevel ;
                                                  owl:hasValue "Low"
                                                ]
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :triggersAlertLevel ;
                                                  owl:hasValue "Medium"
                                                ]
                                              )
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :initiatesAlert ;
                                  owl:someValuesFrom :TheftEvent
                                ] ;
                rdfs:comment "Factors suggesting a potential of theft, linking them to relevant behavior states, environment, and health conditions." ;
                rdfs:label "TheftIndicator" .


###  https://github.com/tumelomodise/LFTDO#TheftOfLivestockProducts
:TheftOfLivestockProducts rdf:type owl:Class ;
                          rdfs:subClassOf :TheftEvent ;
                          rdfs:comment "The theft of livestock-derived products (e.g., milk, wool, meat)." ;
                          rdfs:label "TheftOfLivestockProducts" .


###  https://github.com/tumelomodise/LFTDO#UnauthorisedPerson
:UnauthorisedPerson rdf:type owl:Class ;
                    rdfs:subClassOf :Participant ;
                    rdfs:comment "UnauthorisedPerson: Represents individuals not permitted to access specific farm areas (also referred to as \"Unknown Person(s)\"). This class is essential for modeling security breaches and theft intent." ;
                    rdfs:label "UnauthorisedPerson" .


###  https://github.com/tumelomodise/LFTDO#UserDevice
:UserDevice rdf:type owl:Class ;
            rdfs:subClassOf :Device ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDeviceBatteryLife ;
                              owl:someValuesFrom xsd:decimal
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDeviceCapacity ;
                              owl:someValuesFrom xsd:decimal
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDeviceName ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDevicePrice ;
                              owl:someValuesFrom xsd:decimal
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDeviceSensorType ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDeviceSerialNumber ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDeviceType ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasManufacturerName ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasModulationFrequencyRange ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasModulationType ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasDeviceID ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:integer
                            ] ;
            rdfs:comment """1.User device is a Device not fitted into a livestock 
2.User devices are used by some Actors such as to track and monitor livestock, secure the Farm Location""" ;
            rdfs:label "UserDevice" .


###  https://github.com/tumelomodise/LFTDO#Veterinarian
:Veterinarian rdf:type owl:Class ;
              rdfs:subClassOf :Participant ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasContactNumber ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasParticipantName ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasParticipantRole ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasParticipantID ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ;
              rdfs:comment "The veterinarian understands the behavior of domestic animals and often treats the domestic animals for diseases." ;
              rdfs:label "Veterinarian" .


###  https://github.com/tumelomodise/LFTDO#VideoMonitoringSystem
:VideoMonitoringSystem rdf:type owl:Class ;
                       rdfs:subClassOf :DetectionMethod ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :analyses ;
                                         owl:someValuesFrom :Database
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :uses ;
                                         owl:someValuesFrom :Algorithm
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasDetectionMethodAccuracy ;
                                         owl:someValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasDetectionMethodType ;
                                         owl:someValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasFalsePositiveRate ;
                                         owl:someValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasMethodAttribute ;
                                         owl:someValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasTrainingData ;
                                         owl:someValuesFrom xsd:boolean
                                       ] ;
                       rdfs:comment "VideoMonitoringSystem is a theft DetectionMethod" ;
                       rdfs:label "VideoMonitoringSystem" .


###  https://github.com/tumelomodise/LFTDO#Wandering
:Wandering rdf:type owl:Class ;
           rdfs:subClassOf :Behaviour ;
           rdfs:comment "Wandering is a Behaviour." ;
           rdfs:label "Wandering" .


#################################################################
#    Individuals
#################################################################

###  https://github.com/tumelomodise/LFTDO#Algorithm001
:Algorithm001 rdf:type owl:NamedIndividual ,
                       :Algorithm ;
              :isUsedBy :TheftDetectionSystem ;
              owl:topDataProperty 0.98 ;
              :hasAlgorithmType "Machine Learning" ;
              :hasAlgorithmVersion "v0.1" ;
              :hasComplexity "HIGH" ;
              :isOptimized "true"^^xsd:boolean ;
              rdfs:comment "Algorithm001" ;
              rdfs:label "Algorithm001" .


###  https://github.com/tumelomodise/LFTDO#Algorithm002
:Algorithm002 rdf:type owl:NamedIndividual ,
                       :Algorithm ;
              :isUsedBy :GPSTrackingMethod ;
              :hasAlgorithmType "Moving Average" ;
              :hasAlgorithmVersion "v0.1" ;
              :hasComplexity "HIGH" ;
              :hasDetectionMethodAccuracy 0.98 ;
              :isOptimized "false"^^xsd:boolean ;
              rdfs:comment "Algorithm002" ;
              rdfs:label "Algorithm002" .


###  https://github.com/tumelomodise/LFTDO#Algorithm003
:Algorithm003 rdf:type owl:NamedIndividual ,
                       :Algorithm ;
              :isUsedBy :HealthDetectionMethod ;
              :hasAlgorithmType "Threshold-Based" ;
              :hasAlgorithmVersion "v0.1" ;
              :hasComplexity "HIGH" ;
              :hasDetectionMethodAccuracy 0.98 ;
              :isOptimized "true"^^xsd:boolean ;
              rdfs:comment "Algorithm003" ;
              rdfs:label "Algorithm003" .


###  https://github.com/tumelomodise/LFTDO#Algorithm004
:Algorithm004 rdf:type owl:NamedIndividual ,
                       :Algorithm ;
              :hasAlgorithmType "Spatial Geofencing" ;
              :hasAlgorithmVersion "v0.1" ;
              :hasComplexity "LOW" ;
              :hasDetectionMethodAccuracy 0.97 ;
              :isOptimized "true"^^xsd:boolean ;
              rdfs:comment "Algorithm004" ;
              rdfs:label "Algorithm004" .


