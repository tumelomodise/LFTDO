    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Validates normal activity if duration and speed stay within the sheep&apos;s  wandering baseline.</rdfs:comment>
        <rdfs:label>RL_NORMAL_MOVEMENT_BASELINE</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
