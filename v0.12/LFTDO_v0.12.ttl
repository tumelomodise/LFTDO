    LFTDO4:hasDeviceType "Digital Collar"^^xsd:string,
        "StandardGPSCollar"^^xsd:string ;
    LFTDO4:hasLatitude -25.8878 ;
    LFTDO4:hasLongitude 28.1608 ;
    LFTDO4:hasPowerStatus "On"^^xsd:string ;
    LFTDO4:isDeviceOnline true ;
    LFTDO4:isSuitableForRuralAreas true ;
    LFTDO4:transmitSensorDataTo LFTDO4:DataTransmission1 .

