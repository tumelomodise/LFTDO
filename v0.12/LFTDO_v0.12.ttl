LFTDO4:StatusUpdateEvent a owl:Class ;
    rdfs:label "StatusUpdateEvent" ;
    rdfs:comment "Classified the state change event." ;
    rdfs:subClassOf LFTDO4:SystemEvent .

LFTDO4:SensorData a owl:Class ;
    rdfs:label "SensorData" ;
    rdfs:comment "SensorData: Represents data collected from device sensors attached to the livestock and environment, providing various behaviour states." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:isGeneratedByDevice ;
            owl:someValuesFrom LFTDO4:Device ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:representsDataType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSensorTimeStamp ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSensorDataValue ;
            owl:someValuesFrom xsd:decimal ] .

LFTDO4:Device a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment """Device are different types of devices used in livestock farming for various reasons such as “autonomous real-time interaction” and collecting and exchanging of data between devices and software applications, this device includes sensors, end devices such as Radio Frequencies Identification(RFID), ear tags, collars, and end-user devices such as smartphones, communication gateways such as LoRagateway from different manufactures (Symeonaki et al., 2020). The devices are connected to the cloud for remote access.

Devices:
1.A Communication Gateway is a Device not fitted into a livestock and is connected to the internet(Cloud Computing Services)
2.End device is device attached to a livestock fitted with sensors 
3.Sensor is a Device that detect the changes on livestock and the environment
4.User device is a Device not fitted into a livestock 

Relationships:
1.A device is connected to one or more Cloud Computing Services
2.Some end device has some sensor
3.User devices are used by some Actors to track and monitor livestock""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSensorType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasPowerStatus ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty LFTDO4:hasDeviceID ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSerialNumber ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceCapacity ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceBatteryLife ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationFrequencyRange ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasManufacturerName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDevicePrice ;
            owl:someValuesFrom xsd:decimal ] .

