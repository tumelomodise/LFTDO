###  https://github.com/tumelomodise/LFTDO#Livestock
:Livestock rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :exhibits ;
                             owl:someValuesFrom :Behaviour
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :experiences ;
                             owl:someValuesFrom :HealthCondition
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasCurrentLocation ;
                             owl:someValuesFrom :Location
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :healthConfirmedBy ;
                             owl:someValuesFrom :Participant
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isAttachedToDevice ;
                             owl:someValuesFrom :EndDevice
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isLocatedAtFarm ;
                             owl:someValuesFrom :Farm
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isOwnedByFarmer ;
                             owl:someValuesFrom :Farmer
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasAge ;
                             owl:someValuesFrom xsd:integer
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasBodyTemperature ;
                             owl:someValuesFrom xsd:integer
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasBreed ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasGender ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasGroupSize ;
                             owl:someValuesFrom xsd:integer
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasRunningDuration ;
                             owl:someValuesFrom xsd:decimal
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasSittingDuration ;
                             owl:someValuesFrom xsd:decimal
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasSleepingDuration ;
                             owl:someValuesFrom xsd:integer
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasSpecies ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTagMark ;
                             owl:someValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasWeightInKg ;
                             owl:someValuesFrom xsd:decimal
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isOutsideGeofence ;
                             owl:someValuesFrom xsd:boolean
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isPregnant ;
                             owl:someValuesFrom xsd:boolean
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isSuspectedOfTheft ;
                             owl:someValuesFrom xsd:boolean
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasAnimalID ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ;
           owl:disjointWith :Participant ;
           rdfs:comment """Livestock are domestic animals such as cattle, sheep, and goats for labor, and the production of commodities for humans such as meat, milk, wool, and leather (Britannica, 2020).

Relationships:
1.Livestock is fitted with some end device for tracking and monitoring.
2.Livestock has some body condition score.
3.Livestock exhibit some Behaviour 
4.Livestock is located at some Farm Location""" ;
           rdfs:label "Livestock" .


###  https://github.com/tumelomodise/LFTDO#LivestockEvent
:LivestockEvent rdf:type owl:Class ;
                rdfs:comment "LivestockEvent  is the \"Outcome\" or \"Alert\" of the Livestock Indicators." ;
                rdfs:label "LivestockEvent" .


###  https://github.com/tumelomodise/LFTDO#LivestockIndicator
:LivestockIndicator rdf:type owl:Class ;
                    rdfs:comment "LivestockIndicators satisfy the necessary and sufficient conditions to infer a different high-level LivestockEvent (e.g., TheftEvent), providing a clear audit trail from raw data to actionable alert." ;
                    rdfs:label "LivestockIndicator" .


###  https://github.com/tumelomodise/LFTDO#Location
:Location rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLatitude ;
                            owl:someValuesFrom xsd:decimal
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLocationDescription ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLocationName ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLocationType ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLongitude ;
                            owl:someValuesFrom xsd:decimal
                          ] ;
          rdfs:comment """Locations are farmer area where the livestock are being kept is referred to as a Farm.It can be at an urban, rural, or semi-urban location, and may have pen and open fields that are fenced or unfenced. 

The position of livestock within a farm location is constrained to date and time, and their behavior influences their movement. The livestock position within a location may be indicated with coordinates such as longitude and latitude, which are used to precisely determine the location of livestock within a farm area, as discussed by  (Symeonaki et al., 2020).

Relationships:
1.Location (e.g., a farm) has a specific time period(startTime and endTime) during which certain events or activities occurs.
2.Location (e.g., a farm) has a specific geographical position defined by latitude and longitude coordinates.""" ;
          rdfs:label "Location" .


###  https://github.com/tumelomodise/LFTDO#ModerateAmbientTemperature
:ModerateAmbientTemperature rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( :AmbientTemperature
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasEnvValue ;
                                                                         owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                              owl:onDatatype xsd:decimal ;
                                                                                              owl:withRestrictions ( [ xsd:minInclusive 19
                                                                                                                     ]
                                                                                                                     [ xsd:maxInclusive 34.9
                                                                                                                     ]
                                                                                                                   )
                                                                                            ]
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasTemporalContext ;
                                                                         owl:hasValue "DayTime"
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:comment "Moderate Ambient Temperature range that applies to many populated areas might be considered:Daytime: Around 20 °C to  34.9 °C." ;
                            rdfs:label "ModerateAmbientTemperature" .


###  https://github.com/tumelomodise/LFTDO#Movement
:Movement rdf:type owl:Class ;
          rdfs:subClassOf :Behaviour ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :exhibitedBy ;
                            owl:someValuesFrom :Livestock
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasCurrentBehaviourState ;
                            owl:someValuesFrom :BehaviourState
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBehaviourStartTime ;
                            owl:someValuesFrom xsd:dateTime
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIntensity ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment """Referenced Ontology:
1.Movement is a behaviour
3.Different behaviour states may be observed based  on Movement rate, distance covered and  Geopositions.
Reference:
Movement = Member movement (ATOL:000842) (Meunier-Salaün et. al,2015)
Under Behavior trait->Motor activity->body movement->member movement behavior.""" ;
          rdfs:label "Movement" .


