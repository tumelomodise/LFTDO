:hasBehaviourStateBaselineValues rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf owl:topDataProperty ;
                                 rdfs:domain :NormalState ;
                                 rdfs:range xsd:decimal ;
                                 rdfs:comment "NormalState has some BaselineValue" ;
                                 rdfs:label "hasBehaviourBaselineValues" .


###  https://github.com/tumelomodise/LFTDO#hasBehaviourStateConfidenceScore
:hasBehaviourStateConfidenceScore rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf owl:topDataProperty ;
                                  rdfs:domain :BehaviourState ;
                                  rdfs:range xsd:integer ;
                                  rdfs:comment "BehaviourState has some ConfidenceScore" ;
                                  rdfs:label "hasBehaviourStateConfidenceScore" .


###  https://github.com/tumelomodise/LFTDO#hasBehaviourStateContext
:hasBehaviourStateContext rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain :BehaviourState ;
                          rdfs:range xsd:string ;
                          rdfs:comment "BehaviourState has some Context" ;
                          rdfs:label "hasBehaviourStateContext" .


###  https://github.com/tumelomodise/LFTDO#hasBehaviourStateDescription
:hasBehaviourStateDescription rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf owl:topDataProperty ;
                              rdfs:domain :BehaviourState ;
                              rdfs:range xsd:string ;
                              rdfs:comment "BehaviourState has some Description" ;
                              rdfs:label "hasBehaviourStateDescription" .


###  https://github.com/tumelomodise/LFTDO#hasBehaviourStateDeviation
:hasBehaviourStateDeviation rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf owl:topDataProperty ;
                            rdfs:domain :NormalState ;
                            rdfs:range xsd:decimal ;
                            rdfs:comment "Normal BehaviourState has some DeviationThresholdIn%" ;
                            rdfs:label "hasBehaviourStateDeviation" .


###  https://github.com/tumelomodise/LFTDO#hasBirthDate
:hasBirthDate rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :Livestock ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "Livestock has some birthdate." ;
              rdfs:label "hasBirthDate" .


###  https://github.com/tumelomodise/LFTDO#hasBodyTemperature
:hasBodyTemperature rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Livestock ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "Livestock has some Body Tempareture" ;
                    rdfs:label "hasBodyTemperature" .


###  https://github.com/tumelomodise/LFTDO#hasBreed
:hasBreed rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :Livestock ;
          rdfs:range xsd:string ;
          rdfs:comment "Livestock has some Breed" ;
          rdfs:label "hasBreed" .


###  https://github.com/tumelomodise/LFTDO#hasCattleBodyConditionScore
:hasCattleBodyConditionScore rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf owl:topDataProperty ;
                             rdfs:domain :Livestock ;
                             rdfs:range xsd:integer ;
                             rdfs:comment "Livestock(Cattle) has some CattleBodyConditionScore" ;
                             rdfs:label "hasCattleBodyConditionScore" .


###  https://github.com/tumelomodise/LFTDO#hasCity
:hasCity rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdfs:domain :Location ;
         rdfs:range xsd:string ;
         rdfs:comment "Location has a City" ;
         rdfs:label "hasCity" .


###  https://github.com/tumelomodise/LFTDO#hasCloudSecurityFeatures
:hasCloudSecurityFeatures rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain :CloudService ;
                          rdfs:range xsd:string ;
                          rdfs:comment "CloudService has some Features" ;
                          rdfs:label "hasCloudSecurityFeatures" .


###  https://github.com/tumelomodise/LFTDO#hasCloudServiceCost
:hasCloudServiceCost rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :CloudService ;
                     rdfs:range xsd:decimal ;
