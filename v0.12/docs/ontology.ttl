:isAdjacentTo rdf:type owl:ObjectProperty ;
              rdfs:range :Location ;
              rdfs:comment "A Point of Reference a location may be next to or adjacent to." ;
              rdfs:label "isAdjacentTo" .


###  https://github.com/tumelomodise/LFTDO#isAffectedBy
:isAffectedBy rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Device
                                          :Livestock
                                          :Location
                                        )
                          ] ;
              rdfs:comment "Livestock or Location or Device isAffectedBy LivestockEvent" ;
              rdfs:label "isAffectedBy" .


###  https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy
:isAlertInitiatedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain :LivestockEvent ;
                    rdfs:range :LivestockIndicator ;
                    rdfs:comment "HighTheftEvent is isInitiated by some TheftIndicator a logical cause (the data anomaly)" ;
                    rdfs:label "isAlertInitiatedBy" .


###  https://github.com/tumelomodise/LFTDO#isAnalysedBy
:isAnalysedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :Database ;
              rdfs:range :DetectionMethod ;
              rdfs:comment "Database is analysed by some DetectionMethod" ;
              rdfs:label "isAnalysedBy" .


###  https://github.com/tumelomodise/LFTDO#isAttachedTo
:isAttachedTo rdf:type owl:ObjectProperty ;
              owl:inverseOf :isAttachedToDevice ;
              rdfs:domain :EndDevice ;
              rdfs:range :Livestock ;
              rdfs:comment "Device(EndDevice) is attached to some Livestock" ;
              rdfs:label "isAttachedToLivestock" .


###  https://github.com/tumelomodise/LFTDO#isAttachedToDevice
:isAttachedToDevice rdf:type owl:ObjectProperty ;
                    rdfs:domain :Livestock ;
                    rdfs:range :EndDevice ;
                    rdfs:comment "Livestock is attached to some Device(EndDevice)" ;
                    rdfs:label "isAttachedToDevice" .


###  https://github.com/tumelomodise/LFTDO#isBiologicallyAffectedBy
:isBiologicallyAffectedBy rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain :Livestock ;
                          rdfs:range :HealthCondition ;
                          rdfs:comment "Livestock isBiologicallyAffectedBy HealthCondition" ;
                          rdfs:label "isBiologicallyAffectedBy" .


###  https://github.com/tumelomodise/LFTDO#isCharacterisedBy
:isCharacterisedBy rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :BehaviourState
                                               :EnvironmentalCondition
                                               :HealthCondition
                                             )
                               ] ;
                   rdfs:range :LivestockIndicator ;
                   rdfs:comment "AbnormalState isCharacterisedBy TheftIndicator" ;
                   rdfs:label "isCharacterisedBy" .


###  https://github.com/tumelomodise/LFTDO#isComponentOf
:isComponentOf rdf:type owl:ObjectProperty ;
               rdfs:range :RestrictedArea ;
               rdfs:label "Represents the components of securedGuarded RestrictedArea Location" ,
                          "isComponentOf" .


###  https://github.com/tumelomodise/LFTDO#isContextOf
:isContextOf rdf:type owl:ObjectProperty ;
             rdfs:domain :EnvironmentalCondition ;
             rdfs:range :BehaviourState ;
             rdfs:comment """EnvironmentalCondition is context of some BehaviourState

isContextOf (Passive/Spatio-Temporal): This simply means the behavior and the environment happened at the same time and place.
Example: \"The sheep is grazing while it is raining.\"""" ;
             rdfs:label "isContextOf" .


###  https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf
:isCurrentBehaviourStateOf rdf:type owl:ObjectProperty ;
                           rdfs:domain :BehaviourState ;
                           rdfs:range :Behaviour ;
                           rdfs:comment "BehaviourState is related to some Behaviour" ;
                           rdfs:label "isCurrentBehaviourStateOf" .


###  https://github.com/tumelomodise/LFTDO#isCurrentLocationOf
:isCurrentLocationOf rdf:type owl:ObjectProperty ;
                     rdfs:comment "Inverse of hasCurrentLocation to tell which Livestock occupy the location at any point in time." ;
                     rdfs:label "isCurrentLocationOf" .


###  https://github.com/tumelomodise/LFTDO#isCurrentStatusOf
:isCurrentStatusOf rdf:type owl:ObjectProperty ;
                   rdfs:domain :StatusUpdateEvent ;
                   rdfs:range :Livestock ;
                   rdfs:label "isCurrentStatusOf" .


###  https://github.com/tumelomodise/LFTDO#isDeployedOn
:isDeployedOn rdf:type owl:ObjectProperty ;
              rdfs:domain :SoftwareApplication ;
              rdfs:range :CloudService ;
              rdfs:comment "SoftwareApplication is deployed on some cloudservice." ;
              rdfs:label "isDeployedOn" .


###  https://github.com/tumelomodise/LFTDO#isDetectedBy
:isDetectedBy rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :LivestockIndicator
                                          :SystemEvent
                                        )
                          ] ;
              rdfs:range :DetectionMethod ;
              rdfs:comment "System or Livestock Event is detected by some DetectionMethod" ;
              rdfs:label "isDetectedBy" .


###  https://github.com/tumelomodise/LFTDO#isExperiencedBy
:isExperiencedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :HealthCondition ;
                 rdfs:range :Livestock ;
                 rdfs:comment "HealthCondition isExperiencedBy Livestock" ;
                 rdfs:label "isExperiencedBy" .


###  https://github.com/tumelomodise/LFTDO#isExternallyAffectedBy
:isExternallyAffectedBy rdf:type owl:ObjectProperty ;
                        rdfs:domain :Livestock ;
                        rdfs:range :EnvironmentalCondition ;
                        rdfs:comment "Livestock isExternallyAffectedBy EnvironmentalCondition" ;
                        rdfs:label "isExternallyAffectedBy" .


###  https://github.com/tumelomodise/LFTDO#isExtractedFrom
:isExtractedFrom rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isExtractedTo ;
                 rdfs:domain :LivestockIndicator ;
                 rdfs:range :SensorData ;
                 rdfs:comment "LivestockIndicator isExtractedFom some SensorData" ;
                 rdfs:label "isExtractedFrom" .


###  https://github.com/tumelomodise/LFTDO#isExtractedTo
:isExtractedTo rdf:type owl:ObjectProperty ;
               rdfs:domain :SensorData ;
               rdfs:range :LivestockIndicator ;
               rdfs:comment "SensorData isExtractedTo some LivestockIndicator" ;
               rdfs:label "isExtractedTo" .


###  https://github.com/tumelomodise/LFTDO#isGeneratedByDevice
:isGeneratedByDevice rdf:type owl:ObjectProperty ;
                     rdfs:domain :SensorData ;
                     rdfs:range :Device ;
                     rdfs:comment "SensorData isGeneratedBy of some Device" ;
                     rdfs:label "isGeneratedByDevice" .


###  https://github.com/tumelomodise/LFTDO#isIdentifiedBy
:isIdentifiedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :BehaviourState ;
                rdfs:range :DetectionMethod ;
                rdfs:comment "BehaviourState is isIdentifiedBy Detection Method." ;
                rdfs:label "isIdentifiedBy" .


###  https://github.com/tumelomodise/LFTDO#isImplementedBy
:isImplementedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :DetectionMethod ;
                 rdfs:range :SoftwareApplication ;
                 rdfs:comment """DetectionMethod isImplementedBy SoftwareApplication.

Usually, a specific logical Method (the \"Theft Logic\") is implemented by one specific Software Application. While there could be two apps doing the same thing, it’s rarely efficient in IoT.""" ;
                 rdfs:label "isImplementedBy" .


###  https://github.com/tumelomodise/LFTDO#isIndicatorOf
:isIndicatorOf rdf:type owl:ObjectProperty ;
               rdfs:domain :LivestockIndicator ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :Device
                                          :Livestock
                                        )
                          ] ;
               rdfs:label "Device can have some IndicatorOf of TheftIndicator" ,
                          "isIndicatorOf" .


###  https://github.com/tumelomodise/LFTDO#isInfluencedBy
:isInfluencedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :BehaviourState ;
                rdfs:range :EnvironmentalCondition ;
                rdfs:comment """BehaviourState is influenced by some EnvironmentalConditions

isInfluencedBy (Active/Causal): This means the environment is changing the behavior.
Example: \"The sheep stopped grazing because the rain became a heavy storm.\"""" ;
                rdfs:label "isInfluencedBy" .


###  https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition
:isInfluencedByHealthCondition rdf:type owl:ObjectProperty ;
                               rdfs:domain :BehaviourState ;
                               rdfs:range :HealthCondition ;
                               rdfs:comment "BehaviourState is influencedBy some HealthCondition" ;
                               rdfs:label "isInfluencedByHealthCondition" .


###  https://github.com/tumelomodise/LFTDO#isLocatedAtFarm
:isLocatedAtFarm rdf:type owl:ObjectProperty ;
                 rdfs:domain :Livestock ;
                 rdfs:range :Farm ;
                 rdfs:comment "Livestock is located at a Farm" ;
                 rdfs:label "isLocatedAtFarm" .


###  https://github.com/tumelomodise/LFTDO#isLocationOfIncident
:isLocationOfIncident rdf:type owl:ObjectProperty ;
                      rdfs:domain :Location ;
                      rdfs:range :LivestockEvent ;
                      rdfs:comment "Location isLocationOf some LivestockEvent" ;
                      rdfs:label "isLocationOfIncident" .


###  https://github.com/tumelomodise/LFTDO#isManagedBy
:isManagedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Livestock ;
             rdfs:range :ExtendedOfficer ;
             rdfs:comment "Livestock is managed by some ExtendedOfficer" ;
             rdfs:label "isManagedBy" .


###  https://github.com/tumelomodise/LFTDO#isMonitoredByDevice
:isMonitoredByDevice rdf:type owl:ObjectProperty ;
                     rdfs:domain :Farm ;
                     rdfs:range :Device ;
                     rdfs:comment "Farm is managed by some Device" ;
                     rdfs:label "isMonitoredByDevice" .


###  https://github.com/tumelomodise/LFTDO#isNearBoundary
:isNearBoundary rdf:type owl:ObjectProperty ;
                rdfs:domain :Livestock ;
                rdfs:range :Boundary ;
                rdfs:comment "Represent a spatial relationship between an entity (like a Livestock) and a specific Boundary instance." ;
                rdfs:label "isNearBoundary" .


###  https://github.com/tumelomodise/LFTDO#isNotifiedBySoftwareApp
:isNotifiedBySoftwareApp rdf:type owl:ObjectProperty ;
                         owl:inverseOf :notifies ;
                         rdfs:domain :Participant ;
                         rdfs:range :SoftwareApplication ;
                         rdfs:comment "Participant(Farmer) is notified by some SoftwareApplication" ;
                         rdfs:label "isNotifiedBySoftwareApp" .


###  https://github.com/tumelomodise/LFTDO#isOwnedByFarmer
:isOwnedByFarmer rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isOwnerOfLivestock ;
                 rdfs:domain :Livestock ;
                 rdfs:range :Farmer ;
                 rdfs:comment "Livestock is Owned by some Farmer." ;
                 rdfs:label "isOwnedByFarmer" .


###  https://github.com/tumelomodise/LFTDO#isOwnerOfLivestock
:isOwnerOfLivestock rdf:type owl:ObjectProperty ;
                    rdfs:domain :Farmer ;
                    rdfs:range :Livestock ;
                    rdfs:comment "Farmer is an owner of some Livestock." ;
                    rdfs:label "isOwnerOfLivestock" .


###  https://github.com/tumelomodise/LFTDO#isPartOfLocation
:isPartOfLocation rdf:type owl:ObjectProperty ;
                  rdfs:comment "isPartOfLocation is used to ensure the LFTDO can accurately pinpoint anomalies, locations are modeled using a hierarchical \"Part-Whole\" relationship. This allows for spatial containment reasoning, where sub-locations (e.g., Kraal001) are logically nested within the parent Farm001." ;
                  rdfs:label "isPartOfLocation" .


###  https://github.com/tumelomodise/LFTDO#isRecordedIn
:isRecordedIn rdf:type owl:ObjectProperty ;
              owl:inverseOf :recordsEvent ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :LivestockEvent
                                          :RoutineLogEvent
                                          :SensorData
                                        )
                          ] ;
              rdfs:range :Database ;
              rdfs:label "RoutineLogEvent is recorded in the Database" ,
                         "isRecordedIn" .


###  https://github.com/tumelomodise/LFTDO#isSecurelyGuarded
:isSecurelyGuarded rdf:type owl:ObjectProperty ;
                   rdfs:domain :Location ;
                   rdfs:range :EndDevice ;
                   rdfs:comment "This an RestrictedArea or Location that is securely guarded by the EndDevices" ;
                   rdfs:label "isSecurelyGuarded" .


###  https://github.com/tumelomodise/LFTDO#isSensorOf
:isSensorOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Sensor ;
            rdfs:range :Device ;
            rdfs:label "Sensor isSensorOf some Device" ,
                       "isSensorOf" .


###  https://github.com/tumelomodise/LFTDO#isStoredIn
:isStoredIn rdf:type owl:ObjectProperty ;
            owl:inverseOf :storeData ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :RoutineLogEvent
                                        :SensorData
                                        :StatusUpdateEvent
                                      )
                        ] ;
            rdfs:range :Database ;
            rdfs:comment "This ensures the reasoner knows that log events are meant for storage, keeping the communication channel (the SoftwareApplication) clear of \"noise\"." ;
            rdfs:label "isStoredIn" .


###  https://github.com/tumelomodise/LFTDO#isStoredOn
:isStoredOn rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :Database ;
            rdfs:range :CloudService ;
            rdfs:comment "Database is stored on some cloudservice" ;
            rdfs:label "isStoredOn" .


###  https://github.com/tumelomodise/LFTDO#isSupportedBy
:isSupportedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :LivestockEvent ;
               rdfs:range :LivestockIndicator ;
               rdfs:comment "LivestockEvent is supportedby some LivestockIndicator" ;
               rdfs:label "isSupportedBy" .


###  https://github.com/tumelomodise/LFTDO#isTransitionedFrom
:isTransitionedFrom rdf:type owl:ObjectProperty ;
                    owl:inverseOf :transitionsTo ;
                    rdfs:domain :AbnormalState ;
                    rdfs:range :NormalState ;
                    rdfs:comment "AbnormalBehaviour State is transitionedFrom some Normal Behaviour State" ;
                    rdfs:label "isTransitionedFrom" .


###  https://github.com/tumelomodise/LFTDO#isTriggeredBy
:isTriggeredBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :triggers ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :LivestockEvent
                                           :SystemEvent
                                         )
                           ] ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :BehaviourState
                                          :DetectionMethod
                                          :LivestockIndicator
                                        )
                          ] ;
               rdfs:comment """Event(s) such as SystemEvent or LivestockEvent or LivestockIndicator are triggered by BehaviourState. 

A LivestockEvent is usually triggered by exactly one method. However, a SystemEvent (like a \"System Overload\") might be triggered by many detection methods running at once. An event could also have zero detection methods if it was triggered manually by a human (Farmer).""" ;
               rdfs:label "isTriggeredBy" .


###  https://github.com/tumelomodise/LFTDO#isUsedBy
:isUsedBy rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          owl:inverseOf :uses ;
          rdfs:domain :Algorithm ;
          rdfs:range :DetectionMethod ;
          rdfs:comment "Algorithm is used by some DetectionMethod" ;
          rdfs:label "isUsedBy" .


###  https://github.com/tumelomodise/LFTDO#isUsedByFarmer
:isUsedByFarmer rdf:type owl:ObjectProperty ;
                owl:inverseOf :usesFarm ;
                rdfs:domain :Farm ;
                rdfs:range :Farmer ;
                rdfs:comment "A Farm is used by some Farmer for some Livestock keeping." ;
                rdfs:label "isUsedByFarmer" .


###  https://github.com/tumelomodise/LFTDO#isValidatedBy
:isValidatedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :validateStatusOfEvent ;
               rdfs:domain :StatusUpdateEvent ;
               rdfs:range :Participant ;
               rdfs:comment "LivestockEvent isValidatedBy Farmer." ;
               rdfs:label "isValidatedBy" .


###  https://github.com/tumelomodise/LFTDO#logGeneratedBy
:logGeneratedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :RoutineLogEvent ;
                rdfs:range :SoftwareApplication ;
                rdfs:comment "RoutineLogEvent isGeneratedBy some Software" ;
                rdfs:label "logGeneratedBy" .


###  https://github.com/tumelomodise/LFTDO#notifies
:notifies rdf:type owl:ObjectProperty ;
          rdfs:domain :SoftwareApplication ;
          rdfs:range :Participant ;
          rdfs:comment "Software Application notify some Participant" ;
          rdfs:label "notifies" .


###  https://github.com/tumelomodise/LFTDO#overridesStatus
:overridesStatus rdf:type owl:ObjectProperty ;
                 rdfs:comment """Participant can override status provided by the System.
Allows the farmer to explicitly cancel the AI's choice.""" ;
                 rdfs:label "overridesStatus" .


###  https://github.com/tumelomodise/LFTDO#produces
:produces rdf:type owl:ObjectProperty ;
          rdfs:domain :DetectionMethod ;
          rdfs:range :SystemEvent ;
          rdfs:comment "DetectionMethod produces some System Event" ;
          rdfs:label "produces" .


###  https://github.com/tumelomodise/LFTDO#receivesDataFrom
:receivesDataFrom rdf:type owl:ObjectProperty ;
                  rdfs:domain :CloudService ;
                  rdfs:range :DataTransmission ;
                  rdfs:comment "CloudService receive data from some Data Transmission" ;
                  rdfs:label "receivesDataFrom" .


###  https://github.com/tumelomodise/LFTDO#recordsEvent
:recordsEvent rdf:type owl:ObjectProperty ;
              rdfs:domain :Database ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :LivestockEvent
                                         :SensorData
                                         :SystemEvent
                                       )
                         ] ;
              rdfs:comment """LivestockIndicator or Software Application records some RoutineLogEvent in the Database.
The software writes to the log.""" ;
              rdfs:label "records" .


###  https://github.com/tumelomodise/LFTDO#statusInitiatedBy
:statusInitiatedBy rdf:type owl:ObjectProperty ;
                   rdfs:domain :StatusUpdateEvent ;
                   rdfs:range :BehaviourState ;
                   rdfs:comment "StatusUpdateEvent is initiated by some SoftwareApplication" ;
                   rdfs:label "statusUpdateInitiatedBy" .


###  https://github.com/tumelomodise/LFTDO#storeData
:storeData rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :Database ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :RoutineLogEvent
                                      :SensorData
                                      :StatusUpdateEvent
                                    )
                      ] ;
           rdfs:comment "Database stores some Data from Sensors, SystemLogs .e.t.c." ;
           rdfs:label "storeData" .


###  https://github.com/tumelomodise/LFTDO#transitionsTo
:transitionsTo rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :NormalState ;
               rdfs:range :AbnormalState ;
               rdfs:comment "NormalState get transitioned to AbnormalState" ;
               rdfs:label "transitionsTo" .


###  https://github.com/tumelomodise/LFTDO#transmitSensorDataTo
:transmitSensorDataTo rdf:type owl:ObjectProperty ;
                      owl:inverseOf :transmittedSensorDataFrom ;
                      rdfs:domain :Device ;
                      rdfs:range :DataTransmission ;
                      rdfs:comment "Device(EndDevice) transmit some SensorDataTo a DataTransmission" ;
                      rdfs:label "transmitSensorDataTo" .


###  https://github.com/tumelomodise/LFTDO#transmittedSensorDataFrom
:transmittedSensorDataFrom rdf:type owl:ObjectProperty ;
                           rdfs:label "transmittedSensorDataFrom" .


###  https://github.com/tumelomodise/LFTDO#triggers
:triggers rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :BehaviourState
                                      :DetectionMethod
                                      :LivestockIndicator
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :LivestockEvent
                                     :SystemEvent
                                   )
                     ] ;
          rdfs:comment """BehaviourState or DetectionMethod triggers some Event(Livestock or System Event)

A DetectionMethod (like TheftDetection) may trigger zero events if everything is normal. However, if a theft is detected, it might trigger many events simultaneously (e.g., a TheftEvent for the farmer and a StatusUpdateEvent for the system log).""" ;
          rdfs:label "triggers" .


###  https://github.com/tumelomodise/LFTDO#uiUpdatedBy
:uiUpdatedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :updatesUI ;
             rdfs:domain :SoftwareApplication ;
             rdfs:range :StatusUpdateEvent ;
             rdfs:label "SoftwareApplication's UI is updated by StatusUpdateEvent" ,
                        "uiUpdatedBy" .


###  https://github.com/tumelomodise/LFTDO#updatesUI
:updatesUI rdf:type owl:ObjectProperty ;
           rdfs:domain :StatusUpdateEvent ;
           rdfs:range :SoftwareApplication ;
           rdfs:comment "StatusUpdateEvent updates some SoftwareApplication's UserInterface" ;
           rdfs:label "updatesUI" .


###  https://github.com/tumelomodise/LFTDO#useDatabaseData
:useDatabaseData rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:domain :Algorithm ;
                 rdfs:range :Database ;
                 rdfs:comment "Machine Learning Algorithms uses some SensorData stored in the Database to analyse and make predictions." ;
                 rdfs:label "useDatabaseData" .


###  https://github.com/tumelomodise/LFTDO#uses
:uses rdf:type owl:ObjectProperty ;
      rdfs:domain [ rdf:type owl:Class ;
                    owl:unionOf ( :DetectionMethod
                                  :SoftwareApplication
                                )
                  ] ;
      rdfs:range :Algorithm ;
      rdfs:comment """TheftDetectionMethod uses some Algorithm
The software runs the code.""" ;
      rdfs:label "uses" .


###  https://github.com/tumelomodise/LFTDO#usesFarm
:usesFarm rdf:type owl:ObjectProperty ;
          rdfs:domain :Farmer ;
          rdfs:range :Farm ;
          rdfs:comment "Farmer uses some Farm" ;
          rdfs:label "usesFarm" .


###  https://github.com/tumelomodise/LFTDO#validateStatusOfEvent
:validateStatusOfEvent rdf:type owl:ObjectProperty ;
                       rdfs:domain :Participant ;
                       rdfs:range :StatusUpdateEvent ;
                       rdfs:comment "Farmer updates the status of some TheftEvent" ;
                       rdfs:label "validateStatusOfEvent" .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/2002/07/owl#topDataProperty
owl:topDataProperty rdfs:label "topDataProperty" .


###  https://github.com/tumelomodise/LFTDO#cloudServiceName
:cloudServiceName rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :CloudService ;
                  rdfs:range xsd:string ;
                  rdfs:comment "CloudService has a Name" ;
                  rdfs:label "cloudServiceName" .


###  https://github.com/tumelomodise/LFTDO#hasAge
:hasAge rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :Livestock ;
        rdfs:range xsd:integer ;
        rdfs:comment "Livestock has some Age" ;
        rdfs:label "hasAge" .


###  https://github.com/tumelomodise/LFTDO#hasAlgorithmName
:hasAlgorithmName rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Any instance like Software, Database, Algorithm and has some name" ;
                  rdfs:label "hasName" .


###  https://github.com/tumelomodise/LFTDO#hasAlgorithmType
:hasAlgorithmType rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Algorithm ;
                  rdfs:range xsd:string ;
                  rdfs:comment "hasAlgorithmType like e.g., Machine Learning or Threshold-based or Moving Average)." ;
                  rdfs:label "hasAlgorithmType" .


###  https://github.com/tumelomodise/LFTDO#hasAlgorithmVersion
:hasAlgorithmVersion rdf:type owl:DatatypeProperty ;
                     rdfs:label "hasAlgorithmVersion" .


###  https://github.com/tumelomodise/LFTDO#hasAnimalID
:hasAnimalID rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Livestock ;
             rdfs:range xsd:string ;
             rdfs:comment "Livestock has Animal ID" ;
             rdfs:label "hasAnimalID" .


###  https://github.com/tumelomodise/LFTDO#hasBaseLineHeadingDirection
:hasBaseLineHeadingDirection rdf:type owl:DatatypeProperty ;
                             rdfs:domain :NormalState ;
                             rdfs:range xsd:decimal ;
                             rdfs:comment "Baseline Heading direction to check if Livestock is moving away from define GeoLocation for to justify if its almost due East (90°), moving directly away from the farm center." ;
                             rdfs:label "hasBaseLineHeadingDirection" .


###  https://github.com/tumelomodise/LFTDO#hasBaseLineHeadingDirectionUoM
:hasBaseLineHeadingDirectionUoM rdf:type owl:DatatypeProperty ;
                                rdfs:domain :NormalState ;
                                rdfs:range xsd:string ;
                                rdfs:comment "baseLineHeadingDirectionUoM" ;
                                rdfs:label "hasBaseLineHeadingDirectionUoM" .


###  https://github.com/tumelomodise/LFTDO#hasBaseLineSignalStrength
:hasBaseLineSignalStrength rdf:type owl:DatatypeProperty ;
                           rdfs:domain :NormalState ;
                           rdfs:range xsd:decimal ;
                           rdfs:comment "Signal Strength inidcaites the normal baseline for received signal strength indicator(RSSI) for e.g. a very weak RSSI, indicates the collar is nearing the edge of the network range." ;
                           rdfs:label "hasBaseLineSignalStrength" .


###  https://github.com/tumelomodise/LFTDO#hasBaseLineSignalStrengthUoM
:hasBaseLineSignalStrengthUoM rdf:type owl:DatatypeProperty ;
                              rdfs:domain :NormalState ;
                              rdfs:range xsd:string ;
                              rdfs:comment "Measured in dBm (decibels-milliwatts)" ;
                              rdfs:label "hasBaseLineSignalStrengthUoM" .


###  https://github.com/tumelomodise/LFTDO#hasBaseLineTemp
:hasBaseLineTemp rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:decimal ;
                 rdfs:label "hasBaseLineTemp" .


###  https://github.com/tumelomodise/LFTDO#hasBaseLineTempUoM
:hasBaseLineTempUoM rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:string ;
                    rdfs:label "hasBaseLineTempUoM" .


###  https://github.com/tumelomodise/LFTDO#hasBaseLineType
:hasBaseLineType rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:label "hasBaseLineType" .


###  https://github.com/tumelomodise/LFTDO#hasBaselinePosture
:hasBaselinePosture rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "Defines \"Horizontal\" as the required state for resting." ;
                    rdfs:label "hasBaselinePosture" .


###  https://github.com/tumelomodise/LFTDO#hasBaselinePostureUoM
:hasBaselinePostureUoM rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Ensures the unit matches the Gyroscope output." ;
                       rdfs:label "hasBaselinePostureUoM" .


###  https://github.com/tumelomodise/LFTDO#hasBaselineStepCount
:hasBaselineStepCount rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Defines \"Stationary\" as the required activity level." ;
                      rdfs:label "hasBaselineStepCount" .


###  https://github.com/tumelomodise/LFTDO#hasBaselineStepCountUoM
:hasBaselineStepCountUoM rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Ensures the unit matches the Pedometer output." ;
                         rdfs:label "hasBaselineStepCountUoM" .


###  https://github.com/tumelomodise/LFTDO#hasBehaviourEndTime
:hasBehaviourEndTime rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :Behaviour ;
                     rdfs:range xsd:dateTime ;
                     rdfs:comment "Behaviour has EndTime" ;
                     rdfs:label "hasBehaviourEndTime" .


###  https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime
:hasBehaviourStartTime rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:domain :Behaviour ;
                       rdfs:range xsd:dateTime ;
                       rdfs:comment "Behaviour has Start Time" ;
                       rdfs:label "hasBehaviourStartTime" .


