                        rdfs:label "NormalGrazingIndicator" .


###  https://github.com/tumelomodise/LFTDO#NormalState
:NormalState rdf:type owl:Class ;
             rdfs:subClassOf :BehaviourState ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isCurrentBehaviourStateOf ;
                               owl:someValuesFrom :Behaviour
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isInfluencedBy ;
                               owl:someValuesFrom :EnvironmentalCondition
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isInfluencedByHealthCondition ;
                               owl:someValuesFrom :HealthCondition
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasBehaviourStateBaselineValues ;
                               owl:someValuesFrom xsd:decimal
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasBehaviourStateConfidenceScore ;
                               owl:someValuesFrom xsd:integer
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasBehaviourStateContext ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasBehaviourStateDescription ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasBehaviourStateDeviation ;
                               owl:someValuesFrom xsd:decimal
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasSpeed ;
                               owl:someValuesFrom xsd:decimal
                             ] ;
             rdfs:comment """Behaviour state that are a social norm, that is statistically frequent and prevents livestock from functioning.
Sub-classes:
1.CatleRunningState
2.GoatGrazingState""" ;
             rdfs:label "NormalState" .


###  https://github.com/tumelomodise/LFTDO#Panting
:Panting rdf:type owl:Class ;
         rdfs:subClassOf :Behaviour ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :exhibitedBy ;
                           owl:someValuesFrom :Livestock
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasCurrentBehaviourState ;
                           owl:someValuesFrom :BehaviourState
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasBehaviourStartTime ;
                           owl:someValuesFrom xsd:dateTime
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIntensity ;
                           owl:someValuesFrom xsd:string
                         ] ;
         rdfs:comment """Referenced Ontology:
Panting = Panting(ATOL:00832)
\"any measurable or observable characteristic related to the ability of increasing breathing by polypnea or hyperpnea performed with open mouth and distinct thoracic movements, to increase O2-CO2 exchanges and/or to increase evaporative heat loss.\" (Meunier-Salaün et. al,2015)""" ;
         rdfs:label "Panting" .


###  https://github.com/tumelomodise/LFTDO#Participant
:Participant rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :validateStatusOfEvent ;
                               owl:someValuesFrom :StatusUpdateEvent
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasContactNumber ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasParticipantName ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasParticipantRole ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasParticipantID ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ;
             rdfs:comment """A participant in livestock farming such as Farmers, and others such as extended officers, veterinarians, and Law enforcement agents.
A Farmer owns various domestic animals such as cattle, sheep, and goats. 
The veterinarian understands the behavior of domestic animals and often treats the domestic animals for diseases.    
Extended officers, work on a farm, to manage livestock such as feeding, keeping count, managing their well-being, and protecting against theft.
Law enforcement agents, enforce the law of the country if not being adhered to such as theft, and abuse of livestock.

Sub-classes:
1. Farmer
2.ExtendedOfficer
3.LawEnforcementAgency
4.Veterinarian""" ;
             rdfs:label "Participant" .


###  https://github.com/tumelomodise/LFTDO#Resting
:Resting rdf:type owl:Class ;
         rdfs:subClassOf :Behaviour ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :exhibitedBy ;
                           owl:someValuesFrom :Livestock
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasCurrentBehaviourState ;
                           owl:someValuesFrom :BehaviourState
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasBehaviourStartTime ;
                           owl:someValuesFrom xsd:dateTime
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIntensity ;
                           owl:someValuesFrom xsd:string
                         ] ;
         rdfs:comment """1.Resting is a behaviour
2.Resting can be a normal or abnormal behaviour state based on duration of the rest""" .


