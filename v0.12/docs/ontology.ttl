:hasAccessTo rdf:type owl:ObjectProperty ;
             rdfs:domain :Participant ;
             rdfs:range :SoftwareApplication ;
             rdfs:comment "Participant has access to some SoftwareApplication" ;
             rdfs:label "hasAccessTo" .


