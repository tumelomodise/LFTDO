LFTDO4:GoatTrackerSensor100_1 a owl:NamedIndividual,
        LFTDO4:Sensor ;
    rdfs:label "GoatTrackerSensor100_1"^^xsd:string ;
    rdfs:comment "GoatTrackerSensor100_1"^^xsd:string ;
    LFTDO4:generatesData LFTDO4:GoatSensorData100 ;
