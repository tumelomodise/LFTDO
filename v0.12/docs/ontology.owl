        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>hasUpdateFrequency

hasUpdateFrequency ∈ {
  &quot;real-time&quot;,
  &quot;near-real-time&quot;,
  &quot;secondly&quot;,
  &quot;sub-minute&quot;,
  &quot;minutely&quot;,
  &quot;five-minute&quot;,
  &quot;quarter-hourly&quot;,
  &quot;half-hourly&quot;,
  &quot;hourly&quot;,
  &quot;daily&quot;,
  &quot;on-demand&quot;,
  &quot;event-driven&quot;,
  &quot;irregular&quot;
}</rdfs:comment>
        <rdfs:label>hasUpdateFrequency</rdfs:label>
    </owl:DatatypeProperty>
    


