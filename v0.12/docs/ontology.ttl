                                        owl:onProperty :hasParticipantID ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                      rdfs:comment "Law enforcement agents, enforce the law of the country pertaining to Livestock if not being adhered to such as theft, and abuse of livestock." ;
                      rdfs:label "LawEnforcementAgency" .


