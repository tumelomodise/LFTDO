                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates which SWRL rule was executed and Inferred results.</rdfs:comment>
