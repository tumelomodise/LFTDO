    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Uses speed/baseline math to move any livestock  from a &quot;Normal&quot; to &quot;Abnormal&quot; state.</rdfs:comment>
        <rdfs:label>RL_STATE_ABNORMAL_TRANSITION</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#subtract"/>
                        <swrl:arguments rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#result1"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#sp"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#bv"/>
                        </swrl:arguments>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#multiply"/>
                                <swrl:arguments>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#result3"/>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#result2"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </swrl:arguments>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpeed"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ggs"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#sp"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#divide"/>
                                                <swrl:arguments rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#result2"/>
                                                    <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#result1"/>
                                                    <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#sp"/>
                                                </swrl:arguments>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#GoatGrazingState"/>
                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ggs"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDeviation"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ggs"/>
                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#dv"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                                                        <swrl:arguments rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#result3"/>
                                                                            <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#dv"/>
                                                                        </swrl:arguments>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateBaselineValues"/>
                                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ggs"/>
                                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#bv"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#transitionsTo"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ggs"/>
                        <swrl:argument2 rdf:resource="https://github.com/tumelomodise/LFTDO#UnsualGoatMovement"/>
                    </rdf:Description>
                </rdf:first>
