}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#CattleWithHighAbnormalBodyTempareture",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow's Body temperature\ndeviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. \n\ne.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [>=38,>39.3]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CattleWithHighAbnormalBodyTempareture"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid193"
  } ]
}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#CattleWithLowAbnormalBodyTempareture",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow's Body temperature\ndeviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. \n\ne.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [>=38,>39.3]"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CattleWithLowAbnormalBodyTempareture"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid200"
  } ]
}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#CattleWithNormalBodyTempareture",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow's Body temperature\ndeviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. \n\ne.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [>=38,>39.3]"
