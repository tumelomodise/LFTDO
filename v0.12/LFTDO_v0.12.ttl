                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                    swrl:argument1 :dev ;
                                                                                    swrl:classPredicate LFTDO4:Device ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 :sensorComp ;
                                                                                            swrl:argument2 :sensorData ;
                                                                                            swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                    swrl:argument1 :resting ;
                                                                                                    swrl:argument2 :NormState ;
                                                                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                            swrl:argument1 :s ;
                                                                                                            swrl:argument2 :resting ;
                                                                                                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                    swrl:argument1 :resting ;
                                                                                                                    swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                                            swrl:argument1 :NormState ;
                                                                                                                            swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                    swrl:argument1 :sensorData ;
                                                                                                                                    swrl:argument2 "m/s"^^xsd:string ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                            swrl:arguments ( :Duration :baseDuration ) ;
                                                                                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                    swrl:argument1 :NormState ;
                                                                                                                                                    swrl:argument2 :context ;
                                                                                                                                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                                            swrl:argument2 :dev ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                                                    swrl:argument2 false ;
                                                                                                                                                                    swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                                                            swrl:arguments ( :speed :baseSpeed ) ;
                                                                                                                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 LFTDO4:HighSpeedTheftState ;
                    swrl:argument2 LFTDO4:HighSpeedTheftEvent ;
                    swrl:propertyPredicate LFTDO4:triggers ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                            swrl:argument2 LFTDO4:HighSpeedTheftIndicator ;
                            swrl:propertyPredicate LFTDO4:hasHealthIndicator ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 LFTDO4:HighSpeedTheftState ;
                                    swrl:argument2 "RL_FENCE_BREACH_THEFT_SPEED"^^xsd:string ;
                                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                                            swrl:argument2 :context ;
                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :NormState ;
                                                    swrl:argument2 LFTDO4:HighSpeedTheftState ;
                                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                                            rdf:rest () ] ] ] ] ] .

[] a owl:AllDisjointClasses ;
    owl:members ( LFTDO4:Behaviour LFTDO4:BehaviourState LFTDO4:CloudService LFTDO4:DataTransmission LFTDO4:Device LFTDO4:EnvironmentalCondition LFTDO4:HealthCondition LFTDO4:Livestock LFTDO4:Location LFTDO4:Participant LFTDO4:SensorData LFTDO4:TheftEvent ) .

[] a swrl:Imp ;
    rdfs:label "RL_NORMAL_MOVEMENT_BASELINE"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Validates normal activity if duration and speed stay within the sheep's  wandering baseline."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :sensorComp ;
                            swrl:classPredicate LFTDO4:Sensor ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :sensorData ;
                                    swrl:classPredicate LFTDO4:SensorData ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 :sensorData ;
                                            swrl:argument2 :speed ;
                                            swrl:propertyPredicate LFTDO4:hasValue ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :dev ;
                                                    swrl:argument2 :sensorComp ;
                                                    swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:ClassAtom ;
                                                            swrl:argument1 :dev ;
                                                            swrl:classPredicate LFTDO4:Device ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                    swrl:arguments ( :speed :baseSpeed ) ;
                                                                    swrl:builtin swrlb:lessThanOrEqual ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 :sensorComp ;
                                                                            swrl:argument2 :sensorData ;
                                                                            swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                    swrl:argument1 :NormSheepWanderingState ;
                                                                                    swrl:argument2 :context ;
                                                                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                            swrl:argument1 :NormSheepWanderingState ;
                                                                                            swrl:argument2 :baseDuration ;
                                                                                            swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                    swrl:argument1 :wandering ;
                                                                                                    swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                            swrl:argument1 :s ;
                                                                                                            swrl:argument2 :wandering ;
                                                                                                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 :sensorData ;
                                                                                                                    swrl:argument2 "m/s"^^xsd:string ;
                                                                                                                    swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                            swrl:argument1 :wandering ;
                                                                                                                            swrl:argument2 :NormSheepWanderingState ;
                                                                                                                            swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                    swrl:argument2 :dev ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                            swrl:argument1 :NormSheepWanderingState ;
                                                                                                                                            swrl:argument2 :baseSpeed ;
                                                                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                                                    swrl:argument1 :NormSheepWanderingState ;
                                                                                                                                                    swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                                            swrl:argument2 false ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                    swrl:argument1 :wandering ;
                                                                                                                                                                    swrl:argument2 :duration ;
                                                                                                                                                                    swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 LFTDO4:NormalActivityIndicator ;
                    swrl:argument2 "RL_NORMAL_MOVEMENT_BASELINE"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 :sensorData ;
                            swrl:argument2 LFTDO4:NormalActivityIndicator ;
                            swrl:propertyPredicate LFTDO4:isExtractedTo ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :NormSheepWanderingState ;
                                    swrl:argument2 LFTDO4:NormalActivityIndicator ;
                                    swrl:propertyPredicate LFTDO4:isCharacterisedBy ] ;
                            rdf:rest () ] ] ] .

[] a owl:Axiom ;
    rdfs:comment "UnusualRestingState (Critical)" ;
    owl:annotatedProperty LFTDO4:hasDuration ;
    owl:annotatedSource LFTDO4:SheepResting089 ;
    owl:annotatedTarget 18000.0 .

[] a swrl:Imp ;
    rdfs:label "RL_GEOFENCE_NORTH_VIOLATION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Triggers a breach alert if current latitude is greater than max latitude."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:BuiltinAtom ;
                            swrl:arguments ( :lat :MaxLat ) ;
                            swrl:builtin swrlb:greaterThan ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :dev ;
                                    swrl:classPredicate LFTDO4:Device ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 :dev ;
                                            swrl:argument2 :lat ;
                                            swrl:propertyPredicate LFTDO4:hasLatitude ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :s ;
                                                    swrl:argument2 :dev ;
                                                    swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :s ;
                                                            swrl:argument2 :currLoc ;
                                                            swrl:propertyPredicate LFTDO4:hasCurrentLocation ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                    swrl:argument1 :currLoc ;
                                                                    swrl:argument2 :MaxLat ;
                                                                    swrl:propertyPredicate LFTDO4:hasMaxLat ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 :currLoc ;
                                                                            swrl:classPredicate LFTDO4:Location ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :s ;
                    swrl:argument2 "RL_GEOFENCE_NORTH_VIOLATION"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :s ;
                            swrl:argument2 true ;
                            swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                    rdf:rest () ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_GEOFENCE_WEST"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Triggers when device longitude falls below the minimum western coordinate."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :dev ;
                            swrl:argument2 :lon ;
                            swrl:propertyPredicate LFTDO4:hasLongitude ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :currLoc ;
                                    swrl:argument2 :MinLon ;
                                    swrl:propertyPredicate LFTDO4:hasMinLon ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :dev ;
                                            swrl:classPredicate LFTDO4:Device ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :s ;
                                                    swrl:argument2 :dev ;
                                                    swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :s ;
                                                            swrl:argument2 :currLoc ;
                                                            swrl:propertyPredicate LFTDO4:hasCurrentLocation ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :currLoc ;
                                                                    swrl:classPredicate LFTDO4:Location ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                            swrl:arguments ( :lon :MinLon ) ;
                                                                            swrl:builtin swrlb:lessThan ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :s ;
                    swrl:argument2 "RL_GEOFENCE_WEST"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :s ;
                            swrl:argument2 true ;
                            swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                    rdf:rest () ] ] .

[] a owl:Axiom ;
    rdfs:comment "Livestock baseLine temperature value." ;
    owl:annotatedProperty LFTDO4:hasBaseLineTemp ;
    owl:annotatedSource LFTDO4:NormalCattleGrazingState ;
    owl:annotatedTarget 39.4 .

[] a owl:Axiom ;
    rdfs:comment """20% in Goat Speed deviation from the base line speed allowed, anything more than indicates a possible abnormal behaviour.
N.B: This values be added into application parameters and can be adjusted to as needed.""" ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource LFTDO4:GoatGrazingState ;
    owl:annotatedTarget [ a owl:Restriction ;
            owl:hasValue 20 ;
            owl:onProperty LFTDO4:hasBehaviourStateDeviation ] .

[] a swrl:Imp ;
    rdfs:label "RL_EXTREME_HEAT_CONTEXT"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Flags daytime temperatures (≥ 35°C) as \"Extreme Heat\" to provide context for high heart rates."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :Loc ;
                    swrl:classPredicate LFTDO4:Location ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :t ;
                            swrl:argument2 :v ;
                            swrl:propertyPredicate LFTDO4:hasEnvValue ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :t ;
                                    swrl:argument2 :Loc ;
                                    swrl:propertyPredicate LFTDO4:OccursAtLocation ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :t ;
                                            swrl:classPredicate LFTDO4:AmbientTemperature ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:BuiltinAtom ;
                                                    swrl:arguments [ a rdf:List ;
                                                            rdf:first :v ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first 35 ;
                                                                    rdf:rest () ] ] ;
                                                    swrl:builtin swrlb:greaterThanOrEqual ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :t ;
                                                            swrl:argument2 "DayTime"^^xsd:string ;
                                                            swrl:propertyPredicate LFTDO4:hasTemporalContext ] ;
                                                    rdf:rest () ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :t ;
                    swrl:classPredicate LFTDO4:ExtremeHeat ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:HighEnvTheftIndicator001 ;
                            swrl:argument2 "RL_BEHAVIOUR_DEVIATION"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 LFTDO4:DayAmbientTemp001 ;
                                    swrl:argument2 LFTDO4:HighEnvTheftIndicator001 ;
                                    swrl:propertyPredicate LFTDO4:isCharacterisedBy ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :t ;
                                            swrl:classPredicate LFTDO4:ExtremeDayTimeHeat ] ;
                                    rdf:rest () ] ] ] ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:NormalSheepGrazingState LFTDO4:NormalSheepRunningState ) .

[] a swrl:Imp ;
    rdfs:label "RL_PROLONGED_RESTING_DEVIATION_STEPCOUNT"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment ""^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :sensorComp ;
                            swrl:classPredicate LFTDO4:Sensor ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :sensorData ;
                                    swrl:classPredicate LFTDO4:SensorData ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 :NormState ;
                                            swrl:argument2 :baseDuration ;
                                            swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :dev ;
                                                    swrl:argument2 :sensorComp ;
                                                    swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :resting ;
                                                            swrl:argument2 :Duration ;
                                                            swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :dev ;
                                                                    swrl:classPredicate LFTDO4:Device ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 :sensorComp ;
                                                                            swrl:argument2 :sensorData ;
                                                                            swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                    swrl:arguments [ a rdf:List ;
                                                                                            rdf:first :StepCount ;
                                                                                            rdf:rest [ a rdf:List ;
                                                                                                    rdf:first 0.02 ;
                                                                                                    rdf:rest () ] ] ;
                                                                                    swrl:builtin swrlb:lessThanOrEqual ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 :resting ;
                                                                                            swrl:argument2 :NormState ;
                                                                                            swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                    swrl:argument1 :s ;
                                                                                                    swrl:argument2 :resting ;
                                                                                                    swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                            swrl:argument1 :resting ;
                                                                                                            swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                    swrl:argument1 :NormState ;
                                                                                                                    swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                            swrl:argument1 :NormState ;
                                                                                                                            swrl:argument2 :baseStepCount ;
                                                                                                                            swrl:propertyPredicate LFTDO4:hasBaselineStepCount ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                    swrl:argument1 :sensorData ;
                                                                                                                                    swrl:argument2 :StepCount ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasValue ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                            swrl:argument1 :sensorData ;
                                                                                                                                            swrl:argument2 "count"^^xsd:string ;
                                                                                                                                            swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                                    swrl:arguments ( :Duration :baseDuration ) ;
                                                                                                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                            swrl:argument1 :NormState ;
                                                                                                                                                            swrl:argument2 :context ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                                                    swrl:argument2 :dev ;
                                                                                                                                                                    swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                                                            swrl:argument2 false ;
                                                                                                                                                                            swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 LFTDO4:UnusualRestingState ;
                    swrl:argument2 "RL_PROLONGED_RESTING_DEVIATION_STEPCOUNT"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:UnusualRestingState ;
                            swrl:argument2 :context ;
                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :NormState ;
                                    swrl:argument2 LFTDO4:UnusualRestingState ;
                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 LFTDO4:UnusualRestingState ;
                                            swrl:argument2 LFTDO4:LethargyIndicator ;
                                            swrl:propertyPredicate LFTDO4:hasHealthIndicator ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 LFTDO4:UnusualRestingState ;
                                                    swrl:argument2 LFTDO4:HighHealthAlertEvent ;
                                                    swrl:propertyPredicate LFTDO4:triggers ] ;
                                            rdf:rest () ] ] ] ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_FENCE_BREACH_THEFT_DIRECTION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Detects theft by combining fence breach with directional movement analysis (away from farm)."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :NormState ;
                            swrl:argument2 :baseDirection ;
                            swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :sensorComp ;
                                    swrl:classPredicate LFTDO4:Sensor ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 :sensorData ;
                                            swrl:argument2 :direction ;
                                            swrl:propertyPredicate LFTDO4:hasValue ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 :sensorData ;
                                                    swrl:classPredicate LFTDO4:SensorData ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :NormState ;
                                                            swrl:argument2 :baseDuration ;
                                                            swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 :dev ;
                                                                    swrl:argument2 :sensorComp ;
                                                                    swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                            swrl:argument1 :resting ;
                                                                            swrl:argument2 :Duration ;
                                                                            swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                    swrl:argument1 :dev ;
                                                                                    swrl:classPredicate LFTDO4:Device ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 :sensorComp ;
                                                                                            swrl:argument2 :sensorData ;
                                                                                            swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                    swrl:argument1 :sensorData ;
                                                                                                    swrl:argument2 "degrees"^^xsd:string ;
                                                                                                    swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                            swrl:argument1 :resting ;
                                                                                                            swrl:argument2 :NormState ;
                                                                                                            swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                    swrl:argument1 :s ;
                                                                                                                    swrl:argument2 :resting ;
                                                                                                                    swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                                            swrl:argument1 :resting ;
                                                                                                                            swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                                    swrl:argument1 :NormState ;
                                                                                                                                    swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                            swrl:arguments ( :direction :baseDirection ) ;
                                                                                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                                    swrl:arguments ( :Duration :baseDuration ) ;
                                                                                                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                            swrl:argument1 :NormState ;
                                                                                                                                                            swrl:argument2 :context ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                                                    swrl:argument2 :dev ;
                                                                                                                                                                    swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                                                            swrl:argument2 false ;
                                                                                                                                                                            swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 LFTDO4:HighSpeedTheftState ;
                    swrl:argument2 LFTDO4:HighSpeedTheftEvent ;
                    swrl:propertyPredicate LFTDO4:triggers ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                            swrl:argument2 "RL_FENCE_BREACH_THEFT_DIRECTION"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 LFTDO4:HighSpeedTheftState ;
                                    swrl:argument2 LFTDO4:HighSpeedTheftIndicator ;
                                    swrl:propertyPredicate LFTDO4:hasHealthIndicator ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                                            swrl:argument2 :context ;
                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :NormState ;
                                                    swrl:argument2 LFTDO4:HighSpeedTheftState ;
                                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                                            rdf:rest () ] ] ] ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_GEOFENCE_INSIDE_VALIDATION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Confirms livestock is Inside if current latitude is less than max latitude."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :dev ;
                            swrl:classPredicate LFTDO4:Device ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :dev ;
                                    swrl:argument2 :lat ;
                                    swrl:propertyPredicate LFTDO4:hasLatitude ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 :s ;
                                            swrl:argument2 :dev ;
                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :s ;
                                                    swrl:argument2 :currLoc ;
                                                    swrl:propertyPredicate LFTDO4:hasCurrentLocation ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :currLoc ;
                                                            swrl:argument2 :MaxLat ;
                                                            swrl:propertyPredicate LFTDO4:hasMaxLat ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :currLoc ;
                                                                    swrl:classPredicate LFTDO4:Location ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                            swrl:arguments ( :lat :MaxLat ) ;
                                                                            swrl:builtin swrlb:lessThan ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :s ;
                    swrl:argument2 false ;
                    swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :s ;
                            swrl:argument2 "RL_GEOFENCE_INSIDE_VALIDATION"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest () ] ] .

