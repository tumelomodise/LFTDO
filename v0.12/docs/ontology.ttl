                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasMethodAttribute ;
                                         owl:someValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasTrainingData ;
                                         owl:someValuesFrom xsd:boolean
                                       ] ;
                       rdfs:comment "AudioMonitoringSystem is a theft DetectionMethod" ;
                       rdfs:label "AudioMonitoringSystem" .


