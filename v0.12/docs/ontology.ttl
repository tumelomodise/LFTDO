###  https://github.com/tumelomodise/LFTDO#hasSpecies
:hasSpecies rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Livestock ;
            rdfs:range xsd:string ;
            rdfs:comment """Livestock has belong to a specific type of species
\"Livestock species are defined as domesticated farm animals, such as buffalo, chicken, sheep, goats, pigs, cattle, duck, camel, horse, mole, and turkey, primarily raised for labor, meat, eggs, milk, fur, leather, and wool. They play a crucial role in agriculture and contribute significantly to the livelihoods of farm families.\" https://www.sciencedirect.com/topics/agricultural-and-biological-sciences/livestock-species""" ;
            rdfs:label "hasSpecies" .


###  https://github.com/tumelomodise/LFTDO#hasSpeed
:hasSpeed rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :BehaviourState ;
          rdfs:range xsd:decimal ;
          rdfs:comment "Livestock BehaviourState has some Speed measured in meters per second" ,
                       "Livestock hasSpeed movement that can be measured based on the type of Livestock for e.g. Sheep and Goat is in meters per seconds(m/s), Cattle is in Kilometer per hour(km/h)." ;
          rdfs:label "hasSpeed" .


###  https://github.com/tumelomodise/LFTDO#hasStatus
:hasStatus rdf:type owl:DatatypeProperty ;
           rdfs:domain :StatusUpdateEvent ;
           rdfs:range xsd:string ,
                      [ rdf:type rdfs:Datatype ;
                        owl:oneOf [ rdf:type rdf:List ;
                                    rdf:first "Accepted" ;
                                    rdf:rest [ rdf:type rdf:List ;
                                               rdf:first "Active" ;
                                               rdf:rest [ rdf:type rdf:List ;
                                                          rdf:first "Pending" ;
                                                          rdf:rest [ rdf:type rdf:List ;
                                                                     rdf:first "Rejected" ;
                                                                     rdf:rest rdf:nil
                                                                   ]
                                                        ]
                                             ]
                                  ]
                      ] ;
           rdfs:comment """Active (Default)
Processing
Pending
Ignored
Accepted
Rejected""" ;
           rdfs:label "hasStatus" .


