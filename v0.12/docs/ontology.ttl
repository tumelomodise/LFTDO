###  https://github.com/tumelomodise/LFTDO#HealthAlertEvent
:HealthAlertEvent rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasAbnormalBehaviourState ;
                                                               owl:someValuesFrom :AbnormalState
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :isAlertInitiatedBy ;
                                                               owl:someValuesFrom :EscapeIndicator
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :LivestockEvent ,
                                  [ rdf:type owl:Class ;
                                    owl:unionOf ( [ rdf:type owl:Restriction ;
                                                    owl:onProperty :triggersAlertLevel ;
                                                    owl:hasValue "High"
                                                  ]
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :triggersAlertLevel ;
                                                    owl:hasValue "Low"
                                                  ]
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :triggersAlertLevel ;
                                                    owl:hasValue "Medium"
                                                  ]
                                                )
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :affectsLivestock ;
                                    owl:someValuesFrom :Livestock
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isTriggeredBy ;
                                    owl:someValuesFrom :BehaviourState
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasTheftEventResolution ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasTheftEventStatus ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasTheftEventTime ;
                                    owl:someValuesFrom xsd:dateTime
                                  ] ;
                  rdfs:comment "HealthAlertEvent: Alert related to Livestock Health" ;
                  rdfs:label "HealthAlertEvent" .


###  https://github.com/tumelomodise/LFTDO#HealthCondition
:HealthCondition rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :healthInfluencesBehaviourState ;
                                   owl:someValuesFrom :BehaviourState
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasHealthDescription ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasSymptoms ;
                                   owl:someValuesFrom xsd:string
                                 ] ;
                 rdfs:comment """Health condition indicates various health situations of a livestock, related to Livestock behavior pertaining to livestock theft situations.
Sub-routine:
1.LegInjurty
2.Sick""" ;
                 rdfs:label "HealthCondition" .


