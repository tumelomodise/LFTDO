#################################################################
#    Classes
#################################################################

###  https://github.com/tumelomodise/LFTDO#AbnormalBodyTemperature
:AbnormalBodyTemperature rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :BodyTemperature
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :healthConditionBelongsTo ;
                                                                      owl:someValuesFrom :Livestock
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :BodyTemperature ;
                         rdfs:comment "The Abnormal body temperature is the opposite of any normal defined body temperature for Livestock." ;
                         rdfs:label "AbnormalBodyTemperature" .


###  https://github.com/tumelomodise/LFTDO#AbnormalState
:AbnormalState rdf:type owl:Class ;
               rdfs:subClassOf :BehaviourState ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :isCharacterisedBy ;
                                 owl:someValuesFrom :TheftIndicator
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :isCurrentBehaviourStateOf ;
                                 owl:someValuesFrom :Behaviour
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :isInfluencedBy ;
                                 owl:someValuesFrom :EnvironmentalCondition
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :isInfluencedByHealthCondition ;
                                 owl:someValuesFrom :HealthCondition
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasBehaviourStateConfidenceScore ;
                                 owl:someValuesFrom xsd:integer
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasBehaviourStateContext ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasBehaviourStateDescription ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasSeverityLevel ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasSpeed ;
                                 owl:someValuesFrom xsd:decimal
                               ] ;
               owl:disjointWith :NormalState ;
               rdfs:comment """Behaviour state that breaks a social norm, that is statistically infrequent and prevents livestock from functioning.

Sub-classes:
1.DistressVocalization
2.Restlessness
3.UnusualMovement""" ;
               rdfs:label "AbnormalState" .


###  https://github.com/tumelomodise/LFTDO#Agression
:Agression rdf:type owl:Class ;
           rdfs:subClassOf :Behaviour ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :exhibitedBy ;
                             owl:someValuesFrom :Livestock
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasCurrentBehaviourState ;
                             owl:someValuesFrom :BehaviourState
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasBehaviourStartTime ;
                             owl:someValuesFrom xsd:dateTime
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasIntensity ;
                             owl:someValuesFrom xsd:string
                           ] ;
           rdfs:comment """1.Aggression is a behaviour
Referenced Ontology: Aggression (ATOL:0001782)=Aggregative  behaviour (Meunier-Salaün et. al,2015)
Under Behavior trait->Motor activity->aggregative behavior.""" ;
           rdfs:label "Aggression" .


