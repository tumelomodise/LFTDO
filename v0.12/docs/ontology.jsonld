}, {
  "@id" : "https://github.com/tumelomodise/LFTDO#Livestock",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Livestock are domestic animals such as cattle, sheep, and goats for labor, and the production of commodities for humans such as meat, milk, wool, and leather (Britannica, 2020).\n\nRelationships:\n1.Livestock is fitted with some end device for tracking and monitoring.\n2.Livestock has some body condition score.\n3.Livestock exhibit some Behaviour \n4.Livestock is located at some Farm Location"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Livestock"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
