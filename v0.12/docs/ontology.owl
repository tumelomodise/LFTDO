2.Software Application uses results from ML Algorithm
(MLA)</rdfs:comment>
        <rdfs:label>SoftwareApplication</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SpaceUse -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SpaceUse">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology: SpaceUse = Space use(ATOL0000831:) &quot;any measurable or observable characteristic related to the behavior of the animals to use their physical environment according to the social or physical stimuli within this environment  (e.g. use of perches, use of specific area, geographic location)&quot; (Meunier-Salaün et. al,2015)</rdfs:comment>
        <rdfs:label>SpaceUse</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Startle -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Startle">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology:
1. Startle is a Behaviour = startle reponses(ATOL:0000368), &quot;any measurable or observable characteristic related to the response of the whole body to triggering stimulus without any voluntary orientation towards this given stimulus&quot;

In ATOL under:Aninmal trait of livestock-&gt;animal welfare trait-&gt;psychoneuroendcrinological state trait-&gt;behavior trait-&gt;motor activity-&gt;body movement-&gt;locomotor activity-&gt;startle response</rdfs:comment>
        <rdfs:label>Startle</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#StatusUpdateEvent -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#SystemEvent"/>
        <rdfs:comment>Classified the state change event.</rdfs:comment>
        <rdfs:label>StatusUpdateEvent</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Suckling -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Suckling">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology:
1.Suckling = suckling behavior(ATOL:0000365)&quot;any measurable or observable beahvioral characteristic related to the intake of milk by a preweaning organism&quot;(Meunier-Salaün et. al,2015)
2.Suckling indicates the baby of livestock sucking miik from their mother, it had different rates, and number of times it does in an hour/day. 
3. it may have a abnormal behaviour state based on decreased suckling rate, which could indicate a baby livestock is separated from its mother

In ATOL under: animal trait of livestock-&gt;animal welfare trait-&gt;psychoneuroendocrinological state trait-&gt;behaviour trait-&gt;ingestive behavior-&gt;suckling behavior</rdfs:comment>
        <rdfs:label>Suckling</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SuspiciousEvent -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SuspiciousEvent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAbnormalBehaviourState"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#SuspiciousIndicator"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>High</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Low</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Medium</owl:hasValue>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#affectsLivestock"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isTriggeredBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventResolution"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventStatus"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>SuspiciousEvent: Is trigged by some SuspiciousIndicator that is identified as a Livestock Behaviour changes that could indicate suspicious activities.</rdfs:comment>
        <rdfs:label>SuspiciousEvent</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SuspiciousIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SuspiciousIndicator">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>Suspicious Indicator may indicate that there is a suspecious activity event.</rdfs:comment>
        <rdfs:label>SuspiciousIndicator</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SystemEvent -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SystemEvent">
        <rdfs:comment>SystemEvent (Events related to the software&apos;s operations)</rdfs:comment>
        <rdfs:label>SystemEvent</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#TechnicalIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#TechnicalIndicator">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#TheftEvent -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#TheftEvent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#causedBy"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#UnauthorisedPerson"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAbnormalBehaviourState"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#TheftIndicator"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>High</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Low</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Medium</owl:hasValue>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#affectsLivestock"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isTriggeredBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventResolution"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventStatus"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>TheftEvent: Is trigged by some TheftIndicator that is identified as a theft attempts or suspicious event and is caused by some UnauthorisedPerson</rdfs:comment>
        <rdfs:label>TheftEvent</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#TheftIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#TheftIndicator">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>High</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Low</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Medium</owl:hasValue>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#initiatesAlert"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#TheftEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Factors suggesting a potential of theft, linking them to relevant behavior states, environment, and health conditions.</rdfs:comment>
        <rdfs:label>TheftIndicator</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#TheftOfLivestockProducts -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#TheftOfLivestockProducts">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#TheftEvent"/>
        <rdfs:comment>The theft of livestock-derived products (e.g., milk, wool, meat).</rdfs:comment>
        <rdfs:label>TheftOfLivestockProducts</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#UnauthorisedPerson -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#UnauthorisedPerson">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:comment>UnauthorisedPerson: Represents individuals not permitted to access specific farm areas (also referred to as &quot;Unknown Person(s)&quot;). This class is essential for modeling security breaches and theft intent.</rdfs:comment>
        <rdfs:label>UnauthorisedPerson</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#UserDevice -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#UserDevice">
