    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->


    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty">
        <rdfs:label>owl:topObjectProperty</rdfs:label>
    </rdf:Description>
    


    <!-- https://github.com/tumelomodise/LFTDO#InferredComplexTheftEvent -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#InferredComplexTheftEvent">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#TheftEvent"/>
        <rdfs:label>InferredComplexTheftEvent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#OccursAtLocation -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#OccursAtLocation">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:comment>Some Enviromental Condition, TheftIndicator, TheftEvent Occurrs at some Location</rdfs:comment>
        <rdfs:label>OccursAtLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#accesses -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#accesses">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isAccessedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:comment>SoftwareApplication accesses some Database</rdfs:comment>
        <rdfs:label>accesses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#affectsLivestock -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#affectsLivestock">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isAffectedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Device"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Livestock"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Location"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>LivestockEvent affects some Location Livestock or Location or Device</rdfs:comment>
        <rdfs:label>affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#analyses -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#analyses">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isAnalysedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:comment>DetectionMethod analyses Database data</rdfs:comment>
        <rdfs:label>analyses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#atIncidentLocation -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#atIncidentLocation">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isLocationOfIncident"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:comment>LivestockEvent happens at  some Location</rdfs:comment>
        <rdfs:label>atIncidentLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#behaviourOccursAt -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#behaviourOccursAt">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:comment>behaviour OccursAt some Location</rdfs:comment>
        <rdfs:label>behaviourOccursAt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#biologicallyAffects -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#biologicallyAffects">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isBiologicallyAffectedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:comment>HealthCondition biologicallyAffects some Livestock</rdfs:comment>
        <rdfs:label>biologicallyAffects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#causedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#causedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#TheftEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#UnauthorisedPerson"/>
        <rdfs:comment>TheftEvent is caused by some UnauthorisedPerson an agentive cause (the intruder)</rdfs:comment>
        <rdfs:label>causedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#characterises -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#characterises">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isCharacterisedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Livestock Indicator characterises some BehaviourState</rdfs:comment>
        <rdfs:label>characterises</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#detects -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#detects">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isDetectedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SystemEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>DetectictionMethod detects LivestockIndicators</rdfs:comment>
        <rdfs:label>detects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#evidenceFor -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#evidenceFor">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isSupportedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:comment>LivestockIndicator provides evidenceFor some LivestockEvent</rdfs:comment>
        <rdfs:label>evidenceFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#executesApplication -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#executesApplication">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isDeployedOn"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#CloudService"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:comment>CloudService executes some Software Application</rdfs:comment>
        <rdfs:label>executesApplication</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#exhibitedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#exhibitedBy">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#exhibits"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:comment>Behaviour is exhibitedBy Livestock</rdfs:comment>
        <rdfs:label>exhibitedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#exhibits -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#exhibits">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:comment>Livestock exhibit some Behaviour</rdfs:comment>
        <rdfs:label>exhibits</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#experienceEnvironmentalCondition -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#experienceEnvironmentalCondition">
        <rdfs:label>experienceEnvironmentalCondition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#experiences -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#experiences">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isExperiencedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:label>Livestock experiences some HealthCondition</rdfs:label>
        <rdfs:label>experiences</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#externallyAffects -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#externallyAffects">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isExternallyAffectedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:comment>EnvironmentalCondition externallyAffects Livestock</rdfs:comment>
        <rdfs:label>externallyAffects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#generatesData -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#generatesData">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isGeneratedByDevice"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SensorData"/>
        <rdfs:comment>Device generates some Data</rdfs:comment>
        <rdfs:label>generatesData</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#generatesLog -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#generatesLog">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#logGeneratedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#RoutineLogEvent"/>
        <rdfs:comment>SoftwareApplication generate some RoutineLog</rdfs:comment>
        <rdfs:label>generatesLog</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasAbnormalBehaviourState -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasAbnormalBehaviourState">
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:comment>Livestock has Behaviour(s) has some AbnormalBehaviourState</rdfs:comment>
        <rdfs:label>hasAbnormalBehaviourState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasAccessTo -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasAccessTo">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:comment>Participant has access to some SoftwareApplication</rdfs:comment>
        <rdfs:label>hasAccessTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasCloudService -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasCloudService">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#receivesDataFrom"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#DataTransmission"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#CloudService"/>
        <rdfs:comment>DataTransmission has some CloudService</rdfs:comment>
        <rdfs:label>hasCloudService</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasComponent -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasComponent">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isSensorOf"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Sensor"/>
        <rdfs:comment>Device has some Sensor Components</rdfs:comment>
        <rdfs:label>hasComponent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:comment>Behaviour has some current BehaviourState</rdfs:comment>
        <rdfs:label>hasCurrentBehaviourState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasCurrentLocation -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasCurrentLocation">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentLocationOf"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:comment>Evironment condition and Livestock has a current Location at any point in time</rdfs:comment>
        <rdfs:label>hasCurrentLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasCurrentStatus -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasCurrentStatus">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentStatusOf"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:label>hasCurrentStatus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasDevice -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasDevice">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
        <rdfs:comment>Farm hasDevice</rdfs:comment>
        <rdfs:label>hasDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasEnvironmentalContext -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasEnvironmentalContext">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isContextOf"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
        <rdfs:comment>BehaviourState has some EnvironmentalCondition Context</rdfs:comment>
        <rdfs:label>hasEnvironmentalContext</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasHealthIndicator -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasHealthIndicator">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#HealthIndicator"/>
        <rdfs:label>hasHealthIndicator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasLivestockIndicator -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasLivestockIndicator">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Device"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>LivestockIndicators are indicated by some Livestock Abnormal Behaviour or Device or Health or Environment conditions</rdfs:comment>
        <rdfs:label>hasLivestockIndicator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasPartLocation -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasPartLocation">
        <rdfs:comment>The standard inverse for an &quot;isPartOfLocation&quot; relationship is typically named hasPartLocation.</rdfs:comment>
        <rdfs:label>hasPartLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasTheftEventLocation -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasTheftEventLocation">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#TheftEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:comment>TheftEvent happens at some Location</rdfs:comment>
        <rdfs:label>hasTheftEventLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#healthConditionBelongsTo -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#healthConditionBelongsTo">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:comment>HealthConditionBelongsTo to a specific Livestock type such Cattle, Sheep or Goat.</rdfs:comment>
        <rdfs:label>healthConditionBelongsTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#healthConfirmedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#healthConfirmedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:comment>Participant(Veterinarian) confirm Livestock Health Condition</rdfs:comment>
        <rdfs:label>healthConfirmedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#healthInfluencesBehaviourState -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#healthInfluencesBehaviourState">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:comment>healthCondition Influences some Livestock BehaviourState</rdfs:comment>
        <rdfs:label>healthInfluencesBehaviourState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hostsDatabase -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#hostsDatabase">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isStoredOn"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#CloudService"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:comment>Cloud Service hosts some Database</rdfs:comment>
        <rdfs:label>hostsDatabase</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#identifies -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#identifies">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isIdentifiedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:comment>DetectionMethod identifies some BehaviourState</rdfs:comment>
        <rdfs:label>identifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#implements -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#implements">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isImplementedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:comment>SoftwareApplication implements some DetectionMethod.
A single App (like SoftwareApp001) can contain multiple detection &quot;modules&quot; (e.g., one for Theft, one for Health, one for Heat Detection). It can also exist with Zero methods if it’s just a data-viewer app.</rdfs:comment>
        <rdfs:label>implements</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#indicatedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#indicatedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#TheftIndicator"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>TheftIndicator is indicated by some Abnorma behaviour state</rdfs:comment>
        <rdfs:label>indicatedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#influences -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#influences">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:comment>EnvironmentalCondition influences Livestock Behaviour.</rdfs:comment>
        <rdfs:label>influences</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#initiateStatusUpdate -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#initiateStatusUpdate">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#statusInitiatedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:comment>Software Application initiate some StatusUpdateEvent</rdfs:comment>
        <rdfs:label>initiateStatusUpdate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#initiatesAlert -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#initiatesAlert">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:comment>TheftIndicator initiates TheftEvent</rdfs:comment>
        <rdfs:label>initiatesAlert</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isAccessedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isAccessedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:comment>Database is accessed by some SoftwareApplication</rdfs:comment>
        <rdfs:label>isAccessedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isAdjacentTo -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isAdjacentTo">
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:comment>A Point of Reference a location may be next to or adjacent to.</rdfs:comment>
        <rdfs:label>isAdjacentTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isAffectedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isAffectedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Device"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Livestock"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Location"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:comment>Livestock or Location or Device isAffectedBy LivestockEvent</rdfs:comment>
        <rdfs:label>isAffectedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>HighTheftEvent is isInitiated by some TheftIndicator a logical cause (the data anomaly)</rdfs:comment>
        <rdfs:label>isAlertInitiatedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isAnalysedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isAnalysedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:comment>Database is analysed by some DetectionMethod</rdfs:comment>
        <rdfs:label>isAnalysedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isAttachedTo -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isAttachedTo">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isAttachedToDevice"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#EndDevice"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:comment>Device(EndDevice) is attached to some Livestock</rdfs:comment>
        <rdfs:label>isAttachedToLivestock</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isAttachedToDevice -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isAttachedToDevice">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#EndDevice"/>
        <rdfs:comment>Livestock is attached to some Device(EndDevice)</rdfs:comment>
        <rdfs:label>isAttachedToDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isBiologicallyAffectedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isBiologicallyAffectedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:comment>Livestock isBiologicallyAffectedBy HealthCondition</rdfs:comment>
        <rdfs:label>isBiologicallyAffectedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isCharacterisedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isCharacterisedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>AbnormalState isCharacterisedBy TheftIndicator</rdfs:comment>
        <rdfs:label>isCharacterisedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isComponentOf -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isComponentOf">
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#RestrictedArea"/>
        <rdfs:label>Represents the components of securedGuarded RestrictedArea Location</rdfs:label>
        <rdfs:label>isComponentOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isContextOf -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isContextOf">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:comment>EnvironmentalCondition is context of some BehaviourState

isContextOf (Passive/Spatio-Temporal): This simply means the behavior and the environment happened at the same time and place.
Example: &quot;The sheep is grazing while it is raining.&quot;</rdfs:comment>
        <rdfs:label>isContextOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:comment>BehaviourState is related to some Behaviour</rdfs:comment>
        <rdfs:label>isCurrentBehaviourStateOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isCurrentLocationOf -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isCurrentLocationOf">
        <rdfs:comment>Inverse of hasCurrentLocation to tell which Livestock occupy the location at any point in time.</rdfs:comment>
        <rdfs:label>isCurrentLocationOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isCurrentStatusOf -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isCurrentStatusOf">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:label>isCurrentStatusOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isDeployedOn -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isDeployedOn">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#CloudService"/>
        <rdfs:comment>SoftwareApplication is deployed on some cloudservice.</rdfs:comment>
        <rdfs:label>isDeployedOn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isDetectedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isDetectedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SystemEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:comment>System or Livestock Event is detected by some DetectionMethod</rdfs:comment>
        <rdfs:label>isDetectedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isExperiencedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isExperiencedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:comment>HealthCondition isExperiencedBy Livestock</rdfs:comment>
        <rdfs:label>isExperiencedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isExternallyAffectedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isExternallyAffectedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
        <rdfs:comment>Livestock isExternallyAffectedBy EnvironmentalCondition</rdfs:comment>
        <rdfs:label>isExternallyAffectedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isExtractedFrom -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isExtractedFrom">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isExtractedTo"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SensorData"/>
        <rdfs:comment>LivestockIndicator isExtractedFom some SensorData</rdfs:comment>
        <rdfs:label>isExtractedFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isExtractedTo -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isExtractedTo">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SensorData"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>SensorData isExtractedTo some LivestockIndicator</rdfs:comment>
        <rdfs:label>isExtractedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isGeneratedByDevice -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isGeneratedByDevice">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SensorData"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
        <rdfs:comment>SensorData isGeneratedBy of some Device</rdfs:comment>
        <rdfs:label>isGeneratedByDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isIdentifiedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isIdentifiedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:comment>BehaviourState is isIdentifiedBy Detection Method.</rdfs:comment>
        <rdfs:label>isIdentifiedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isImplementedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isImplementedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:comment>DetectionMethod isImplementedBy SoftwareApplication.

Usually, a specific logical Method (the &quot;Theft Logic&quot;) is implemented by one specific Software Application. While there could be two apps doing the same thing, it’s rarely efficient in IoT.</rdfs:comment>
        <rdfs:label>isImplementedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isIndicatorOf -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isIndicatorOf">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Device"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Livestock"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>Device can have some IndicatorOf of TheftIndicator</rdfs:label>
        <rdfs:label>isIndicatorOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isInfluencedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isInfluencedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
        <rdfs:comment>BehaviourState is influenced by some EnvironmentalConditions

isInfluencedBy (Active/Causal): This means the environment is changing the behavior.
Example: &quot;The sheep stopped grazing because the rain became a heavy storm.&quot;</rdfs:comment>
        <rdfs:label>isInfluencedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
        <rdfs:comment>BehaviourState is influencedBy some HealthCondition</rdfs:comment>
        <rdfs:label>isInfluencedByHealthCondition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isLocatedAtFarm -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isLocatedAtFarm">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
        <rdfs:comment>Livestock is located at a Farm</rdfs:comment>
        <rdfs:label>isLocatedAtFarm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isLocationOfIncident -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isLocationOfIncident">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:comment>Location isLocationOf some LivestockEvent</rdfs:comment>
        <rdfs:label>isLocationOfIncident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isManagedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isManagedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#ExtendedOfficer"/>
        <rdfs:comment>Livestock is managed by some ExtendedOfficer</rdfs:comment>
        <rdfs:label>isManagedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isMonitoredByDevice -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isMonitoredByDevice">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
        <rdfs:comment>Farm is managed by some Device</rdfs:comment>
        <rdfs:label>isMonitoredByDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isNearBoundary -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isNearBoundary">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Boundary"/>
        <rdfs:comment>Represent a spatial relationship between an entity (like a Livestock) and a specific Boundary instance.</rdfs:comment>
        <rdfs:label>isNearBoundary</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isNotifiedBySoftwareApp -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isNotifiedBySoftwareApp">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#notifies"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:comment>Participant(Farmer) is notified by some SoftwareApplication</rdfs:comment>
        <rdfs:label>isNotifiedBySoftwareApp</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isOwnedByFarmer -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isOwnedByFarmer">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#isOwnerOfLivestock"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
        <rdfs:comment>Livestock is Owned by some Farmer.</rdfs:comment>
        <rdfs:label>isOwnedByFarmer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isOwnerOfLivestock -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isOwnerOfLivestock">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:comment>Farmer is an owner of some Livestock.</rdfs:comment>
        <rdfs:label>isOwnerOfLivestock</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isPartOfLocation -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isPartOfLocation">
        <rdfs:comment>isPartOfLocation is used to ensure the LFTDO can accurately pinpoint anomalies, locations are modeled using a hierarchical &quot;Part-Whole&quot; relationship. This allows for spatial containment reasoning, where sub-locations (e.g., Kraal001) are logically nested within the parent Farm001.</rdfs:comment>
        <rdfs:label>isPartOfLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isRecordedIn -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isRecordedIn">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#recordsEvent"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#RoutineLogEvent"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SensorData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:label>RoutineLogEvent is recorded in the Database</rdfs:label>
        <rdfs:label>isRecordedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isSecurelyGuarded -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isSecurelyGuarded">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#EndDevice"/>
        <rdfs:comment>This an RestrictedArea or Location that is securely guarded by the EndDevices</rdfs:comment>
        <rdfs:label>isSecurelyGuarded</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isSensorOf -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isSensorOf">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Sensor"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
        <rdfs:label>Sensor isSensorOf some Device</rdfs:label>
        <rdfs:label>isSensorOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isStoredIn -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isStoredIn">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#storeData"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#RoutineLogEvent"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SensorData"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:comment>This ensures the reasoner knows that log events are meant for storage, keeping the communication channel (the SoftwareApplication) clear of &quot;noise&quot;.</rdfs:comment>
        <rdfs:label>isStoredIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isStoredOn -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isStoredOn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#CloudService"/>
        <rdfs:comment>Database is stored on some cloudservice</rdfs:comment>
        <rdfs:label>isStoredOn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isSupportedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isSupportedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>LivestockEvent is supportedby some LivestockIndicator</rdfs:comment>
        <rdfs:label>isSupportedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isTransitionedFrom -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isTransitionedFrom">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#transitionsTo"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>AbnormalBehaviour State is transitionedFrom some Normal Behaviour State</rdfs:comment>
        <rdfs:label>isTransitionedFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isTriggeredBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isTriggeredBy">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#triggers"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SystemEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Event(s) such as SystemEvent or LivestockEvent or LivestockIndicator are triggered by BehaviourState. 

A LivestockEvent is usually triggered by exactly one method. However, a SystemEvent (like a &quot;System Overload&quot;) might be triggered by many detection methods running at once. An event could also have zero detection methods if it was triggered manually by a human (Farmer).</rdfs:comment>
        <rdfs:label>isTriggeredBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isUsedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isUsedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#uses"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:comment>Algorithm is used by some DetectionMethod</rdfs:comment>
        <rdfs:label>isUsedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isUsedByFarmer -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isUsedByFarmer">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#usesFarm"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
        <rdfs:comment>A Farm is used by some Farmer for some Livestock keeping.</rdfs:comment>
        <rdfs:label>isUsedByFarmer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#isValidatedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#isValidatedBy">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#validateStatusOfEvent"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:comment>LivestockEvent isValidatedBy Farmer.</rdfs:comment>
        <rdfs:label>isValidatedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#logGeneratedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#logGeneratedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#RoutineLogEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:comment>RoutineLogEvent isGeneratedBy some Software</rdfs:comment>
        <rdfs:label>logGeneratedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#notifies -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#notifies">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:comment>Software Application notify some Participant</rdfs:comment>
        <rdfs:label>notifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#overridesStatus -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#overridesStatus">
        <rdfs:comment>Participant can override status provided by the System.
Allows the farmer to explicitly cancel the AI&apos;s choice.</rdfs:comment>
        <rdfs:label>overridesStatus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#produces -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#produces">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SystemEvent"/>
        <rdfs:comment>DetectionMethod produces some System Event</rdfs:comment>
        <rdfs:label>produces</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#receivesDataFrom -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#receivesDataFrom">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#CloudService"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#DataTransmission"/>
        <rdfs:comment>CloudService receive data from some Data Transmission</rdfs:comment>
        <rdfs:label>receivesDataFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#recordsEvent -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#recordsEvent">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SensorData"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SystemEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>LivestockIndicator or Software Application records some RoutineLogEvent in the Database.
The software writes to the log.</rdfs:comment>
        <rdfs:label>records</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#statusInitiatedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#statusInitiatedBy">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:comment>StatusUpdateEvent is initiated by some SoftwareApplication</rdfs:comment>
        <rdfs:label>statusUpdateInitiatedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#storeData -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#storeData">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#RoutineLogEvent"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SensorData"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Database stores some Data from Sensors, SystemLogs .e.t.c.</rdfs:comment>
        <rdfs:label>storeData</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#transitionsTo -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#transitionsTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
        <rdfs:comment>NormalState get transitioned to AbnormalState</rdfs:comment>
        <rdfs:label>transitionsTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#transmitSensorDataTo -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#transmitSensorDataTo">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#transmittedSensorDataFrom"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#DataTransmission"/>
        <rdfs:comment>Device(EndDevice) transmit some SensorDataTo a DataTransmission</rdfs:comment>
        <rdfs:label>transmitSensorDataTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#transmittedSensorDataFrom -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#transmittedSensorDataFrom">
        <rdfs:label>transmittedSensorDataFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#triggers -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#triggers">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SystemEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>BehaviourState or DetectionMethod triggers some Event(Livestock or System Event)

A DetectionMethod (like TheftDetection) may trigger zero events if everything is normal. However, if a theft is detected, it might trigger many events simultaneously (e.g., a TheftEvent for the farmer and a StatusUpdateEvent for the system log).</rdfs:comment>
        <rdfs:label>triggers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#uiUpdatedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#uiUpdatedBy">
        <owl:inverseOf rdf:resource="https://github.com/tumelomodise/LFTDO#updatesUI"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:label>SoftwareApplication&apos;s UI is updated by StatusUpdateEvent</rdfs:label>
        <rdfs:label>uiUpdatedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#updatesUI -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#updatesUI">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
        <rdfs:comment>StatusUpdateEvent updates some SoftwareApplication&apos;s UserInterface</rdfs:comment>
        <rdfs:label>updatesUI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#useDatabaseData -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#useDatabaseData">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
        <rdfs:comment>Machine Learning Algorithms uses some SensorData stored in the Database to analyse and make predictions.</rdfs:comment>
        <rdfs:label>useDatabaseData</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#uses -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#uses">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#DetectionMethod"/>
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#SoftwareApplication"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
        <rdfs:comment>TheftDetectionMethod uses some Algorithm
The software runs the code.</rdfs:comment>
        <rdfs:label>uses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#usesFarm -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#usesFarm">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
        <rdfs:comment>Farmer uses some Farm</rdfs:comment>
        <rdfs:label>usesFarm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#validateStatusOfEvent -->


    <owl:ObjectProperty rdf:about="https://github.com/tumelomodise/LFTDO#validateStatusOfEvent">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:range rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:comment>Farmer updates the status of some TheftEvent</rdfs:comment>
        <rdfs:label>validateStatusOfEvent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2002/07/owl#topDataProperty -->


    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#topDataProperty">
        <rdfs:label>topDataProperty</rdfs:label>
    </rdf:Description>
    


    <!-- https://github.com/tumelomodise/LFTDO#cloudServiceName -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#cloudServiceName">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#CloudService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>CloudService has a Name</rdfs:comment>
        <rdfs:label>cloudServiceName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasAge -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasAge">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Livestock has some Age</rdfs:comment>
        <rdfs:label>hasAge</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasAlgorithmName -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasAlgorithmName">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Any instance like Software, Database, Algorithm and has some name</rdfs:comment>
        <rdfs:label>hasName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasAlgorithmType -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasAlgorithmType">
        <rdfs:domain rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>hasAlgorithmType like e.g., Machine Learning or Threshold-based or Moving Average).</rdfs:comment>
        <rdfs:label>hasAlgorithmType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasAlgorithmVersion -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasAlgorithmVersion">
        <rdfs:label>hasAlgorithmVersion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/tumelomodise/LFTDO#hasAnimalID -->


    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#hasAnimalID">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
