            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#healthInfluencesBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasHealthDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSymptoms"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Sick is health condition</rdfs:comment>
        <rdfs:label>Sick</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Sitting -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Sitting">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>1.Sitting is a behaviour
2.Sitting can be a normal or abnormal behaviour state based on duration of sitting</rdfs:comment>
        <rdfs:label>Sitting</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SlaughterTheft -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SlaughterTheft">
