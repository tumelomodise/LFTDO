          rdfs:comment "The database is part of the cloud computing services for storing, accessing, and displaying data from livestock farming devices." ;
          rdfs:label "Database" .


###  https://github.com/tumelomodise/LFTDO#DetectionMethod
:DetectionMethod rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :analyses ;
                                   owl:someValuesFrom :Database
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :uses ;
                                   owl:someValuesFrom :Algorithm
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasDetectionMethodAccuracy ;
                                   owl:someValuesFrom xsd:decimal
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasDetectionMethodType ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasFalsePositiveRate ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasMethodAttribute ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTrainingData ;
                                   owl:someValuesFrom xsd:boolean
                                 ] ;
                 rdfs:comment """Detection Method: Represent the algorithms used to detect the theft events.
Sub-classes:
1.AudioMonitoringSystem
2.BehaviourMonitoringSystem
3.GPSTrackingSystem
4.VideoMonitoringSystem""" ;
                 rdfs:label "DetectionMethod" .


###  https://github.com/tumelomodise/LFTDO#Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceBatteryLife ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceCapacity ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceName ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDevicePrice ;
                          owl:someValuesFrom xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceSensorType ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceSerialNumber ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceType ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasManufacturerName ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasModulationFrequencyRange ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasModulationType ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPowerStatus ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDeviceID ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:integer
                        ] ;
        rdfs:comment """Device are different types of devices used in livestock farming for various reasons such as “autonomous real-time interaction” and collecting and exchanging of data between devices and software applications, this device includes sensors, end devices such as Radio Frequencies Identification(RFID), ear tags, collars, and end-user devices such as smartphones, communication gateways such as LoRagateway from different manufactures (Symeonaki et al., 2020). The devices are connected to the cloud for remote access.

Devices:
1.A Communication Gateway is a Device not fitted into a livestock and is connected to the internet(Cloud Computing Services)
2.End device is device attached to a livestock fitted with sensors 
3.Sensor is a Device that detect the changes on livestock and the environment
4.User device is a Device not fitted into a livestock 

Relationships:
1.A device is connected to one or more Cloud Computing Services
2.Some end device has some sensor
3.User devices are used by some Actors to track and monitor livestock""" ;
        rdfs:label "Device" .


###  https://github.com/tumelomodise/LFTDO#DistressVocalizations
:DistressVocalizations rdf:type owl:Class ;
                       rdfs:subClassOf :AbnormalState ,
                                       :BehaviourState ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isCharacterisedBy ;
                                         owl:someValuesFrom :TheftIndicator
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isCurrentBehaviourStateOf ;
                                         owl:someValuesFrom :Behaviour
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isInfluencedBy ;
                                         owl:someValuesFrom :EnvironmentalCondition
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isInfluencedByHealthCondition ;
                                         owl:someValuesFrom :HealthCondition
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasBehaviourStateConfidenceScore ;
                                         owl:someValuesFrom xsd:integer
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasBehaviourStateContext ;
                                         owl:someValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasBehaviourStateDescription ;
                                         owl:someValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasSeverityLevel ;
                                         owl:someValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasSpeed ;
                                         owl:someValuesFrom xsd:decimal
                                       ] ;
                       rdfs:comment "DistressVocalisation is an AbnormalState of Behaviour of Livestock" ;
                       rdfs:label "DistressVocalization" .


###  https://github.com/tumelomodise/LFTDO#Drinking
:Drinking rdf:type owl:Class ;
          rdfs:subClassOf :Behaviour ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :exhibitedBy ;
                            owl:someValuesFrom :Livestock
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasCurrentBehaviourState ;
                            owl:someValuesFrom :BehaviourState
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBehaviourStartTime ;
                            owl:someValuesFrom xsd:dateTime
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIntensity ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment """Referenced Ontology: Drinking = Drinking Behavior (ATOL:0000361) \"any measurable or observable characteristic related to the consumption of liquids ressources such as water or milk\" (Meunier-Salaün et. al,2015)
under: Animal trait of livestock ->pyschroneuroendocrinological state trait->ingestive behaviour->drinking behavior""" ;
          rdfs:label "Drinking" .


###  https://github.com/tumelomodise/LFTDO#EndDevice
:EndDevice rdf:type owl:Class ;
           rdfs:subClassOf :Device ,
