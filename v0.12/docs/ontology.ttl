###  https://github.com/tumelomodise/LFTDO#CattleWithFever
:CattleWithFever rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Cattle
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :experiences ;
                                                              owl:someValuesFrom :Fever
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :hasBodyTemperature ;
                                                              owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                   owl:onDatatype xsd:decimal ;
                                                                                   owl:withRestrictions ( [ xsd:minExclusive 39.3
                                                                                                          ]
                                                                                                        )
                                                                                 ]
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:comment "Cattle that hasBodyTemperature >= 39.4 celsius, is a Cattle with Fever" ;
                 rdfs:label "CattleWithFever" .


###  https://github.com/tumelomodise/LFTDO#CattleWithHighAbnormalBodyTempareture
:CattleWithHighAbnormalBodyTempareture rdf:type owl:Class ;
                                       owl:equivalentClass [ owl:intersectionOf ( :Cattle
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty :hasBodyTemperature ;
                                                                                    owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                         owl:onDatatype xsd:decimal ;
                                                                                                         owl:withRestrictions ( [ xsd:minExclusive 39.3
                                                                                                                                ]
                                                                                                                              )
                                                                                                       ]
                                                                                  ]
                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ] ;
                                       rdfs:comment """Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow's Body temperature
deviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. 

e.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [>=38,>39.3]""" ;
                                       rdfs:label "CattleWithHighAbnormalBodyTempareture" .


###  https://github.com/tumelomodise/LFTDO#CattleWithLowAbnormalBodyTempareture
:CattleWithLowAbnormalBodyTempareture rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( :Cattle
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :hasBodyTemperature ;
                                                                                   owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                        owl:onDatatype xsd:decimal ;
                                                                                                        owl:withRestrictions ( [ xsd:maxExclusive 38
                                                                                                                               ]
                                                                                                                             )
                                                                                                      ]
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      rdfs:comment """Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow's Body temperature
deviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. 

e.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [>=38,>39.3]""" ;
                                      rdfs:label "CattleWithLowAbnormalBodyTempareture" .


###  https://github.com/tumelomodise/LFTDO#CattleWithNormalBodyTempareture
:CattleWithNormalBodyTempareture rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( :Cattle
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasBodyTemperature ;
                                                                              owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                   owl:onDatatype xsd:decimal ;
                                                                                                   owl:withRestrictions ( [ xsd:minInclusive 38
                                                                                                                          ]
                                                                                                                          [ xsd:maxInclusive 39.3
                                                                                                                          ]
                                                                                                                        )
                                                                                                 ]
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:comment """Check the transition from normal to abnormal livestock Health condition when, for instance, a Cow's Body temperature
deviates from an normal body temperature of a healthy adult cow, which ranges from 38°C to 39.3°C, with an average of approximately 38.6°C.The the exceeded deviation from the norm could indicate synificant anomly and resulting in a potential theft or health alert issued to the farmer. 

e.g. Cattle with an Abnormal Body Temperatute has a hasBodyTemperature outside the normal range [>=38,>39.3]""" .


###  https://github.com/tumelomodise/LFTDO#CloudService
:CloudService rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :executesApplication ;
                                owl:someValuesFrom :SoftwareApplication
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hostsDatabase ;
                                owl:someValuesFrom :Database
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :cloudServiceName ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasCloudSecurityFeatures ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasCloudServiceDescription ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasCloudServiceProvider ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasCloudServiceType ;
                                owl:someValuesFrom xsd:string
                              ] ;
              rdfs:comment "Cloud Computing Service enables the on-demand and convenient delivery of shared configurable computing resources and services over a network (Kuo, 2011, Paul and Ghose, 2012). CC plays a key role in enabling the ability of IoT devices to send, store, analyze data, and receive analyzed data remotely. CC service includes machine learning algorithms to analyze livestock behavior to detect and indicate livestock theft." ;
              rdfs:label "CloudService" .


