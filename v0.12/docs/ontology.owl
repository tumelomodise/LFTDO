        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDatabaseAccessControl"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDatabaseBackupAndRecovery"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDatabaseSchema"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDatabaseStorageCapacity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDatabaseType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The database is part of the cloud computing services for storing, accessing, and displaying data from livestock farming devices.</rdfs:comment>
        <rdfs:label>Database</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#DetectionMethod -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#DetectionMethod">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#analyses"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Database"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#uses"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDetectionMethodAccuracy"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDetectionMethodType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasFalsePositiveRate"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasMethodAttribute"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTrainingData"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Detection Method: Represent the algorithms used to detect the theft events.
Sub-classes:
1.AudioMonitoringSystem
2.BehaviourMonitoringSystem
3.GPSTrackingSystem
4.VideoMonitoringSystem</rdfs:comment>
        <rdfs:label>DetectionMethod</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Device -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Device">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceBatteryLife"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceCapacity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDevicePrice"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceSensorType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceSerialNumber"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasManufacturerName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasModulationFrequencyRange"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasModulationType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasPowerStatus"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceID"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Device are different types of devices used in livestock farming for various reasons such as “autonomous real-time interaction” and collecting and exchanging of data between devices and software applications, this device includes sensors, end devices such as Radio Frequencies Identification(RFID), ear tags, collars, and end-user devices such as smartphones, communication gateways such as LoRagateway from different manufactures (Symeonaki et al., 2020). The devices are connected to the cloud for remote access.

Devices:
1.A Communication Gateway is a Device not fitted into a livestock and is connected to the internet(Cloud Computing Services)
2.End device is device attached to a livestock fitted with sensors 
3.Sensor is a Device that detect the changes on livestock and the environment
4.User device is a Device not fitted into a livestock 

Relationships:
1.A device is connected to one or more Cloud Computing Services
2.Some end device has some sensor
3.User devices are used by some Actors to track and monitor livestock</rdfs:comment>
        <rdfs:label>Device</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#DistressVocalizations -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#DistressVocalizations">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCharacterisedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#TheftIndicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateConfidenceScore"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateContext"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSeverityLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpeed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>DistressVocalisation is an AbnormalState of Behaviour of Livestock</rdfs:comment>
        <rdfs:label>DistressVocalization</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Drinking -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Drinking">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology: Drinking = Drinking Behavior (ATOL:0000361) &quot;any measurable or observable characteristic related to the consumption of liquids ressources such as water or milk&quot; (Meunier-Salaün et. al,2015)
under: Animal trait of livestock -&gt;pyschroneuroendocrinological state trait-&gt;ingestive behaviour-&gt;drinking behavior</rdfs:comment>
        <rdfs:label>Drinking</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#EndDevice -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#EndDevice">
