    <!-- https://github.com/tumelomodise/LFTDO#Algorithm001 -->


    <owl:NamedIndividual rdf:about="https://github.com/tumelomodise/LFTDO#Algorithm001">
        <rdf:type rdf:resource="https://github.com/tumelomodise/LFTDO#Algorithm"/>
        <isUsedBy rdf:resource="https://github.com/tumelomodise/LFTDO#TheftDetectionSystem"/>
        <owl:topDataProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.98</owl:topDataProperty>
        <hasAlgorithmType>Machine Learning</hasAlgorithmType>
        <hasAlgorithmVersion>v0.1</hasAlgorithmVersion>
        <hasComplexity>HIGH</hasComplexity>
        <isOptimized rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isOptimized>
        <rdfs:comment>Algorithm001</rdfs:comment>
        <rdfs:label>Algorithm001</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://github.com/tumelomodise/LFTDO#Algorithm002 -->


    <owl:NamedIndividual rdf:about="https://github.com/tumelomodise/LFTDO#Algorithm002">
