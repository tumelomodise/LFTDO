@prefix : <https://github.com/tumelomodise/LFTDO#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://github.com/tumelomodise/LFTDO#> .

<https://github.com/tumelomodise/LFTDO> rdf:type owl:Ontology ;
                                         owl:versionIRI <https://github.com/tumelomodise/LFTDO/v0.12> ;
                                         <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/" ;
                                         rdfs:comment """Livestock Farming Theft Detection Ontology(LFTDO)
Author: Tumelo Modise, 209332175,Date : 13 September 2023,
Updated: 01/03/2026
University: Tshwane University of Technology(TUT)
Subject:Masters of Computing in Computer Science 
Supervisors: Dr A Buitengdag,Dr Z Dawood,Prof J

Introduction
-----------------------------------------------------------------------------------------------------------
Livestock Farming Theft Detection Ontology(LFTDO) is a formal Livestock Farming ontology. The focus of the ontology will be on the agriculture domain for Livestock Theft Detection concepts.
The purpose of constructing this ontology is to provide a cognitive knowledge-based model for the Livestock Farming domain to be used by the farmers and veterinaries with a goal of Improving Livestock Farming Management to reduce livestock theft, and reducing cost. The ontology should be able to reason on the Livestock Behaviours to detect the abnormally provided by the devices fitted on the livestock with sensor  to infer potential theft to farmer.

Purpose
-----------------------------------------------------------------------------------------------------------
The purpose of Livestock Farming Theft Detection Ontology(LFTDO) is to integrate and analyze data from various sources, such as sensor networks, surveillance cameras, and databases, to identify suspicious activities that may indicate theft in a farming area. Furthermore, it enables livestock theft detection and prevention systems and applications to be accessible, flexible, transparent, interoperable, scalable, and cost effective.  
The aim is to assist with the early detection of livestock theft by providing a structured and standardized way of representing knowledge about livestock farming, including: 
1.Types of livestock
2.The vital components of livestock farming include ownership, farming areas, grazing areas, water sources, and technological resources (i.e. IoT devices, gateways, cloud computing, and machine-learning algorithms).
3.A variety of activities happening such as livestock movement, grazing, and feeding,
4.The people involved in livestock farming include farmers, extended-farmer officers, law enforcement agencies, and veterinarians.
5.A variety of events occurs in a farming area such as livestock theft   
LFTDO standardizes the data structures, integration, and knowledge representation of livestock farming by defining the concepts, entities, relationships, and rules governing them. The ontology should be able to reason livestock behaviour patterns and environmental conditions data provided to infer the possibility of livestock theft to alert livestock farmers and other stakeholders.""" ;
                                         owl:versionInfo 012 .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2002/07/owl#topObjectProperty
owl:topObjectProperty rdfs:label "owl:topObjectProperty" .


###  https://github.com/tumelomodise/LFTDO#InferredComplexTheftEvent
:InferredComplexTheftEvent rdf:type owl:ObjectProperty ;
                           rdfs:domain :TheftEvent ;
                           rdfs:label "InferredComplexTheftEvent" .


###  https://github.com/tumelomodise/LFTDO#OccursAtLocation
:OccursAtLocation rdf:type owl:ObjectProperty ;
                  rdfs:domain :EnvironmentalCondition ;
                  rdfs:range :Location ;
                  rdfs:comment "Some Enviromental Condition, TheftIndicator, TheftEvent Occurrs at some Location" ;
                  rdfs:label "OccursAtLocation" .


###  https://github.com/tumelomodise/LFTDO#accesses
:accesses rdf:type owl:ObjectProperty ;
          owl:inverseOf :isAccessedBy ;
          rdfs:domain :SoftwareApplication ;
          rdfs:range :Database ;
          rdfs:comment "SoftwareApplication accesses some Database" ;
          rdfs:label "accesses" .


###  https://github.com/tumelomodise/LFTDO#affectsLivestock
:affectsLivestock rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isAffectedBy ;
                  rdfs:domain :LivestockEvent ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( :Device
                                             :Livestock
                                             :Location
                                           )
                             ] ;
                  rdfs:comment "LivestockEvent affects some Location Livestock or Location or Device" ;
                  rdfs:label "affects" .


###  https://github.com/tumelomodise/LFTDO#analyses
:analyses rdf:type owl:ObjectProperty ;
          owl:inverseOf :isAnalysedBy ;
          rdfs:domain :DetectionMethod ;
          rdfs:range :Database ;
          rdfs:comment "DetectionMethod analyses Database data" ;
          rdfs:label "analyses" .


###  https://github.com/tumelomodise/LFTDO#atIncidentLocation
:atIncidentLocation rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isLocationOfIncident ;
                    rdfs:domain :LivestockEvent ;
                    rdfs:range :Location ;
                    rdfs:comment "LivestockEvent happens at  some Location" ;
                    rdfs:label "atIncidentLocation" .


###  https://github.com/tumelomodise/LFTDO#behaviourOccursAt
:behaviourOccursAt rdf:type owl:ObjectProperty ;
                   rdfs:domain :Behaviour ;
                   rdfs:range :Location ;
                   rdfs:comment "behaviour OccursAt some Location" ;
                   rdfs:label "behaviourOccursAt" .


###  https://github.com/tumelomodise/LFTDO#biologicallyAffects
:biologicallyAffects rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isBiologicallyAffectedBy ;
                     rdfs:domain :HealthCondition ;
                     rdfs:range :Livestock ;
                     rdfs:comment "HealthCondition biologicallyAffects some Livestock" ;
                     rdfs:label "biologicallyAffects" .


###  https://github.com/tumelomodise/LFTDO#causedBy
:causedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :TheftEvent ;
          rdfs:range :UnauthorisedPerson ;
          rdfs:comment "TheftEvent is caused by some UnauthorisedPerson an agentive cause (the intruder)" ;
          rdfs:label "causedBy" .


###  https://github.com/tumelomodise/LFTDO#characterises
:characterises rdf:type owl:ObjectProperty ;
               owl:inverseOf :isCharacterisedBy ;
               rdfs:domain :LivestockIndicator ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :BehaviourState
                                          :EnvironmentalCondition
                                          :HealthCondition
                                        )
                          ] ;
               rdfs:comment "Livestock Indicator characterises some BehaviourState" ;
               rdfs:label "characterises" .


###  https://github.com/tumelomodise/LFTDO#detects
:detects rdf:type owl:ObjectProperty ;
         owl:inverseOf :isDetectedBy ;
         rdfs:domain :DetectionMethod ;
         rdfs:range [ rdf:type owl:Class ;
                      owl:unionOf ( :LivestockIndicator
                                    :SystemEvent
                                  )
                    ] ;
         rdfs:comment "DetectictionMethod detects LivestockIndicators" ;
         rdfs:label "detects" .


###  https://github.com/tumelomodise/LFTDO#evidenceFor
:evidenceFor rdf:type owl:ObjectProperty ;
             owl:inverseOf :isSupportedBy ;
             rdfs:domain :LivestockIndicator ;
             rdfs:range :LivestockEvent ;
             rdfs:comment "LivestockIndicator provides evidenceFor some LivestockEvent" ;
             rdfs:label "evidenceFor" .


###  https://github.com/tumelomodise/LFTDO#executesApplication
:executesApplication rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isDeployedOn ;
                     rdfs:domain :CloudService ;
                     rdfs:range :SoftwareApplication ;
                     rdfs:comment "CloudService executes some Software Application" ;
                     rdfs:label "executesApplication" .


###  https://github.com/tumelomodise/LFTDO#exhibitedBy
:exhibitedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :exhibits ;
             rdfs:domain :Behaviour ;
             rdfs:range :Livestock ;
             rdfs:comment "Behaviour is exhibitedBy Livestock" ;
             rdfs:label "exhibitedBy" .


###  https://github.com/tumelomodise/LFTDO#exhibits
:exhibits rdf:type owl:ObjectProperty ;
          rdfs:domain :Livestock ;
          rdfs:range :Behaviour ;
          rdfs:comment "Livestock exhibit some Behaviour" ;
          rdfs:label "exhibits" .


###  https://github.com/tumelomodise/LFTDO#experienceEnvironmentalCondition
:experienceEnvironmentalCondition rdf:type owl:ObjectProperty ;
                                  rdfs:label "experienceEnvironmentalCondition" .


###  https://github.com/tumelomodise/LFTDO#experiences
:experiences rdf:type owl:ObjectProperty ;
             owl:inverseOf :isExperiencedBy ;
             rdfs:domain :Livestock ;
             rdfs:range :HealthCondition ;
             rdfs:label "Livestock experiences some HealthCondition" ,
                        "experiences" .


###  https://github.com/tumelomodise/LFTDO#externallyAffects
:externallyAffects rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isExternallyAffectedBy ;
                   rdfs:domain :EnvironmentalCondition ;
                   rdfs:range :Livestock ;
                   rdfs:comment "EnvironmentalCondition externallyAffects Livestock" ;
                   rdfs:label "externallyAffects" .


