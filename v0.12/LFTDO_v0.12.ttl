        LFTDO4:Goat ;
    rdfs:label "Goat002"^^xsd:string ;
    rdfs:comment "Goat002"^^xsd:string ;
    LFTDO4:exhibits LFTDO4:GoatBehaviour002 ;
    LFTDO4:hasAnimalID "Goat002"^^xsd:string ;
    LFTDO4:hasBreed "Alpine"^^xsd:string ;
    LFTDO4:hasCurrentLocation LFTDO4:PastureLocation001 ;
    LFTDO4:hasSpecies "Goat"^^xsd:string ;
    LFTDO4:isAttachedToDevice LFTDO4:GoatTrackerCollar002 ;
    LFTDO4:isLocatedAtFarm LFTDO4:Farm001 ;
    LFTDO4:isOwnedByFarmer LFTDO4:Farmer001 .

LFTDO4:Goat002.OLD a owl:NamedIndividual,
        LFTDO4:Goat,
        LFTDO4:Livestock ;
    rdfs:label "Goat002.OLD"^^xsd:string ;
    LFTDO4:exhibits LFTDO4:RestlessPacing,
        LFTDO4:SolitaryBehaviour ;
    LFTDO4:hasAnimalID "Goat002"^^xsd:string ;
    LFTDO4:hasBreed "Alpine"^^xsd:string ;
    LFTDO4:hasCurrentLocation LFTDO4:PastureLocation001 ;
    LFTDO4:hasSpecies "Goat"^^xsd:string ;
    LFTDO4:isSuspectedOfTheft false .

LFTDO4:Goat003 a owl:NamedIndividual,
        LFTDO4:Goat ;
    rdfs:label "Goat003" ;
