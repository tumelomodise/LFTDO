        LFTDO4:Sensor ;
    rdfs:label "GoatTrackerSensor099_1"^^xsd:string ;
    rdfs:comment "GoatTrackerSensor099_1"^^xsd:string ;
    LFTDO4:generatesData LFTDO4:GoatSensorData099 ;
