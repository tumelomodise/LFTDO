        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#triggers"/>
                        <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftState"/>
                        <swrl:argument2 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftEvent"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#inferredByRule"/>
                                <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftState"/>
                                <swrl:argument2>RL_FENCE_BREACH_THEFT_DIRECTION</swrl:argument2>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasHealthIndicator"/>
                                        <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftState"/>
                                        <swrl:argument2 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftIndicator"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateContext"/>
                                                <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftState"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#context"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#transitionsTo"/>
                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#NormState"/>
                                                        <swrl:argument2 rdf:resource="https://github.com/tumelomodise/LFTDO#HighSpeedTheftState"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Identifies when a resting state lasts longer than the baseline duration, suggesting injury or theft.</rdfs:comment>
        <rdfs:label>RL_PROLONGED_RESTING_DEVIATION</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
