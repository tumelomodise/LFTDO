                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#inferredByRule"/>
                                                        <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#UnusualMovement"/>
                                                        <swrl:argument2>RL_FENCE_BREACH_THEFT</swrl:argument2>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Triggers when device longitude falls below the minimum western coordinate.</rdfs:comment>
        <rdfs:label>RL_GEOFENCE_SOUTH</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasMinLat"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#currLoc"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#MinLat"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#dev"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasLatitude"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#dev"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#lat"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                                        <swrl:arguments rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#lat"/>
                                                            <rdf:Description rdf:about="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#MinLat"/>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#isAttachedToDevice"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#s"/>
                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#dev"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentLocation"/>
                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#s"/>
                                                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#currLoc"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
                                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#currLoc"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#isOutsideGeofence"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#s"/>
