                       :hasDetectionPriority 1 ;
                       :hasID "DET-HEALTH-001" ;
                       :hasLastScanTime "2024-02-15T13:05:02"^^xsd:dateTime ;
                       :hasReliabilityScore 5 ;
                       :hasSensitivityLevel "High" ;
                       :hasTrainingData "true"^^xsd:boolean ;
                       :isDetectionActive "true"^^xsd:boolean ;
                       rdfs:label "HealthDetectionMethod" .


