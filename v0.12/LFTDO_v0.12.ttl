    owl:members ( LFTDO4:CommunicationGateway LFTDO4:EndDevice LFTDO4:Sensor LFTDO4:UserDevice ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:NormalSheepRunningState LFTDO4:NormalSheepWanderingState ) .

[] a swrl:Imp ;
    rdfs:label "RL_NORMALGRAZING_BASELINE"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Validates normal activity if duration and speed stay within the sheep's grazing baseline."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :NormSheepGrazingState ;
                            swrl:argument2 :baseSpeed ;
                            swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :sensorComp ;
                                    swrl:classPredicate LFTDO4:Sensor ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :sensorData ;
                                            swrl:classPredicate LFTDO4:SensorData ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                    swrl:argument1 :sensorData ;
                                                    swrl:argument2 :speed ;
                                                    swrl:propertyPredicate LFTDO4:hasValue ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :NormSheepGrazingState ;
                                                            swrl:argument2 :baseDuration ;
                                                            swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 :dev ;
                                                                    swrl:argument2 :sensorComp ;
                                                                    swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 :dev ;
                                                                            swrl:classPredicate LFTDO4:Device ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 :grazing ;
                                                                                    swrl:argument2 :NormSheepGrazingState ;
                                                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                            swrl:arguments ( :speed :baseSpeed ) ;
                                                                                            swrl:builtin swrlb:lessThanOrEqual ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                    swrl:argument1 :sensorComp ;
                                                                                                    swrl:argument2 :sensorData ;
                                                                                                    swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                            swrl:argument1 :grazing ;
                                                                                                            swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 :sensorData ;
                                                                                                                    swrl:argument2 "m/s"^^xsd:string ;
                                                                                                                    swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                                            swrl:argument1 :NormSheepGrazingState ;
                                                                                                                            swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                    swrl:argument2 :dev ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                            swrl:argument1 :NormSheepGrazingState ;
                                                                                                                                            swrl:argument2 :context ;
                                                                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                    swrl:argument1 :grazing ;
                                                                                                                                                    swrl:argument2 :duration ;
                                                                                                                                                    swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                                            swrl:argument2 false ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                                                    swrl:argument2 :grazing ;
                                                                                                                                                                    swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 LFTDO4:NormalActivityIndicator ;
                    swrl:argument2 "RL_NORMALGRAZING_BASELINE"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 :NormSheepGrazingState ;
                            swrl:argument2 LFTDO4:NormalActivityIndicator ;
                            swrl:propertyPredicate LFTDO4:isCharacterisedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :sensorData ;
                                    swrl:argument2 LFTDO4:NormalActivityIndicator ;
                                    swrl:propertyPredicate LFTDO4:isExtractedTo ] ;
                            rdf:rest () ] ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_FENCE_BREACH_THEFT"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Combines \"OutsideFence\" status with \"AbnormalState\" to confirm an active theft."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :NormState ;
                            swrl:argument2 :baseDuration ;
                            swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :NormState ;
                                    swrl:argument2 :baseSpeed ;
                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :dev ;
                                            swrl:classPredicate LFTDO4:Device ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :s ;
                                                    swrl:argument2 :running ;
                                                    swrl:propertyPredicate LFTDO4:exhibits ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:ClassAtom ;
                                                            swrl:argument1 :NormState ;
                                                            swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 :running ;
                                                                    swrl:argument2 :NormState ;
                                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                            swrl:arguments ( :Duration :baseDuration ) ;
                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                    swrl:arguments ( :Speed :baseSpeed ) ;
                                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                            swrl:argument1 :NormState ;
                                                                                            swrl:argument2 :context ;
                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                    swrl:argument1 :s ;
                                                                                                    swrl:argument2 :dev ;
                                                                                                    swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                            swrl:argument1 :running ;
                                                                                                            swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 :s ;
                                                                                                                    swrl:argument2 true ;
                                                                                                                    swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                            swrl:argument1 :running ;
                                                                                                                            swrl:argument2 :Duration ;
                                                                                                                            swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                    swrl:argument2 :Speed ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasRunningSpeed ] ;
                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 LFTDO4:UnusualMovement ;
                    swrl:argument2 :context ;
                    swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 LFTDO4:UnusualMovement ;
                            swrl:argument2 LFTDO4:HighSpeedTheftIndicator ;
                            swrl:propertyPredicate LFTDO4:isCharacterisedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :NormState ;
                                    swrl:argument2 LFTDO4:UnusualMovement ;
                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 LFTDO4:UnusualMovement ;
                                            swrl:argument2 LFTDO4:HighSpeedTheftEvent ;
                                            swrl:propertyPredicate LFTDO4:triggers ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                    swrl:argument1 LFTDO4:UnusualMovement ;
                                                    swrl:argument2 "RL_FENCE_BREACH_THEFT"^^xsd:string ;
                                                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                                            rdf:rest () ] ] ] ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_STATE_ABNORMAL_TRANSITION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Uses speed/baseline math to move any livestock  from a \"Normal\" to \"Abnormal\" state."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:BuiltinAtom ;
                    swrl:arguments ( :result1 :sp :bv ) ;
                    swrl:builtin swrlb:subtract ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:BuiltinAtom ;
                            swrl:arguments [ a rdf:List ;
                                    rdf:first :result3 ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first :result2 ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first 100 ;
                                                    rdf:rest () ] ] ] ;
                            swrl:builtin swrlb:multiply ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :ggs ;
                                    swrl:argument2 :sp ;
                                    swrl:propertyPredicate LFTDO4:hasSpeed ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:BuiltinAtom ;
                                            swrl:arguments ( :result2 :result1 :sp ) ;
                                            swrl:builtin swrlb:divide ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 :ggs ;
                                                    swrl:classPredicate LFTDO4:GoatGrazingState ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :ggs ;
                                                            swrl:argument2 :dv ;
                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateDeviation ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                    swrl:arguments ( :result3 :dv ) ;
                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                            swrl:argument1 :ggs ;
                                                                            swrl:argument2 :bv ;
                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 :ggs ;
                    swrl:argument2 LFTDO4:UnsualGoatMovement ;
                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:UnsualGoatMovement ;
                            swrl:argument2 "RL_STATE_ABNORMAL_TRANSITION"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest () ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_PROLONGED_RESTING_DEVIATION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Identifies when a resting state lasts longer than the baseline duration, suggesting injury or theft."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :NormState ;
                            swrl:argument2 :baseDuration ;
                            swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :NormState ;
                                    swrl:argument2 :baseSpeed ;
                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :dev ;
                                            swrl:classPredicate LFTDO4:Device ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :resting ;
                                                    swrl:argument2 :NormState ;
                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                            swrl:arguments ( :Speed :baseSpeed ) ;
                                                            swrl:builtin swrlb:equal ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 :s ;
                                                                    swrl:argument2 :resting ;
                                                                    swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 :resting ;
                                                                            swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                    swrl:argument1 :NormState ;
                                                                                    swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                            swrl:arguments ( :Duration :baseDuration ) ;
                                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                    swrl:argument1 :NormState ;
                                                                                                    swrl:argument2 :context ;
                                                                                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                            swrl:argument1 :s ;
                                                                                                            swrl:argument2 :dev ;
                                                                                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 :s ;
                                                                                                                    swrl:argument2 false ;
                                                                                                                    swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                            swrl:argument1 :running ;
                                                                                                                            swrl:argument2 :Duration ;
                                                                                                                            swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                    swrl:argument2 :Speed ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasRunningSpeed ] ;
                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 :NormState ;
                    swrl:argument2 LFTDO4:UnusualHealthState ;
                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:UnusualHealthState ;
                            swrl:argument2 "RL_PROLONGED_RESTING_DEVIATION"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 LFTDO4:UnusualHealthState ;
                                    swrl:argument2 :context ;
                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 LFTDO4:UnusualHealthState ;
                                            swrl:argument2 LFTDO4:LethargyIndicator ;
                                            swrl:propertyPredicate LFTDO4:hasHealthIndicator ] ;
                                    rdf:rest () ] ] ] ] .

[] a owl:AllDisjointClasses ;
    owl:members ( LFTDO4:Algorithm LFTDO4:Database LFTDO4:DetectionMethod LFTDO4:SoftwareApplication ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:NormalSheepGrazingState LFTDO4:NormalSheepWanderingState ) .

[] a owl:AllDisjointClasses ;
    owl:members ( LFTDO4:Behaviour LFTDO4:BehaviourState LFTDO4:CloudService LFTDO4:DataTransmission LFTDO4:Device LFTDO4:EnvironmentalCondition LFTDO4:HealthCondition LFTDO4:Livestock LFTDO4:LivestockIndicator LFTDO4:Location LFTDO4:Participant LFTDO4:SensorData ) .

[] a swrl:Imp ;
    rdfs:label "RL_GOAT_ANOMALY_TRANSITION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Detects abnormal goat behavior  (speed vs. grazing baseline) and transitions state to \"Abnormal\"."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:BuiltinAtom ;
                    swrl:arguments ( :result1 :sp :bv ) ;
                    swrl:builtin swrlb:subtract ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:BuiltinAtom ;
                            swrl:arguments [ a rdf:List ;
                                    rdf:first :result3 ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first :result2 ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first 100 ;
                                                    rdf:rest () ] ] ] ;
                            swrl:builtin swrlb:multiply ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :ggs ;
                                    swrl:argument2 :sp ;
                                    swrl:propertyPredicate LFTDO4:hasSpeed ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :g ;
                                            swrl:classPredicate LFTDO4:Grazing ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :g ;
                                                    swrl:argument2 :ggs ;
                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                            swrl:arguments ( :result2 :result1 :sp ) ;
                                                            swrl:builtin swrlb:divide ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :ggs ;
                                                                    swrl:classPredicate LFTDO4:GoatGrazingState ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                            swrl:argument1 :ggs ;
                                                                            swrl:argument2 :dv ;
                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateDeviation ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                    swrl:arguments ( :result3 :dv ) ;
                                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 :ls ;
                                                                                            swrl:argument2 :g ;
                                                                                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                    swrl:argument1 :ls ;
                                                                                                    swrl:classPredicate LFTDO4:Livestock ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                            swrl:argument1 :ggs ;
                                                                                                            swrl:argument2 :bv ;
                                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 LFTDO4:UnsualGoatMovement ;
                    swrl:argument2 "RL_GOAT_ANOMALY_TRANSITION"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 :ggs ;
                            swrl:argument2 LFTDO4:UnsualGoatMovement ;
                            swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                    rdf:rest () ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_GEOFENCE_SOUTH"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Triggers when device longitude falls below the minimum western coordinate."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :currLoc ;
                            swrl:argument2 :MinLat ;
                            swrl:propertyPredicate LFTDO4:hasMinLat ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :dev ;
                                    swrl:classPredicate LFTDO4:Device ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 :dev ;
                                            swrl:argument2 :lat ;
                                            swrl:propertyPredicate LFTDO4:hasLatitude ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:BuiltinAtom ;
                                                    swrl:arguments ( :lat :MinLat ) ;
                                                    swrl:builtin swrlb:lessThan ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :s ;
                                                            swrl:argument2 :dev ;
                                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 :s ;
                                                                    swrl:argument2 :currLoc ;
                                                                    swrl:propertyPredicate LFTDO4:hasCurrentLocation ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 :currLoc ;
                                                                            swrl:classPredicate LFTDO4:Location ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :s ;
                    swrl:argument2 true ;
                    swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :s ;
                            swrl:argument2 "RL_GEOFENCE_SOUTH"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest () ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_PROXIMITY_INFERENCE"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Inferred RBox Axiom: If livestock is adjacent to a boundary, it is asserted as \"NearBoundary\"."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 :ls ;
                    swrl:argument2 :b ;
                    swrl:propertyPredicate LFTDO4:isAdjacentTo ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 :ls ;
                            swrl:argument2 :isLocatedIn ;
                            swrl:propertyPredicate LFTDO4:hasCurrentLocation ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :ls ;
                                    swrl:classPredicate LFTDO4:Livestock ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :isLocatedIn ;
                                            swrl:classPredicate LFTDO4:Location ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :ls ;
                    swrl:argument2 "RL_PROXIMITY_INFERENCE"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 :ls ;
                            swrl:argument2 :b ;
                            swrl:propertyPredicate LFTDO4:isNearBoundary ] ;
                    rdf:rest () ] ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:NormalSheepRestingState LFTDO4:NormalSheepWanderingState ) .

[] a swrl:Imp ;
    rdfs:label "RL_GEO_FENCE_MAXLON_EAST"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Triggers when a livestock device reports a longitude exceeding the eastern boundary."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :dev ;
                            swrl:argument2 :lon ;
                            swrl:propertyPredicate LFTDO4:hasLongitude ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :dev ;
                                    swrl:classPredicate LFTDO4:Device ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 :s ;
                                            swrl:argument2 :dev ;
                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :s ;
                                                    swrl:argument2 :currLoc ;
                                                    swrl:propertyPredicate LFTDO4:hasCurrentLocation ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :currLoc ;
                                                            swrl:argument2 :MaxLon ;
                                                            swrl:propertyPredicate LFTDO4:hasMaxLon ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                    swrl:arguments ( :lon :MaxLon ) ;
                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 :currLoc ;
                                                                            swrl:classPredicate LFTDO4:Location ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :s ;
                    swrl:argument2 true ;
                    swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :s ;
                            swrl:argument2 "RL_GEO_FENCE_MAXLON_EAST"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest () ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_PROLONGED_RESTING_DEVIATION_INTENSITY"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment ""^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :sensorComp ;
                            swrl:classPredicate LFTDO4:Sensor ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :sensorData ;
                                    swrl:argument2 :movementIntensity ;
                                    swrl:propertyPredicate LFTDO4:hasValue ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :sensorData ;
                                            swrl:classPredicate LFTDO4:SensorData ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                    swrl:argument1 :NormState ;
                                                    swrl:argument2 :baseDuration ;
                                                    swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :dev ;
                                                            swrl:argument2 :sensorComp ;
                                                            swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                    swrl:argument1 :resting ;
                                                                    swrl:argument2 :Duration ;
                                                                    swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 :dev ;
                                                                            swrl:classPredicate LFTDO4:Device ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 :sensorComp ;
                                                                                    swrl:argument2 :sensorData ;
                                                                                    swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 :resting ;
                                                                                            swrl:argument2 :NormState ;
                                                                                            swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                    swrl:argument1 :s ;
                                                                                                    swrl:argument2 :resting ;
                                                                                                    swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                            swrl:argument1 :resting ;
                                                                                                            swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                    swrl:argument1 :NormState ;
                                                                                                                    swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                            swrl:argument1 :NormState ;
                                                                                                                            swrl:argument2 :baseIntensity ;
                                                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                    swrl:argument1 :sensorData ;
                                                                                                                                    swrl:argument2 "m/s"^^xsd:string ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                            swrl:arguments ( :Duration :baseDuration ) ;
                                                                                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                                    swrl:arguments ( :movementIntensity :baseIntensity ) ;
                                                                                                                                                    swrl:builtin swrlb:lessThan ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                            swrl:argument1 :NormState ;
                                                                                                                                                            swrl:argument2 :context ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                                                    swrl:argument2 :dev ;
                                                                                                                                                                    swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                                                            swrl:argument2 false ;
                                                                                                                                                                            swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 LFTDO4:UnusualRestingState ;
                    swrl:argument2 "RL_PROLONGED_RESTING_DEVIATION_INTENSITY"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:UnusualRestingState ;
                            swrl:argument2 :context ;
                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :NormState ;
                                    swrl:argument2 LFTDO4:UnusualRestingState ;
                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 LFTDO4:UnusualRestingState ;
                                            swrl:argument2 LFTDO4:LethargyIndicator ;
                                            swrl:propertyPredicate LFTDO4:hasHealthIndicator ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 LFTDO4:UnusualRestingState ;
                                                    swrl:argument2 LFTDO4:HighHealthAlertEvent ;
                                                    swrl:propertyPredicate LFTDO4:triggers ] ;
                                            rdf:rest () ] ] ] ] ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:NormalSheepGrazingState LFTDO4:NormalSheepRunningState_Midnight ) .

[] a swrl:Imp ;
    rdfs:label "RL_BEHAVIOUR_DEVIATION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Calculates the percentage deviation of current speed  vs. baseline. Triggers if it exceeds the set threshold."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:BuiltinAtom ;
                    swrl:arguments ( :result1 :sp :bv ) ;
                    swrl:builtin swrlb:subtract ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 :r ;
                            swrl:argument2 :crs ;
                            swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:BuiltinAtom ;
                                    swrl:arguments [ a rdf:List ;
                                            rdf:first :result3 ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first :result2 ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first 100 ;
                                                            rdf:rest () ] ] ] ;
                                    swrl:builtin swrlb:multiply ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:BuiltinAtom ;
                                            swrl:arguments ( :result2 :result1 :sp ) ;
                                            swrl:builtin swrlb:divide ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 :crs ;
                                                    swrl:classPredicate LFTDO4:CattleRunningState ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :crs ;
                                                            swrl:argument2 :dv ;
                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateDeviation ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                    swrl:arguments ( :result3 :dv ) ;
                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 :ls ;
                                                                            swrl:argument2 :r ;
                                                                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                    swrl:argument1 :crs ;
                                                                                    swrl:argument2 :bv ;
                                                                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                            swrl:argument1 :ls ;
                                                                                            swrl:classPredicate LFTDO4:Livestock ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                    swrl:argument1 :r ;
                                                                                                    swrl:classPredicate LFTDO4:Running ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                            swrl:argument1 :crs ;
                                                                                                            swrl:argument2 :sp ;
                                                                                                            swrl:propertyPredicate LFTDO4:hasSpeed ] ;
                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 LFTDO4:UnusualCowMovement ;
                    swrl:argument2 "RL_BEHAVIOUR_DEVIATION"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 LFTDO4:UnusualCowMovement ;
                            swrl:argument2 LFTDO4:HighCattleBehaviourTheftIndicator002 ;
                            swrl:propertyPredicate LFTDO4:isCharacterisedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :crs ;
                                    swrl:argument2 LFTDO4:UnusualCowMovement ;
                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                            rdf:rest () ] ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_SUSPICIOUS_RESTLESS_INQUIRY"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Flags livestock as IsSuspectedOfTheft if it exhibits Restless behaviour at an isolation location."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :restless ;
                    swrl:classPredicate LFTDO4:Restless ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 :ls ;
                            swrl:argument2 :isolation ;
                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :ls ;
                                    swrl:argument2 :restless ;
                                    swrl:propertyPredicate LFTDO4:exhibits ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :sameLocation ;
                                            swrl:classPredicate LFTDO4:Location ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 :isolation ;
                                                    swrl:classPredicate LFTDO4:Isolation ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :ls ;
                                                            swrl:argument2 :sameLocation ;
                                                            swrl:propertyPredicate LFTDO4:hasCurrentLocation ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :ls ;
                                                                    swrl:classPredicate LFTDO4:Livestock ] ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :ls ;
                    swrl:argument2 "RL_SUSPICIOUS_RESTLESS_INQUIRY"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :ls ;
                            swrl:argument2 true ;
                            swrl:propertyPredicate LFTDO4:isSuspectedOfTheft ] ;
                    rdf:rest () ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_SYSTEM_INTEGRITY_CHECK"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Verifies device/system integrity, flags UnknownState if device is offline or unresponsive. Enables sabotage detection."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :d ;
                    swrl:argument2 false ;
                    swrl:propertyPredicate LFTDO4:isDeviceOnline ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :d ;
                            swrl:classPredicate LFTDO4:Device ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 LFTDO4:SabotageTheftIndicator001 ;
                    swrl:argument2 "RL_SYSTEM_INTEGRITY_CHECK"^^xsd:string ;
                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :d ;
                            swrl:argument2 "DeviceOfflineWarning"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:hasSystemStatus ] ;
                    rdf:rest () ] ] .

[] a owl:AllDisjointClasses ;
    owl:members ( LFTDO4:Behaviour LFTDO4:CloudService LFTDO4:DataTransmission LFTDO4:Device LFTDO4:EnvironmentalCondition LFTDO4:HealthCondition LFTDO4:LivestockEvent LFTDO4:Location LFTDO4:Participant LFTDO4:SystemEvent ) .

[] a owl:Axiom ;
    rdfs:comment "The actual speed this Goat001 is running/moving. This will executed again the different build SWRL e.g. TransitionFromNormalBehaviour state to Abnormal if the Baseline value and the allowed Deviation percentage has been exceeded." ;
    owl:annotatedProperty LFTDO4:hasSpeed ;
    owl:annotatedSource LFTDO4:GoatGrazingState1 ;
    owl:annotatedTarget 2.5 .

[] a swrl:Imp ;
    rdfs:label "RL_ESCAPED"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment ""^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :sensorComp ;
                            swrl:classPredicate LFTDO4:Sensor ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :statusEventUpd ;
                                    swrl:classPredicate LFTDO4:StatusUpdateEvent ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :sensorData ;
                                            swrl:classPredicate LFTDO4:SensorData ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                    swrl:argument1 :sensorData ;
                                                    swrl:argument2 :speed ;
                                                    swrl:propertyPredicate LFTDO4:hasValue ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :dev ;
                                                            swrl:argument2 :sensorComp ;
                                                            swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :dev ;
                                                                    swrl:classPredicate LFTDO4:Device ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                            swrl:arguments ( :speed :baseSpeed ) ;
                                                                            swrl:builtin swrlb:lessThanOrEqual ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 :sensorComp ;
                                                                                    swrl:argument2 :sensorData ;
                                                                                    swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 :s ;
                                                                                            swrl:argument2 :statusEventUpd ;
                                                                                            swrl:propertyPredicate LFTDO4:hasCurrentStatus ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                    swrl:argument1 :NormSheepWanderingState ;
                                                                                                    swrl:argument2 :baseDuration ;
                                                                                                    swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                            swrl:argument1 :wandering ;
                                                                                                            swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                    swrl:argument1 :s ;
                                                                                                                    swrl:argument2 :wandering ;
                                                                                                                    swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                            swrl:argument1 :sensorData ;
                                                                                                                            swrl:argument2 "m/s"^^xsd:string ;
                                                                                                                            swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                    swrl:argument1 :wandering ;
                                                                                                                                    swrl:argument2 :NormSheepWanderingState ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                            swrl:argument2 :dev ;
                                                                                                                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                    swrl:argument1 :NormSheepWanderingState ;
                                                                                                                                                    swrl:argument2 :baseSpeed ;
                                                                                                                                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                            swrl:argument1 :statusEventUpd ;
                                                                                                                                                            swrl:argument2 "Pending"^^xsd:string ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:hasStatus ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                                                                    swrl:argument1 :NormSheepWanderingState ;
                                                                                                                                                                    swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                                                            swrl:argument2 true ;
                                                                                                                                                                            swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                                    swrl:argument1 :wandering ;
                                                                                                                                                                                    swrl:argument2 :duration ;
                                                                                                                                                                                    swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 LFTDO4:EscapedSheepState ;
                    swrl:argument2 LFTDO4:EscapedEvent ;
                    swrl:propertyPredicate LFTDO4:triggers ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:EscapedSheepState ;
                            swrl:argument2 "RL_ESCAPED"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :NormSheepWanderingState ;
                                    swrl:argument2 LFTDO4:EscapedSheepState ;
                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                            rdf:rest () ] ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_MODERATEHEAT_CONTEXT"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Triggers when the device latitude exceeds the defined maximum northern coordinate."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :Loc ;
                    swrl:classPredicate LFTDO4:Location ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 :t ;
                            swrl:argument2 :v ;
                            swrl:propertyPredicate LFTDO4:hasEnvValue ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:BuiltinAtom ;
                                    swrl:arguments [ a rdf:List ;
                                            rdf:first :v ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first 34.9 ;
                                                    rdf:rest () ] ] ;
                                    swrl:builtin swrlb:lessThanOrEqual ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 :t ;
                                            swrl:argument2 :Loc ;
                                            swrl:propertyPredicate LFTDO4:OccursAtLocation ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 :t ;
                                                    swrl:classPredicate LFTDO4:AmbientTemperature ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :t ;
                                                            swrl:argument2 "DayTime"^^xsd:string ;
                                                            swrl:propertyPredicate LFTDO4:hasTemporalContext ] ;
                                                    rdf:rest () ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :t ;
                    swrl:classPredicate LFTDO4:ModerateAmbientTemperature ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:LowEnvTheftIndicator001 ;
                            swrl:argument2 "RL_MODERATEHEAT_CONTEXT"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 LFTDO4:DayAmbientTemp001 ;
                                    swrl:argument2 LFTDO4:LowEnvTheftIndicator001 ;
                                    swrl:propertyPredicate LFTDO4:isCharacterisedBy ] ;
                            rdf:rest () ] ] ] .

[] a owl:AllDisjointClasses ;
    owl:members ( LFTDO4:Cattle LFTDO4:Goat LFTDO4:Sheep ) .

[] a owl:AllDisjointClasses ;
    owl:members ( LFTDO4:ExtendedOfficer LFTDO4:Farmer LFTDO4:LawEnforcementAgency LFTDO4:UnauthorisedPerson LFTDO4:Veterinarian ) .

[] a owl:Axiom ;
    rdfs:comment "UnusualRestingState (Warning)" ;
    owl:annotatedProperty LFTDO4:hasDuration ;
    owl:annotatedSource LFTDO4:SheepResting088 ;
    owl:annotatedTarget 4500.0 .

[] a swrl:Imp ;
    rdfs:label "RL_COMPLEXTHEFT_CORRELATION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Combines and relates the location, behaviour, and environmental context to verify and the confirm high-confidence complex theft event."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 :normalState ;
                    swrl:argument2 :baseV ;
                    swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 :cattle ;
                            swrl:argument2 :dev ;
                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :sensorComp ;
                                    swrl:classPredicate LFTDO4:Sensor ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :running ;
                                            swrl:classPredicate LFTDO4:Running ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 :sensorData ;
                                                    swrl:classPredicate LFTDO4:SensorData ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :dev ;
                                                            swrl:argument2 :sensorComp ;
                                                            swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :dev ;
                                                                    swrl:classPredicate LFTDO4:Device ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                            swrl:argument1 :sensorData ;
                                                                            swrl:argument2 "km/h"^^xsd:string ;
                                                                            swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 :sensorComp ;
                                                                                    swrl:argument2 :sensorData ;
                                                                                    swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                            swrl:arguments ( :speedFraction :speedDif :cSpeed ) ;
                                                                                            swrl:builtin swrlb:divide ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                                    swrl:arguments ( :speedDifPercentage :baseDiv ) ;
                                                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                            swrl:arguments ( :speedDif :cSpeed :baseV ) ;
                                                                                                            swrl:builtin swrlb:subtract ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 :normalState ;
                                                                                                                    swrl:argument2 :baseDiv ;
                                                                                                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateDeviation ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                                            swrl:argument1 :cattle ;
                                                                                                                            swrl:classPredicate LFTDO4:Livestock ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                    swrl:argument1 :running ;
                                                                                                                                    swrl:argument2 :normalState ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                            swrl:arguments [ a rdf:List ;
                                                                                                                                                    rdf:first :speedDifPercentage ;
                                                                                                                                                    rdf:rest [ a rdf:List ;
                                                                                                                                                            rdf:first :speedFraction ;
                                                                                                                                                            rdf:rest [ a rdf:List ;
                                                                                                                                                                    rdf:first 100 ;
                                                                                                                                                                    rdf:rest () ] ] ] ;
                                                                                                                                            swrl:builtin swrlb:multiply ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                    swrl:argument1 :sensorData ;
                                                                                                                                                    swrl:argument2 :cSpeed ;
                                                                                                                                                    swrl:propertyPredicate LFTDO4:hasValue ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                                            swrl:argument1 :cattle ;
                                                                                                                                                            swrl:argument2 :running ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                                                                    swrl:argument1 :normalState ;
                                                                                                                                                                    swrl:classPredicate LFTDO4:CattleRunningState ] ;
                                                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 :normalState ;
                    swrl:argument2 LFTDO4:HighSpeedTheftState ;
                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                            swrl:argument2 "RL_COMPLEXTHEFT_CORRELATION"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :dev ;
                                    swrl:argument2 "Complex Theft Event detected: Multiple biological indicators to be verified"^^xsd:string ;
                                    swrl:propertyPredicate LFTDO4:hasSystemStatus ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                                            swrl:argument2 LFTDO4:HighSpeedTheftIndicator ;
                                            swrl:propertyPredicate LFTDO4:isCharacterisedBy ] ;
                                    rdf:rest () ] ] ] ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:NormalSheepRestingState LFTDO4:NormalSheepRunningState ) .

[] a owl:Axiom ;
    rdfs:comment """This is base line value of  the maximum Goat Speed of 1.5m/s
N.B: This values be added into application parameters and can be adjusted to as needed.""" ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource LFTDO4:GoatGrazingState ;
    owl:annotatedTarget [ a owl:Restriction ;
            owl:hasValue 1.5 ;
            owl:onProperty LFTDO4:hasBehaviourStateBaselineValues ] .

[] a swrl:Imp ;
    rdfs:label "RL_THEFT_IN_PROGRESS"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Classifies an active theft in progress based on combined fence breach and behavioural anomaly."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :sensorComp ;
                            swrl:classPredicate LFTDO4:Sensor ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :statusEventUpd ;
                                    swrl:classPredicate LFTDO4:StatusUpdateEvent ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 :sensorData ;
                                            swrl:classPredicate LFTDO4:SensorData ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                    swrl:argument1 :sensorData ;
                                                    swrl:argument2 :speed ;
                                                    swrl:propertyPredicate LFTDO4:hasValue ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :dev ;
                                                            swrl:argument2 :sensorComp ;
                                                            swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :dev ;
                                                                    swrl:classPredicate LFTDO4:Device ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 :s ;
                                                                            swrl:argument2 :running ;
                                                                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 :sensorComp ;
                                                                                    swrl:argument2 :sensorData ;
                                                                                    swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 :s ;
                                                                                            swrl:argument2 :statusEventUpd ;
                                                                                            swrl:propertyPredicate LFTDO4:hasCurrentStatus ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                    swrl:argument1 :NormSheeprunningState ;
                                                                                                    swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                            swrl:argument1 :running ;
                                                                                                            swrl:argument2 :duration ;
                                                                                                            swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 :sensorData ;
                                                                                                                    swrl:argument2 "m/s"^^xsd:string ;
                                                                                                                    swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                            swrl:argument1 :s ;
                                                                                                                            swrl:argument2 :dev ;
                                                                                                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                    swrl:argument1 :statusEventUpd ;
                                                                                                                                    swrl:argument2 "Pending"^^xsd:string ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasStatus ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                            swrl:argument1 :NormSheeprunningState ;
                                                                                                                                            swrl:argument2 :baseSpeed ;
                                                                                                                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                                    swrl:argument1 :running ;
                                                                                                                                                    swrl:argument2 :NormSheeprunningState ;
                                                                                                                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                            swrl:argument1 :NormSheeprunningState ;
                                                                                                                                                            swrl:argument2 :baseDuration ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                                                                    swrl:argument1 :running ;
                                                                                                                                                                    swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                                                            swrl:arguments ( :speed :baseSpeed ) ;
                                                                                                                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                                                                    swrl:argument2 true ;
                                                                                                                                                                                    swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 LFTDO4:HighSpeedTheftState ;
                    swrl:argument2 LFTDO4:HighSpeedTheftEvent ;
                    swrl:propertyPredicate LFTDO4:triggers ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                            swrl:argument2 "RL_THEFT_IN_PROGRESS"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 :NormSheeprunningState ;
                                    swrl:argument2 LFTDO4:HighSpeedTheftState ;
                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                            rdf:rest () ] ] ] .

[] a swrl:Imp ;
    rdfs:label "RL_LIVESTOCK_FEVER_DETECTION"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "For Livestock the rule uses threshold to detects body temp greater and equals to (for e.g. Cattle39.4°C) and links it to a FeverIndicator.  This assist to prevents movement due fever being misclassified as theft."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :sensorComp ;
                    swrl:classPredicate LFTDO4:Sensor ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :sensorData ;
                            swrl:classPredicate LFTDO4:SensorData ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 :sensorData ;
                                    swrl:argument2 "Celsius"^^xsd:string ;
                                    swrl:propertyPredicate LFTDO4:hasUoM ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 :dev ;
                                            swrl:argument2 :sensorComp ;
                                            swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 :dev ;
                                                    swrl:classPredicate LFTDO4:Device ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 :ls ;
                                                            swrl:argument2 :anyBehaviour ;
                                                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 :sensorComp ;
                                                                    swrl:argument2 :sensorData ;
                                                                    swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 :anyBehaviour ;
                                                                            swrl:argument2 :NormState ;
                                                                            swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                    swrl:argument1 :sensorData ;
                                                                                    swrl:argument2 :cTemp ;
                                                                                    swrl:propertyPredicate LFTDO4:hasValue ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                            swrl:argument1 :ls ;
                                                                                            swrl:classPredicate LFTDO4:Livestock ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                    swrl:argument1 :anyBehaviour ;
                                                                                                    swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                            swrl:argument1 :NormState ;
                                                                                                            swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 :NormState ;
                                                                                                                    swrl:argument2 :baseTemp ;
                                                                                                                    swrl:propertyPredicate LFTDO4:hasBaseLineTemp ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                            swrl:argument1 :ls ;
                                                                                                                            swrl:argument2 :dev ;
                                                                                                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                    swrl:arguments ( :cTemp :baseTemp ) ;
                                                                                                                                    swrl:builtin swrlb:greaterThanOrEqual ] ;
                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 :NormState ;
                    swrl:argument2 LFTDO4:UnusualHealthState ;
                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 LFTDO4:UnusualHealthState ;
                            swrl:argument2 "RL_LIVESTOCK_FEVER_DETECTION"^^xsd:string ;
                            swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 LFTDO4:UnusualHealthState ;
                                    swrl:argument2 LFTDO4:HighHealthAlertEvent ;
                                    swrl:propertyPredicate LFTDO4:triggers ] ;
                            rdf:rest () ] ] ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( LFTDO4:NormalSheepGrazingState LFTDO4:NormalSheepRestingState ) .

[] a swrl:Imp ;
    rdfs:label "RL_FENCE_BREACH_THEFT_SIGNAL"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Detects theft by combining fence breach with signal loss or jamming indicator."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :sensorComp ;
                            swrl:classPredicate LFTDO4:Sensor ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 :sensorData ;
                                    swrl:classPredicate LFTDO4:SensorData ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 :NormState ;
                                            swrl:argument2 :baseDuration ;
                                            swrl:propertyPredicate LFTDO4:hasDurationBaseline ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :dev ;
                                                    swrl:argument2 :sensorComp ;
                                                    swrl:propertyPredicate LFTDO4:hasComponent ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 :resting ;
                                                            swrl:argument2 :Duration ;
                                                            swrl:propertyPredicate LFTDO4:hasDuration ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 :dev ;
                                                                    swrl:classPredicate LFTDO4:Device ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 :sensorComp ;
                                                                            swrl:argument2 :sensorData ;
                                                                            swrl:propertyPredicate LFTDO4:generatesData ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 :resting ;
                                                                                    swrl:argument2 :NormState ;
                                                                                    swrl:propertyPredicate LFTDO4:hasCurrentBehaviourState ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 :s ;
                                                                                            swrl:argument2 :resting ;
                                                                                            swrl:propertyPredicate LFTDO4:exhibits ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                    swrl:argument1 :resting ;
                                                                                                    swrl:classPredicate LFTDO4:Behaviour ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                            swrl:argument1 :NormState ;
                                                                                                            swrl:classPredicate LFTDO4:BehaviourState ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 :NormState ;
                                                                                                                    swrl:argument2 :baseSignalStrength ;
                                                                                                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateBaselineValues ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                            swrl:arguments ( :SignalStrength :baseSignalStrength ) ;
                                                                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                    swrl:argument1 :sensorData ;
                                                                                                                                    swrl:argument2 "dBm"^^xsd:string ;
                                                                                                                                    swrl:propertyPredicate LFTDO4:hasUoM ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                            swrl:arguments ( :Duration :baseDuration ) ;
                                                                                                                                            swrl:builtin swrlb:greaterThan ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                    swrl:argument1 :NormState ;
                                                                                                                                                    swrl:argument2 :context ;
                                                                                                                                                    swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                                                                            swrl:argument1 :s ;
                                                                                                                                                            swrl:argument2 :dev ;
                                                                                                                                                            swrl:propertyPredicate LFTDO4:isAttachedToDevice ] ;
                                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                    swrl:argument1 :s ;
                                                                                                                                                                    swrl:argument2 false ;
                                                                                                                                                                    swrl:propertyPredicate LFTDO4:isOutsideGeofence ] ;
                                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                                            swrl:argument1 :sensorData ;
                                                                                                                                                                            swrl:argument2 :SignalStrength ;
                                                                                                                                                                            swrl:propertyPredicate LFTDO4:hasValue ] ;
                                                                                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 LFTDO4:HighSpeedTheftState ;
                    swrl:argument2 LFTDO4:HighSpeedTheftEvent ;
                    swrl:propertyPredicate LFTDO4:triggers ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                            swrl:argument2 LFTDO4:HighSpeedTheftIndicator ;
                            swrl:propertyPredicate LFTDO4:hasHealthIndicator ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 LFTDO4:HighSpeedTheftState ;
                                    swrl:argument2 "RL_FENCE_BREACH_THEFT_SIGNAL"^^xsd:string ;
                                    swrl:propertyPredicate LFTDO4:inferredByRule ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                            swrl:argument1 LFTDO4:HighSpeedTheftState ;
                                            swrl:argument2 :context ;
                                            swrl:propertyPredicate LFTDO4:hasBehaviourStateContext ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 :NormState ;
                                                    swrl:argument2 LFTDO4:HighSpeedTheftState ;
                                                    swrl:propertyPredicate LFTDO4:transitionsTo ] ;
                                            rdf:rest () ] ] ] ] ] .

