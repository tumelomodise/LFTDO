LFTDO4:SheepWithFever a owl:Class ;
    rdfs:label "SheepWithFever" ;
    rdfs:comment "Sheep  that hasBodyTemperature >= 40 celsius, is a Sheep with Fever" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( LFTDO4:Sheep [ a owl:Restriction ;
                        owl:onProperty LFTDO4:experiences ;
                        owl:someValuesFrom LFTDO4:Fever ] [ a owl:Restriction ;
                        owl:onProperty LFTDO4:hasBodyTemperature ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minExclusive 39.3 ] ) ] ] ) ] .

LFTDO4:Sick a owl:Class ;
    rdfs:label "Sick" ;
    rdfs:comment "Sick is health condition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSymptoms ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasHealthDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:healthInfluencesBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        LFTDO4:HealthCondition .

LFTDO4:SlaughterTheft001 a owl:NamedIndividual,
        LFTDO4:SlaughterTheft ;
    rdfs:label "SlaughterTheft001" ;
    rdfs:comment "SlaughterTheft001" .

LFTDO4:SuspiciousEvent a owl:Class ;
    rdfs:label "SuspiciousEvent" ;
    rdfs:comment "SuspiciousEvent: Is trigged by some SuspiciousIndicator that is identified as a Livestock Behaviour changes that could indicate suspicious activities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:isTriggeredBy ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventResolution ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventStatus ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTheftEventTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue "High" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Low" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] [ a owl:Restriction ;
                        owl:hasValue "Medium" ;
                        owl:onProperty LFTDO4:triggersAlertLevel ] ) ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:affectsLivestock ;
            owl:someValuesFrom LFTDO4:Livestock ],
        LFTDO4:LivestockEvent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty LFTDO4:hasAbnormalBehaviourState ;
                        owl:someValuesFrom LFTDO4:AbnormalState ] [ a owl:Restriction ;
                        owl:onProperty LFTDO4:isAlertInitiatedBy ;
                        owl:someValuesFrom LFTDO4:SuspiciousIndicator ] ) ] .

LFTDO4:TechnicalIndicator a owl:Class ;
    rdfs:subClassOf LFTDO4:LivestockIndicator .

LFTDO4:TheftOfLivestockProducts a owl:Class ;
    rdfs:label "TheftOfLivestockProducts" ;
    rdfs:comment "The theft of livestock-derived products (e.g., milk, wool, meat)." ;
    rdfs:subClassOf LFTDO4:TheftEvent .

LFTDO4:VideoMonitoringSystem a owl:Class ;
    rdfs:label "VideoMonitoringSystem" ;
    rdfs:comment "VideoMonitoringSystem is a theft DetectionMethod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasMethodAttribute ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTrainingData ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:analyses ;
            owl:someValuesFrom LFTDO4:Database ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDetectionMethodType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasFalsePositiveRate ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:uses ;
            owl:someValuesFrom LFTDO4:Algorithm ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDetectionMethodAccuracy ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:DetectionMethod .

LFTDO4:accesses a owl:ObjectProperty ;
    rdfs:label "accesses" ;
    rdfs:comment "SoftwareApplication accesses some Database" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range LFTDO4:Database ;
    owl:inverseOf LFTDO4:isAccessedBy .

LFTDO4:atIncidentLocation a owl:ObjectProperty ;
    rdfs:label "atIncidentLocation" ;
    rdfs:comment "LivestockEvent happens at  some Location" ;
    rdfs:domain LFTDO4:LivestockEvent ;
    rdfs:range LFTDO4:Location ;
    owl:inverseOf LFTDO4:isLocationOfIncident .

LFTDO4:behaviourOccursAt a owl:ObjectProperty ;
    rdfs:label "behaviourOccursAt" ;
    rdfs:comment "behaviour OccursAt some Location" ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range LFTDO4:Location .

LFTDO4:biologicallyAffects a owl:ObjectProperty ;
    rdfs:label "biologicallyAffects" ;
    rdfs:comment "HealthCondition biologicallyAffects some Livestock" ;
    rdfs:domain LFTDO4:HealthCondition ;
    rdfs:range LFTDO4:Livestock ;
    owl:inverseOf LFTDO4:isBiologicallyAffectedBy .

LFTDO4:characterises a owl:ObjectProperty ;
    rdfs:label "characterises" ;
    rdfs:comment "Livestock Indicator characterises some BehaviourState" ;
    rdfs:domain LFTDO4:LivestockIndicator ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( LFTDO4:BehaviourState LFTDO4:EnvironmentalCondition LFTDO4:HealthCondition ) ] ;
    owl:inverseOf LFTDO4:isCharacterisedBy .

LFTDO4:detects a owl:ObjectProperty ;
    rdfs:label "detects" ;
    rdfs:comment "DetectictionMethod detects LivestockIndicators" ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( LFTDO4:LivestockIndicator LFTDO4:SystemEvent ) ] ;
    owl:inverseOf LFTDO4:isDetectedBy .

LFTDO4:evidenceFor a owl:ObjectProperty ;
    rdfs:label "evidenceFor" ;
    rdfs:comment "LivestockIndicator provides evidenceFor some LivestockEvent" ;
    rdfs:domain LFTDO4:LivestockIndicator ;
    rdfs:range LFTDO4:LivestockEvent ;
    owl:inverseOf LFTDO4:isSupportedBy .

LFTDO4:experienceEnvironmentalCondition a owl:ObjectProperty ;
    rdfs:label "experienceEnvironmentalCondition" .

LFTDO4:externallyAffects a owl:ObjectProperty ;
    rdfs:label "externallyAffects" ;
    rdfs:comment "EnvironmentalCondition externallyAffects Livestock" ;
    rdfs:domain LFTDO4:EnvironmentalCondition ;
    rdfs:range LFTDO4:Livestock ;
    owl:inverseOf LFTDO4:isExternallyAffectedBy .

LFTDO4:generatesLog a owl:ObjectProperty ;
    rdfs:label "generatesLog" ;
    rdfs:comment "SoftwareApplication generate some RoutineLog" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range LFTDO4:RoutineLogEvent ;
    owl:inverseOf LFTDO4:logGeneratedBy .

LFTDO4:hasAccessTo a owl:ObjectProperty ;
    rdfs:label "hasAccessTo" ;
    rdfs:comment "Participant has access to some SoftwareApplication" ;
    rdfs:domain LFTDO4:Participant ;
    rdfs:range LFTDO4:SoftwareApplication .

LFTDO4:hasAlgorithmType a owl:DatatypeProperty ;
    rdfs:label "hasAlgorithmType" ;
    rdfs:comment "hasAlgorithmType like e.g., Machine Learning or Threshold-based or Moving Average)." ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range xsd:string .

LFTDO4:hasAlgorithmVersion a owl:DatatypeProperty ;
    rdfs:label "hasAlgorithmVersion" .

LFTDO4:hasBaseLineHeadingDirection a owl:DatatypeProperty ;
    rdfs:label "hasBaseLineHeadingDirection" ;
    rdfs:comment "Baseline Heading direction to check if Livestock is moving away from define GeoLocation for to justify if its almost due East (90°), moving directly away from the farm center." ;
    rdfs:domain LFTDO4:NormalState ;
    rdfs:range xsd:decimal .

LFTDO4:hasBaseLineHeadingDirectionUoM a owl:DatatypeProperty ;
    rdfs:label "hasBaseLineHeadingDirectionUoM" ;
    rdfs:comment "baseLineHeadingDirectionUoM" ;
    rdfs:domain LFTDO4:NormalState ;
    rdfs:range xsd:string .

LFTDO4:hasBaseLineSignalStrength a owl:DatatypeProperty ;
    rdfs:label "hasBaseLineSignalStrength" ;
    rdfs:comment "Signal Strength inidcaites the normal baseline for received signal strength indicator(RSSI) for e.g. a very weak RSSI, indicates the collar is nearing the edge of the network range." ;
    rdfs:domain LFTDO4:NormalState ;
    rdfs:range xsd:decimal .

LFTDO4:hasBaseLineSignalStrengthUoM a owl:DatatypeProperty ;
    rdfs:label "hasBaseLineSignalStrengthUoM" ;
    rdfs:comment "Measured in dBm (decibels-milliwatts)" ;
    rdfs:domain LFTDO4:NormalState ;
    rdfs:range xsd:string .

LFTDO4:hasBaseLineTempUoM a owl:DatatypeProperty ;
    rdfs:label "hasBaseLineTempUoM" ;
    rdfs:range xsd:string .

LFTDO4:hasBaseLineType a owl:DatatypeProperty ;
    rdfs:label "hasBaseLineType" ;
    rdfs:range xsd:string .

LFTDO4:hasBaselinePostureUoM a owl:DatatypeProperty ;
    rdfs:label "hasBaselinePostureUoM" ;
    rdfs:comment "Ensures the unit matches the Gyroscope output." ;
    rdfs:range xsd:string .

LFTDO4:hasBaselineStepCountUoM a owl:DatatypeProperty ;
    rdfs:label "hasBaselineStepCountUoM" ;
    rdfs:comment "Ensures the unit matches the Pedometer output." ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasBehaviourEndTime a owl:DatatypeProperty ;
    rdfs:label "hasBehaviourEndTime" ;
    rdfs:comment "Behaviour has EndTime" ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasBirthDate a owl:DatatypeProperty ;
    rdfs:label "hasBirthDate" ;
    rdfs:comment "Livestock has some birthdate." ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasCity a owl:DatatypeProperty ;
    rdfs:label "hasCity" ;
    rdfs:comment "Location has a City" ;
    rdfs:domain LFTDO4:Location ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasCloudServiceCost a owl:DatatypeProperty ;
    rdfs:label "hasCloudServiceCost" ;
    rdfs:comment "CloudService has some Cost" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasComplexity a owl:DatatypeProperty ;
    rdfs:label "hasComplexity" ;
    rdfs:comment "hasComplexity such as HIGH. LOW, MEDIUM" ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range xsd:string .

LFTDO4:hasDataOutputType a owl:DatatypeProperty ;
    rdfs:label "hasDataOutputType" ;
    rdfs:comment """DataTransmission has some data output type.
Identifies if the data is "GPS Coordinates," "Accelerometer G-force," or "Battery Level.\"""" ;
    rdfs:domain LFTDO4:DataTransmission ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDetectionLatencyMs a owl:DatatypeProperty ;
    rdfs:label "hasDetectionLatencyMs" ;
    rdfs:comment "How many milliseconds it takes to process the data. This proves \"Real-time\" capability for theft." ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range xsd:decimal .

LFTDO4:hasDetectionPriority a owl:DatatypeProperty ;
    rdfs:label "hasDetectionPriority" ;
    rdfs:comment "A \"Theft\" detection should have a higher priority than a \"Low Battery\" warning." ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range xsd:integer .

LFTDO4:hasDetectionThreshold a owl:DatatypeProperty ;
    rdfs:label "hasDetectionThreshold" ;
    rdfs:comment "Confidence level required to trigger" ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range xsd:decimal .

LFTDO4:hasDevice a owl:ObjectProperty ;
    rdfs:label "hasDevice" ;
    rdfs:comment "Farm hasDevice" ;
    rdfs:domain LFTDO4:Farm ;
    rdfs:range LFTDO4:Device .

LFTDO4:hasDeviceDescription a owl:DatatypeProperty ;
    rdfs:label "hasDeviceDescription" ;
    rdfs:comment "Device has some Description" ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDeviceProtocol a owl:DatatypeProperty ;
    rdfs:label "hasDeviceProtocol" ;
    rdfs:comment "Device has some DeviceProtocol" ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasEncryptionStandard a owl:DatatypeProperty ;
    rdfs:label "hasEncryptionStandard" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range xsd:string .

LFTDO4:hasEnvUnit a owl:DatatypeProperty ;
    rdfs:label "hasEnvUnit" ;
    rdfs:comment """Unit of measure e.g. Celsius
"°C", "%\"""" ;
    rdfs:domain LFTDO4:EnvironmentalCondition .

LFTDO4:hasEnvironmentalContext a owl:ObjectProperty ;
    rdfs:label "hasEnvironmentalContext" ;
    rdfs:comment "BehaviourState has some EnvironmentalCondition Context" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range LFTDO4:EnvironmentalCondition ;
    owl:inverseOf LFTDO4:isContextOf .

LFTDO4:hasEventDateTime a owl:DatatypeProperty ;
    rdfs:label "hasEventDateTime" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range xsd:dateTime .

LFTDO4:hasExecutionTimeMs a owl:DatatypeProperty ;
    rdfs:label "hasExecutionTimeMs" ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range xsd:decimal .

LFTDO4:hasFarmID a owl:DatatypeProperty ;
    rdfs:label "hasFarmID" ;
    rdfs:comment "Farm has FarmID" ;
    rdfs:domain LFTDO4:Farm ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasFarmName a owl:DatatypeProperty ;
    rdfs:label "hasFarmName" ;
    rdfs:comment "Farm has a name" ;
    rdfs:domain LFTDO4:Farm ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasFarmSizeInHa a owl:DatatypeProperty ;
    rdfs:label "hasFarmSizeInHa" ;
    rdfs:comment "Farm has Size In Hectors" ;
    rdfs:domain LFTDO4:Farm ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasHealthStatus a owl:DatatypeProperty ;
    rdfs:domain LFTDO4:HealthCondition ;
    rdfs:range xsd:string .

LFTDO4:hasID a owl:DatatypeProperty ;
    rdfs:label "hasID" ;
    rdfs:comment "Generic Identification to identify instances or individuals." ;
    rdfs:range xsd:string .

LFTDO4:hasLastBackup a owl:DatatypeProperty ;
    rdfs:label "hasLastBackup" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range xsd:dateTime .

LFTDO4:hasLastScanTime a owl:DatatypeProperty ;
    rdfs:label "hasLastScanTime" ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range xsd:dateTime .

LFTDO4:hasLastSeenTimestamp a owl:DatatypeProperty ;
    rdfs:label "hasLastSeenTimestamp" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:dateTime .

LFTDO4:hasLastSyncTime a owl:DatatypeProperty ;
    rdfs:label "hasLastSyncTime" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range xsd:dateTime .

LFTDO4:hasLastUpdateTimestamp a owl:DatatypeProperty ;
    rdfs:label "hasLastUpdateTimestamp" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:dateTime .

LFTDO4:hasLivestockIndicator a owl:ObjectProperty ;
    rdfs:label "hasLivestockIndicator" ;
    rdfs:comment "LivestockIndicators are indicated by some Livestock Abnormal Behaviour or Device or Health or Environment conditions" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:AbnormalState LFTDO4:Device LFTDO4:EnvironmentalCondition LFTDO4:HealthCondition ) ] ;
    rdfs:range LFTDO4:LivestockIndicator .

LFTDO4:hasManufacturerDate a owl:DatatypeProperty ;
    rdfs:label "hasManufacturerDate" ;
    rdfs:comment "The device has the manufacture date." ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasMobilityScore a owl:DatatypeProperty ;
    rdfs:label "hasMobilityScore" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:integer .

LFTDO4:hasMovementDistance a owl:DatatypeProperty ;
    rdfs:label "hasMovementDistance" ;
    rdfs:comment "Behaviour has some Movement distance covered." ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasMovementDuration a owl:DatatypeProperty ;
    rdfs:label "hasMovementDuration" ;
    rdfs:comment "Livestock has some average movement duration." ;
    rdfs:domain LFTDO4:Behaviour ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasPartLocation a owl:ObjectProperty ;
    rdfs:label "hasPartLocation" ;
    rdfs:comment "The standard inverse for an \"isPartOfLocation\" relationship is typically named hasPartLocation." .

LFTDO4:hasParticipantEmail a owl:DatatypeProperty ;
    rdfs:label "hasParticipantEmail" ;
    rdfs:domain LFTDO4:Participant ;
    rdfs:range xsd:string .

LFTDO4:hasProvince a owl:DatatypeProperty ;
    rdfs:label "hasProvince" ;
    rdfs:comment "Location has some province e.g. Gauteng." ;
    rdfs:domain LFTDO4:Location ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasReliabilityScore a owl:DatatypeProperty ;
    rdfs:label "hasReliabilityScore" ;
    rdfs:comment "A weight given to the method based on historical performance." ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range xsd:decimal .

LFTDO4:hasResponseTimeMs a owl:DatatypeProperty ;
    rdfs:label "hasResponseTimeMs" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range xsd:decimal .

LFTDO4:hasSensitivityLevel a owl:DatatypeProperty ;
    rdfs:label "hasSensitivityLevel" ;
    rdfs:comment "SensitivityLevel like \"High\", \"Medium\", \"Low\"" ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range xsd:string .

LFTDO4:hasSensorType a owl:DatatypeProperty ;
    rdfs:label "hasSensorType" ;
    rdfs:comment "Sensor hasSensorType" ;
    rdfs:domain LFTDO4:Sensor ;
    rdfs:range xsd:string .

LFTDO4:hasStorageCapacity a owl:DatatypeProperty ;
    rdfs:label "hasStorageCapacity" ;
    rdfs:comment "To define the limits of the RoutineLogEvent storage." ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:decimal .

LFTDO4:hasTheftEventLocation a owl:ObjectProperty ;
    rdfs:label "hasTheftEventLocation" ;
    rdfs:comment "TheftEvent happens at some Location" ;
    rdfs:domain LFTDO4:TheftEvent ;
    rdfs:range LFTDO4:Location .

LFTDO4:hasTheftEventReport a owl:DatatypeProperty ;
    rdfs:label "hasTheftEventReport" ;
    rdfs:domain LFTDO4:TheftEvent ;
    rdfs:range xsd:string .

LFTDO4:hasTransmissionTimeStamp a owl:DatatypeProperty ;
    rdfs:label "hasTransmissionTimeStamp" ;
    rdfs:domain LFTDO4:SensorData ;
    rdfs:range xsd:dateTime .

LFTDO4:hasUpdateFrequency a owl:DatatypeProperty ;
    rdfs:label "hasUpdateFrequency" ;
    rdfs:comment """hasUpdateFrequency

hasUpdateFrequency ∈ {
  "real-time",
  "near-real-time",
  "secondly",
  "sub-minute",
  "minutely",
  "five-minute",
  "quarter-hourly",
  "half-hourly",
  "hourly",
  "daily",
  "on-demand",
  "event-driven",
  "irregular"
}""" ;
    rdfs:domain LFTDO4:StatusUpdateEvent ;
    rdfs:range xsd:string .

LFTDO4:hasUptimeGuarantee a owl:DatatypeProperty ;
    rdfs:label "hasUptimeGuarantee" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf LFTDO4:hasCloudSecurityFeatures .

LFTDO4:hasValidationStatus a owl:DatatypeProperty ;
    rdfs:label "hasValidationStatus" ;
    rdfs:comment "Event has hasValidationStatus, \"Confirmed\" or \"Rejected\"/\"Ignored\" from Participant" .

LFTDO4:identifies a owl:ObjectProperty ;
    rdfs:label "identifies" ;
    rdfs:comment "DetectionMethod identifies some BehaviourState" ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range LFTDO4:BehaviourState ;
    owl:inverseOf LFTDO4:isIdentifiedBy .

LFTDO4:indicatedBy a owl:ObjectProperty ;
    rdfs:label "indicatedBy" ;
    rdfs:comment "TheftIndicator is indicated by some Abnorma behaviour state" ;
    rdfs:domain LFTDO4:TheftIndicator ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( LFTDO4:AbnormalState LFTDO4:EnvironmentalCondition LFTDO4:HealthCondition ) ] .

LFTDO4:influences a owl:ObjectProperty ;
    rdfs:label "influences" ;
    rdfs:comment "EnvironmentalCondition influences Livestock Behaviour." ;
    rdfs:domain LFTDO4:EnvironmentalCondition ;
    rdfs:range LFTDO4:BehaviourState ;
    owl:inverseOf LFTDO4:isInfluencedBy .

LFTDO4:initiateStatusUpdate a owl:ObjectProperty ;
    rdfs:label "initiateStatusUpdate" ;
    rdfs:comment "Software Application initiate some StatusUpdateEvent" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range LFTDO4:StatusUpdateEvent ;
    owl:inverseOf LFTDO4:statusInitiatedBy .

LFTDO4:isCloudEncrypted a owl:DatatypeProperty ;
    rdfs:comment "isCloudEncrypted" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf LFTDO4:hasCloudSecurityFeatures .

LFTDO4:isCloudServiceScalable a owl:DatatypeProperty ;
    rdfs:label "isCloudServiceScalable" ;
    rdfs:comment """is CloudService Scalable?
True/False: The system can handle horizontal or vertical growth.""" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:isDetectionActive a owl:DatatypeProperty ;
    rdfs:label "isDetectionActive" ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range xsd:boolean .

LFTDO4:isElectronicIdentified a owl:DatatypeProperty ;
    rdfs:label "isElectronicIdentified" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:boolean .

LFTDO4:isExtractedFrom a owl:ObjectProperty ;
    rdfs:label "isExtractedFrom" ;
    rdfs:comment "LivestockIndicator isExtractedFom some SensorData" ;
    rdfs:domain LFTDO4:LivestockIndicator ;
    rdfs:range LFTDO4:SensorData ;
    owl:inverseOf LFTDO4:isExtractedTo .

LFTDO4:isIndicatorOf a owl:ObjectProperty ;
    rdfs:label "Device can have some IndicatorOf of TheftIndicator",
        "isIndicatorOf" ;
    rdfs:domain LFTDO4:LivestockIndicator ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( LFTDO4:Device LFTDO4:Livestock ) ] .

LFTDO4:isManagedBy a owl:ObjectProperty ;
    rdfs:label "isManagedBy" ;
    rdfs:comment "Livestock is managed by some ExtendedOfficer" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range LFTDO4:ExtendedOfficer .

LFTDO4:isNotifiedBySoftwareApp a owl:ObjectProperty ;
    rdfs:label "isNotifiedBySoftwareApp" ;
    rdfs:comment "Participant(Farmer) is notified by some SoftwareApplication" ;
    rdfs:domain LFTDO4:Participant ;
    rdfs:range LFTDO4:SoftwareApplication ;
    owl:inverseOf LFTDO4:notifies .

LFTDO4:isOnline a owl:DatatypeProperty ;
    rdfs:label "isOnline" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range xsd:boolean .

LFTDO4:isOptimized a owl:DatatypeProperty ;
    rdfs:label "isOptimized" ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range xsd:boolean .

LFTDO4:isPartOfLocation a owl:ObjectProperty ;
    rdfs:label "isPartOfLocation" ;
    rdfs:comment "isPartOfLocation is used to ensure the LFTDO can accurately pinpoint anomalies, locations are modeled using a hierarchical \"Part-Whole\" relationship. This allows for spatial containment reasoning, where sub-locations (e.g., Kraal001) are logically nested within the parent Farm001." .

LFTDO4:isRecordedIn a owl:ObjectProperty ;
    rdfs:label "RoutineLogEvent is recorded in the Database",
        "isRecordedIn" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:LivestockEvent LFTDO4:RoutineLogEvent LFTDO4:SensorData ) ] ;
    rdfs:range LFTDO4:Database ;
    owl:inverseOf LFTDO4:recordsEvent .

LFTDO4:isRemoteArea a owl:DatatypeProperty ;
    rdfs:label "isRemoteArea" ;
    rdfs:comment "Determine if the Location is remote or rural area?" ;
    rdfs:domain LFTDO4:Location ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:isResolved a owl:DatatypeProperty ;
    rdfs:label "isResolved" ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range xsd:boolean .

LFTDO4:isSensorCalibrated a owl:DatatypeProperty ;
    rdfs:label "isSensorCalibrated" ;
    rdfs:comment "Sensor is isSensorCalibrated" ;
    rdfs:domain LFTDO4:Sensor ;
    rdfs:range xsd:boolean .

LFTDO4:isSensorDataAnomaly a owl:DatatypeProperty ;
    rdfs:label "isSensorDataAnomaly" ;
    rdfs:comment "is there some Sensor Data anomaly?" ;
    rdfs:domain LFTDO4:SensorData ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:isStoredIn a owl:ObjectProperty ;
    rdfs:label "isStoredIn" ;
    rdfs:comment "This ensures the reasoner knows that log events are meant for storage, keeping the communication channel (the SoftwareApplication) clear of \"noise\"." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:RoutineLogEvent LFTDO4:SensorData LFTDO4:StatusUpdateEvent ) ] ;
    rdfs:range LFTDO4:Database ;
    owl:inverseOf LFTDO4:storeData .

LFTDO4:isSuitableForRuralAreas a owl:DatatypeProperty ;
    rdfs:label "isSuitableForRuralAreas" ;
    rdfs:comment "Checks if the device is Suitable to use for rural areas?" ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:isTransitionedFrom a owl:ObjectProperty ;
    rdfs:label "isTransitionedFrom" ;
    rdfs:comment "AbnormalBehaviour State is transitionedFrom some Normal Behaviour State" ;
    rdfs:domain LFTDO4:AbnormalState ;
    rdfs:range LFTDO4:NormalState ;
    owl:inverseOf LFTDO4:transitionsTo .

LFTDO4:isUsedBy a owl:ObjectProperty ;
    rdfs:label "isUsedBy" ;
    rdfs:comment "Algorithm is used by some DetectionMethod" ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range LFTDO4:DetectionMethod ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf LFTDO4:uses .

LFTDO4:isValidatedBy a owl:ObjectProperty ;
    rdfs:label "isValidatedBy" ;
    rdfs:comment "LivestockEvent isValidatedBy Farmer." ;
    rdfs:domain LFTDO4:StatusUpdateEvent ;
    rdfs:range LFTDO4:Participant ;
    owl:inverseOf LFTDO4:validateStatusOfEvent .

LFTDO4:lastVetCheck a owl:DatatypeProperty ;
    rdfs:label "lastVetCheck" ;
    rdfs:comment "lastVetCheck" ;
    rdfs:domain LFTDO4:HealthCondition ;
    rdfs:range xsd:dateTime .

LFTDO4:overridesStatus a owl:ObjectProperty ;
    rdfs:label "overridesStatus" ;
    rdfs:comment """Participant can override status provided by the System.
Allows the farmer to explicitly cancel the AI's choice.""" .

LFTDO4:produces a owl:ObjectProperty ;
    rdfs:label "produces" ;
    rdfs:comment "DetectionMethod produces some System Event" ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range LFTDO4:SystemEvent .

LFTDO4:transmitSensorDataTo a owl:ObjectProperty ;
    rdfs:label "transmitSensorDataTo" ;
    rdfs:comment "Device(EndDevice) transmit some SensorDataTo a DataTransmission" ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range LFTDO4:DataTransmission ;
    owl:inverseOf LFTDO4:transmittedSensorDataFrom .

LFTDO4:uiUpdatedBy a owl:ObjectProperty ;
    rdfs:label "SoftwareApplication's UI is updated by StatusUpdateEvent",
        "uiUpdatedBy" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range LFTDO4:StatusUpdateEvent ;
    owl:inverseOf LFTDO4:updatesUI .

LFTDO4:useDatabaseData a owl:ObjectProperty ;
    rdfs:label "useDatabaseData" ;
    rdfs:comment "Machine Learning Algorithms uses some SensorData stored in the Database to analyse and make predictions." ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range LFTDO4:Database ;
    rdfs:subPropertyOf owl:topObjectProperty .

:baseStepCount a swrl:Variable .

LFTDO4:Agression a owl:Class ;
    rdfs:label "Aggression" ;
    rdfs:comment """1.Aggression is a behaviour
Referenced Ontology: Aggression (ATOL:0001782)=Aggregative  behaviour (Meunier-Salaün et. al,2015)
Under Behavior trait->Motor activity->aggregative behavior.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        LFTDO4:Behaviour .

LFTDO4:Algorithm001 a owl:NamedIndividual,
        LFTDO4:Algorithm ;
    rdfs:label "Algorithm001" ;
    rdfs:comment "Algorithm001" ;
    owl:topDataProperty 0.98 ;
    LFTDO4:hasAlgorithmType "Machine Learning"^^xsd:string ;
    LFTDO4:hasAlgorithmVersion "v0.1"^^xsd:string ;
    LFTDO4:hasComplexity "HIGH"^^xsd:string ;
    LFTDO4:isOptimized true ;
    LFTDO4:isUsedBy LFTDO4:TheftDetectionSystem .

LFTDO4:Algorithm003 a owl:NamedIndividual,
        LFTDO4:Algorithm ;
    rdfs:label "Algorithm003" ;
    rdfs:comment "Algorithm003" ;
    LFTDO4:hasAlgorithmType "Threshold-Based"^^xsd:string ;
    LFTDO4:hasAlgorithmVersion "v0.1"^^xsd:string ;
    LFTDO4:hasComplexity "HIGH"^^xsd:string ;
    LFTDO4:hasDetectionMethodAccuracy 0.98 ;
    LFTDO4:isOptimized true ;
    LFTDO4:isUsedBy LFTDO4:HealthDetectionMethod .

LFTDO4:Algorithm004 a owl:NamedIndividual,
        LFTDO4:Algorithm ;
    rdfs:label "Algorithm004" ;
    rdfs:comment "Algorithm004" ;
    LFTDO4:hasAlgorithmType "Spatial Geofencing"^^xsd:string ;
    LFTDO4:hasAlgorithmVersion "v0.1"^^xsd:string ;
    LFTDO4:hasComplexity "LOW"^^xsd:string ;
    LFTDO4:hasDetectionMethodAccuracy 0.97 ;
    LFTDO4:isOptimized true .

LFTDO4:Breeding a owl:Class ;
    rdfs:label "Breeding" ;
    rdfs:comment "1.Breeding is a behaviour" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        LFTDO4:Behaviour .

LFTDO4:CattleGrazingState a owl:Class ;
    rdfs:comment "CattleGrazingState is a NormalState" ;
    rdfs:subClassOf LFTDO4:NormalState .

LFTDO4:CattleSensorData_Temp_002 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_003 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_004 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_005 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_006 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_007 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_008 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_009 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_010 a owl:NamedIndividual .

LFTDO4:CattleSensorData_Temp_011 a owl:NamedIndividual .

LFTDO4:CattleWanderingState a owl:Class ;
    rdfs:label "CattleWanderingState" ;
    rdfs:subClassOf LFTDO4:NormalState .

LFTDO4:CommunicationGateway a owl:Class ;
    rdfs:label "CommunicationGateway" ;
    rdfs:comment "1.A Communication Gateway is a Device not fitted into a livestock and is connected to the internet(Cloud Computing Services)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDevicePrice ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty LFTDO4:hasDeviceID ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSerialNumber ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasManufacturerName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceCapacity ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSensorType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationFrequencyRange ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceBatteryLife ;
            owl:someValuesFrom xsd:decimal ],
        LFTDO4:Device .

LFTDO4:Cow002 a owl:NamedIndividual,
        LFTDO4:Cattle ;
    rdfs:label "Cow002"^^xsd:string ;
