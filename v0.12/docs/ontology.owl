    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Classifies an active theft in progress based on combined fence breach and behavioural anomaly.</rdfs:comment>
        <rdfs:label>RL_THEFT_IN_PROGRESS</rdfs:label>
