                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Flags daytime temperatures (≥ 35°C) as &quot;Extreme Heat&quot; to provide context for high heart rates.</rdfs:comment>
        <rdfs:label>RL_EXTREME_HEAT_CONTEXT</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#Loc"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvValue"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#v"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#OccursAtLocation"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#Loc"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#AmbientTemperature"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                        <swrl:arguments>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#v"/>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasTemporalContext"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                                                <swrl:argument2>DayTime</swrl:argument2>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#ExtremeHeat"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#inferredByRule"/>
                                <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#HighEnvTheftIndicator001"/>
                                <swrl:argument2>RL_BEHAVIOUR_DEVIATION</swrl:argument2>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#isCharacterisedBy"/>
                                        <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#DayAmbientTemp001"/>
                                        <swrl:argument2 rdf:resource="https://github.com/tumelomodise/LFTDO#HighEnvTheftIndicator001"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#ExtremeDayTimeHeat"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Triggers when the device latitude exceeds the defined maximum northern coordinate.</rdfs:comment>
        <rdfs:label>RL_MODERATEHEAT_CONTEXT</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#Loc"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvValue"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#v"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#v"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">34.9</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#OccursAtLocation"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#Loc"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#AmbientTemperature"/>
                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasTemporalContext"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                                                                <swrl:argument2>DayTime</swrl:argument2>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#ModerateAmbientTemperature"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#t"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#inferredByRule"/>
                                <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#LowEnvTheftIndicator001"/>
                                <swrl:argument2>RL_MODERATEHEAT_CONTEXT</swrl:argument2>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#isCharacterisedBy"/>
                                        <swrl:argument1 rdf:resource="https://github.com/tumelomodise/LFTDO#DayAmbientTemp001"/>
                                        <swrl:argument2 rdf:resource="https://github.com/tumelomodise/LFTDO#LowEnvTheftIndicator001"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Flags livestock as IsSuspectedOfTheft if it exhibits Restless behaviour at an isolation location.</rdfs:comment>
        <rdfs:label>RL_SUSPICIOUS_RESTLESS_INQUIRY</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Restless"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#restless"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#exhibits"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ls"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#isolation"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#exhibits"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ls"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#restless"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#sameLocation"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Isolation"/>
                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#isolation"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentLocation"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ls"/>
                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#sameLocation"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                        <swrl:classPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#ls"/>
