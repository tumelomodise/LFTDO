    owl:annotatedTarget 3000.0 .

[] a swrl:Imp ;
    rdfs:label "RL_FENCE_BREACH_THEFT_SPEED"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Detects theft by combining fence breach with abnormal speed threshold breach."^^xsd:string ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 :s ;
                    swrl:classPredicate LFTDO4:Livestock ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 :sensorComp ;
