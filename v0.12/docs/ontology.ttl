:Farmer001 rdf:type owl:NamedIndividual ,
                    :Farmer ,
                    :Participant ;
           :hasAccessTo :SoftwareApp001 ;
           :isNotifiedBySoftwareApp :SoftwareApp001 ,
                                    :SoftwareApp002 ;
           :isOwnerOfLivestock :Goat001 ;
           :usesFarm :Farm001 ;
           :hasContactNumber "0731234545" ;
           :hasParticipantEmail "test@test.email.com" ;
           :hasParticipantID "9000000000006" ;
           :hasParticipantName "Mr. Tumelo Modise" ;
           :hasParticipantRole "Farmer" ;
           rdfs:comment "Farmer001" ;
           rdfs:label "Farmer001" .


