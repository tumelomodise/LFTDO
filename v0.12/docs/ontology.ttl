:Goat001 rdf:type owl:NamedIndividual ,
                  :Goat ,
                  :Livestock ;
         :exhibits :GoatGrazing ,
                   :GoatGrazing1 ;
         :hasCurrentLocation :PastureLocation001 ;
         :isAttachedToDevice :GoatTrackerCollar001 ;
