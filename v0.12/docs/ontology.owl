    <owl:DatatypeProperty rdf:about="https://github.com/tumelomodise/LFTDO#isSuitableForRuralAreas">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
