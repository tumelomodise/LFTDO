                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EndDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isLocatedAtFarm"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isOwnedByFarmer"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAge"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBodyTemperature"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBreed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGender"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGroupSize"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasRunningDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSittingDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSleepingDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpecies"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTagMark"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasWeightInKg"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isOutsideGeofence"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isPregnant"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isSuspectedOfTheft"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAnimalID"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
        <rdfs:comment>Livestock are domestic animals such as cattle, sheep, and goats for labor, and the production of commodities for humans such as meat, milk, wool, and leather (Britannica, 2020).

Relationships:
1.Livestock is fitted with some end device for tracking and monitoring.
2.Livestock has some body condition score.
3.Livestock exhibit some Behaviour 
4.Livestock is located at some Farm Location</rdfs:comment>
        <rdfs:label>Livestock</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#LivestockEvent -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#LivestockEvent">
        <rdfs:comment>LivestockEvent  is the &quot;Outcome&quot; or &quot;Alert&quot; of the Livestock Indicators.</rdfs:comment>
        <rdfs:label>LivestockEvent</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#LivestockIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#LivestockIndicator">
        <rdfs:comment>LivestockIndicators satisfy the necessary and sufficient conditions to infer a different high-level LivestockEvent (e.g., TheftEvent), providing a clear audit trail from raw data to actionable alert.</rdfs:comment>
        <rdfs:label>LivestockIndicator</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Location -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Location">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLatitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLongitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Locations are farmer area where the livestock are being kept is referred to as a Farm.It can be at an urban, rural, or semi-urban location, and may have pen and open fields that are fenced or unfenced. 

The position of livestock within a farm location is constrained to date and time, and their behavior influences their movement. The livestock position within a location may be indicated with coordinates such as longitude and latitude, which are used to precisely determine the location of livestock within a farm area, as discussed by  (Symeonaki et al., 2020).

Relationships:
1.Location (e.g., a farm) has a specific time period(startTime and endTime) during which certain events or activities occurs.
2.Location (e.g., a farm) has a specific geographical position defined by latitude and longitude coordinates.</rdfs:comment>
        <rdfs:label>Location</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#ModerateAmbientTemperature -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#ModerateAmbientTemperature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#AmbientTemperature"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasEnvValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">19</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">34.9</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTemporalContext"/>
                        <owl:hasValue>DayTime</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Moderate Ambient Temperature range that applies to many populated areas might be considered:Daytime: Around 20 °C to  34.9 °C.</rdfs:comment>
        <rdfs:label>ModerateAmbientTemperature</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Movement -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Movement">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology:
1.Movement is a behaviour
3.Different behaviour states may be observed based  on Movement rate, distance covered and  Geopositions.
Reference:
Movement = Member movement (ATOL:000842) (Meunier-Salaün et. al,2015)
Under Behavior trait-&gt;Motor activity-&gt;body movement-&gt;member movement behavior.</rdfs:comment>
        <rdfs:label>Movement</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#NormalGrazingIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#NormalGrazingIndicator">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>Normal Grazing Indicator may indicate that livestock is normally grazing on the Farm or Restricted area.</rdfs:comment>
        <rdfs:label>NormalGrazingIndicator</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#NormalState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#NormalState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateBaselineValues"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateConfidenceScore"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateContext"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDeviation"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpeed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Behaviour state that are a social norm, that is statistically frequent and prevents livestock from functioning.
Sub-classes:
1.CatleRunningState
2.GoatGrazingState</rdfs:comment>
        <rdfs:label>NormalState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Panting -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Panting">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology:
Panting = Panting(ATOL:00832)
&quot;any measurable or observable characteristic related to the ability of increasing breathing by polypnea or hyperpnea performed with open mouth and distinct thoracic movements, to increase O2-CO2 exchanges and/or to increase evaporative heat loss.&quot; (Meunier-Salaün et. al,2015)</rdfs:comment>
        <rdfs:label>Panting</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Participant -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Participant">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#validateStatusOfEvent"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasContactNumber"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantRole"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasParticipantID"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A participant in livestock farming such as Farmers, and others such as extended officers, veterinarians, and Law enforcement agents.
A Farmer owns various domestic animals such as cattle, sheep, and goats. 
The veterinarian understands the behavior of domestic animals and often treats the domestic animals for diseases.    
Extended officers, work on a farm, to manage livestock such as feeding, keeping count, managing their well-being, and protecting against theft.
Law enforcement agents, enforce the law of the country if not being adhered to such as theft, and abuse of livestock.

Sub-classes:
1. Farmer
2.ExtendedOfficer
3.LawEnforcementAgency
4.Veterinarian</rdfs:comment>
        <rdfs:label>Participant</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Resting -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Resting">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>1.Resting is a behaviour
2.Resting can be a normal or abnormal behaviour state based on duration of the rest</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#RestingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#RestingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:label>RestingState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Restless -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Restless">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:comment>Livestock may exhibit some restless behaviour.</rdfs:comment>
        <rdfs:label>Restless</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Restlessness -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Restlessness">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCharacterisedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#TheftIndicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isCurrentBehaviourStateOf"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EnvironmentalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isInfluencedByHealthCondition"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateConfidenceScore"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateContext"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStateDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSeverityLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpeed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Restlessness is an AbnormalState of Behaviour of Livestock</rdfs:comment>
        <rdfs:label>Restlessness</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#RestrictedArea -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#RestrictedArea">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Location"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isSecurelyGuarded"/>
                        <owl:allValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EndDevice"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isMonitoredByDevice"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isUsedByFarmer"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasFence"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLatitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLocationType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasLongitude"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The RestrictedArea is a location in a farm that isSecuredGuardedBy only EndUser device.</rdfs:comment>
        <rdfs:label>RestrictedArea</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#RoutineLogEvent -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#RoutineLogEvent">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#SystemEvent"/>
        <owl:disjointWith rdf:resource="https://github.com/tumelomodise/LFTDO#StatusUpdateEvent"/>
        <rdfs:comment>Classifies the a Data-Persistence Event</rdfs:comment>
        <rdfs:label>RoutineLogEvent</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Running -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Running">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBehaviourStartTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasIntensity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Referenced Ontology:
1.Running is a behaviour = running behavior(ATOL:0000806), &quot;any measurable or observable characteristic related to rapidely coordinated displacement of the body on foot or limbs&quot;  (Meunier-Salaün et. al,2015)
2.Running can have normal or abnomal behaviour state based on the livestock speed and running duration.

AOL Under: Animal trait of livestock-&gt;animal welfar trait-&gt;psychoneuroendocrinological state trait-&gt;motor activity-&gt;locomotor activity-&gt;running behaviour</rdfs:comment>
        <rdfs:label>Running</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Rustling -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Rustling">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#TheftEvent"/>
        <rdfs:comment>Rustling: The illegal taking of livestock from a farm or ranch without permission of the farmer(Dieng,2017).</rdfs:comment>
        <rdfs:label>Rustling</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SabotageIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SabotageIndicator">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockIndicator"/>
        <rdfs:comment>Sabotage Theft Indicator may indicate that there is a potential theft indicator</rdfs:comment>
        <rdfs:label>SabotageIndicator</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SecurityBreach -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SecurityBreach">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#SabotageIndicator"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>High</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Low</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Medium</owl:hasValue>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#affectsLivestock"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isTriggeredBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventResolution"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventStatus"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>SecurityBreach: is triggered by Sabotage indicators that related to technologies misfunctions or fence cut or collar removed from Livestock.</rdfs:comment>
        <rdfs:label>SecurityBreach</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Sensor -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Sensor">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceBatteryLife"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceCapacity"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDevicePrice"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceSensorType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceSerialNumber"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasManufacturerName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasModulationFrequencyRange"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasModulationType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasDeviceID"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>1.Sensor is a Device that detect the changes on livestock and the environment</rdfs:comment>
        <rdfs:label>Sensor</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SensorData -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SensorData">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isGeneratedByDevice"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSensorDataValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSensorTimeStamp"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#representsDataType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>SensorData: Represents data collected from device sensors attached to the livestock and environment, providing various behaviour states.</rdfs:comment>
        <rdfs:label>SensorData</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Sheep -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Sheep">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibits"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#experiences"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentLocation"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#healthConfirmedBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Participant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAttachedToDevice"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EndDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isLocatedAtFarm"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isOwnedByFarmer"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Farmer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAge"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBreed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGender"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasGroupSize"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasRunningDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSheepBodyConditionScore"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minExclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSittingDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSleepingDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSpecies"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTagMark"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasWeightInKg"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isPregnant"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAnimalID"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Sheep is a livestock</rdfs:comment>
        <rdfs:label>Sheep</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SheepGrazingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SheepGrazingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <owl:disjointWith rdf:resource="https://github.com/tumelomodise/LFTDO#SheepRestingState"/>
        <rdfs:comment>SheepGrazingState is normalState</rdfs:comment>
        <rdfs:label>SheepGrazingState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SheepRestingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SheepRestingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>SheepRestingState is normalState</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SheepRunningState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SheepRunningState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>SheepRunningState is normalState</rdfs:comment>
        <rdfs:label>SheepRunningState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SheepWanderingState -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SheepWanderingState">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#NormalState"/>
        <rdfs:comment>SheepWanderingState</rdfs:comment>
        <rdfs:label>SheepWanderingState</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#SheepWithFever -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#SheepWithFever">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tumelomodise/LFTDO#Sheep"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#experiences"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Fever"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasBodyTemperature"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">39.3</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Sheep  that hasBodyTemperature &gt;= 40 celsius, is a Sheep with Fever</rdfs:comment>
        <rdfs:label>SheepWithFever</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#Sick -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Sick">
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
