                         rdfs:label "hasEnvironmentalContext" .


###  https://github.com/tumelomodise/LFTDO#hasHealthIndicator
:hasHealthIndicator rdf:type owl:ObjectProperty ;
                    rdfs:domain :BehaviourState ;
                    rdfs:range :HealthIndicator ;
                    rdfs:label "hasHealthIndicator" .


###  https://github.com/tumelomodise/LFTDO#hasLivestockIndicator
:hasLivestockIndicator rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :AbnormalState
