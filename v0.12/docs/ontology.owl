                                                                                                        <swrl:propertyPredicate rdf:resource="https://github.com/tumelomodise/LFTDO#isAttachedToDevice"/>
                                                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#s"/>
                                                                                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/209332175/ontologies/2024/003/LFTDO#dev"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
