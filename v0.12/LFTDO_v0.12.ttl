    LFTDO4:hasMinLat -25.8885 ;
    LFTDO4:hasMinLon 28.1600 ;
    LFTDO4:isPartOfLocation LFTDO4:Farm001 .

LFTDO4:Livestock a owl:Class ;
    rdfs:label "Livestock" ;
    rdfs:comment """Livestock are domestic animals such as cattle, sheep, and goats for labor, and the production of commodities for humans such as meat, milk, wool, and leather (Britannica, 2020).

Relationships:
1.Livestock is fitted with some end device for tracking and monitoring.
2.Livestock has some body condition score.
3.Livestock exhibit some Behaviour 
4.Livestock is located at some Farm Location""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBreed ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasGroupSize ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentLocation ;
            owl:someValuesFrom LFTDO4:Location ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isPregnant ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSpecies ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasTagMark ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isLocatedAtFarm ;
            owl:someValuesFrom LFTDO4:Farm ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isOwnedByFarmer ;
            owl:someValuesFrom LFTDO4:Farmer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasAge ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isSuspectedOfTheft ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasGender ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:healthConfirmedBy ;
            owl:someValuesFrom LFTDO4:Participant ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBodyTemperature ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasWeightInKg ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty LFTDO4:hasAnimalID ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSleepingDuration ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibits ;
            owl:someValuesFrom LFTDO4:Behaviour ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isOutsideGeofence ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasSittingDuration ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isAttachedToDevice ;
            owl:someValuesFrom LFTDO4:EndDevice ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:experiences ;
            owl:someValuesFrom LFTDO4:HealthCondition ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasRunningDuration ;
            owl:someValuesFrom xsd:decimal ] ;
    owl:disjointWith LFTDO4:Participant .

