    <!-- https://github.com/tumelomodise/LFTDO#Livestock -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#Livestock">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#exhibits"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#experiences"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasCurrentLocation"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
