:generatesData rdf:type owl:ObjectProperty ;
               owl:inverseOf :isGeneratedByDevice ;
               rdfs:domain :Device ;
               rdfs:range :SensorData ;
               rdfs:comment "Device generates some Data" ;
               rdfs:label "generatesData" .


###  https://github.com/tumelomodise/LFTDO#generatesLog
:generatesLog rdf:type owl:ObjectProperty ;
              owl:inverseOf :logGeneratedBy ;
              rdfs:domain :SoftwareApplication ;
              rdfs:range :RoutineLogEvent ;
              rdfs:comment "SoftwareApplication generate some RoutineLog" ;
              rdfs:label "generatesLog" .


###  https://github.com/tumelomodise/LFTDO#hasAbnormalBehaviourState
:hasAbnormalBehaviourState rdf:type owl:ObjectProperty ;
                           rdfs:range :BehaviourState ;
                           rdfs:comment "Livestock has Behaviour(s) has some AbnormalBehaviourState" ;
                           rdfs:label "hasAbnormalBehaviourState" .


