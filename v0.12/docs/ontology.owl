    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#HealthAlertEvent -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#HealthAlertEvent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasAbnormalBehaviourState"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#AbnormalState"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isAlertInitiatedBy"/>
                        <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#EscapeIndicator"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://github.com/tumelomodise/LFTDO#LivestockEvent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>High</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Low</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#triggersAlertLevel"/>
                        <owl:hasValue>Medium</owl:hasValue>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#affectsLivestock"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#Livestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#isTriggeredBy"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventResolution"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventStatus"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasTheftEventTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>HealthAlertEvent: Alert related to Livestock Health</rdfs:comment>
        <rdfs:label>HealthAlertEvent</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#HealthCondition -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#HealthCondition">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#healthInfluencesBehaviourState"/>
                <owl:someValuesFrom rdf:resource="https://github.com/tumelomodise/LFTDO#BehaviourState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasHealthDescription"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/tumelomodise/LFTDO#hasSymptoms"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Health condition indicates various health situations of a livestock, related to Livestock behavior pertaining to livestock theft situations.
Sub-routine:
1.LegInjurty
2.Sick</rdfs:comment>
        <rdfs:label>HealthCondition</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/tumelomodise/LFTDO#HealthIndicator -->


    <owl:Class rdf:about="https://github.com/tumelomodise/LFTDO#HealthIndicator">
