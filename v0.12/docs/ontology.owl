    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Combines &quot;OutsideFence&quot; status with &quot;AbnormalState&quot; to confirm an active theft.</rdfs:comment>
