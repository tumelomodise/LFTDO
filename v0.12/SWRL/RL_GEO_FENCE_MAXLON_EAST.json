LFTDO3:Livestock(?s) ^ LFTDO3:isAttachedToDevice(?s, ?dev) ^ 
LFTDO3:Device(?dev) ^ LFTDO3:hasLongitude(?dev, ?lon) ^ 
LFTDO3:hasCurrentLocation(?s, ?currLoc) ^ LFTDO3:Location(?currLoc) ^ 
LFTDO3:hasMaxLon(?currLoc, ?MaxLon) ^ swrlb:greaterThan(?lon, ?MaxLon) -> 
LFTDO3:isOutsideGeofence(?s, true) ^ LFTDO3:inferredByRule(?s, "RL_GEO_FENCE_MAXLON_EAST")