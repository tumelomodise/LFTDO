LFTDO4:SheepWanderingState a owl:Class ;
    rdfs:label "SheepWanderingState" ;
    rdfs:comment "SheepWanderingState" ;
    rdfs:subClassOf LFTDO4:NormalState .

LFTDO4:SlaughterTheft a owl:Class ;
    rdfs:label "SlaughterTheft" ;
    rdfs:comment "The illegal killing and stealing of livestock for meat." ;
    rdfs:subClassOf LFTDO4:TheftEvent .

LFTDO4:Sleeping a owl:Class ;
    rdfs:label "Sleeping" ;
    rdfs:comment """Referenced Ontology:
1.Sleeping is a behaviour
2.Sleeping can be a normal or abnormal state based on the sleeping duration
Sleeping = Sleep pattern(ATOL:000369) "any measurable or observable characteristic related to the wake/sleep cycle" (Meunier-Salaün et. al,2015)
Under: Animal Trait->Pyschoneuroendocrinological state trait->biological rhythm->sleep pattern""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:Behaviour .

LFTDO4:SolitaryBehaviour a owl:NamedIndividual,
        LFTDO4:Isolation ;
    rdfs:label "SolitaryBehaviour" ;
    rdfs:comment "SolitaryBehaviour" .

LFTDO4:SpaceUse a owl:Class ;
    rdfs:label "SpaceUse" ;
    rdfs:comment "Referenced Ontology: SpaceUse = Space use(ATOL0000831:) \"any measurable or observable characteristic related to the behavior of the animals to use their physical environment according to the social or physical stimuli within this environment  (e.g. use of perches, use of specific area, geographic location)\" (Meunier-Salaün et. al,2015)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:Behaviour .

LFTDO4:Startle a owl:Class ;
    rdfs:label "Startle" ;
    rdfs:comment """Referenced Ontology:
1. Startle is a Behaviour = startle reponses(ATOL:0000368), "any measurable or observable characteristic related to the response of the whole body to triggering stimulus without any voluntary orientation towards this given stimulus"

In ATOL under:Aninmal trait of livestock->animal welfare trait->psychoneuroendcrinological state trait->behavior trait->motor activity->body movement->locomotor activity->startle response""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:Behaviour .

LFTDO4:Suckling a owl:Class ;
    rdfs:label "Suckling" ;
    rdfs:comment """Referenced Ontology:
1.Suckling = suckling behavior(ATOL:0000365)"any measurable or observable beahvioral characteristic related to the intake of milk by a preweaning organism"(Meunier-Salaün et. al,2015)
2.Suckling indicates the baby of livestock sucking miik from their mother, it had different rates, and number of times it does in an hour/day. 
3. it may have a abnormal behaviour state based on decreased suckling rate, which could indicate a baby livestock is separated from its mother

In ATOL under: animal trait of livestock->animal welfare trait->psychoneuroendocrinological state trait->behaviour trait->ingestive behavior->suckling behavior""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:exhibitedBy ;
            owl:someValuesFrom LFTDO4:Livestock ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasCurrentBehaviourState ;
            owl:someValuesFrom LFTDO4:BehaviourState ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasBehaviourStartTime ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasIntensity ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:Behaviour .

LFTDO4:SuspiciousIndicator a owl:Class ;
    rdfs:label "SuspiciousIndicator" ;
    rdfs:comment "Suspicious Indicator may indicate that there is a suspecious activity event." ;
    rdfs:subClassOf LFTDO4:LivestockIndicator .

LFTDO4:UserDevice a owl:Class ;
    rdfs:label "UserDevice" ;
    rdfs:comment """1.User device is a Device not fitted into a livestock 
2.User devices are used by some Actors such as to track and monitor livestock, secure the Farm Location""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceBatteryLife ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationFrequencyRange ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasModulationType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDevicePrice ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceCapacity ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSensorType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasManufacturerName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasDeviceSerialNumber ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty LFTDO4:hasDeviceID ],
        LFTDO4:Device .

LFTDO4:causedBy a owl:ObjectProperty ;
    rdfs:label "causedBy" ;
    rdfs:comment "TheftEvent is caused by some UnauthorisedPerson an agentive cause (the intruder)" ;
    rdfs:domain LFTDO4:TheftEvent ;
    rdfs:range LFTDO4:UnauthorisedPerson .

LFTDO4:cloudServiceName a owl:DatatypeProperty ;
    rdfs:label "cloudServiceName" ;
    rdfs:comment "CloudService has a Name" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:executesApplication a owl:ObjectProperty ;
    rdfs:label "executesApplication" ;
    rdfs:comment "CloudService executes some Software Application" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range LFTDO4:SoftwareApplication ;
    owl:inverseOf LFTDO4:isDeployedOn .

LFTDO4:hasAlgorithmName a owl:DatatypeProperty ;
    rdfs:label "hasName" ;
    rdfs:comment "Any instance like Software, Database, Algorithm and has some name" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasBaselinePosture a owl:DatatypeProperty ;
    rdfs:label "hasBaselinePosture" ;
    rdfs:comment "Defines \"Horizontal\" as the required state for resting." ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasBaselineStepCount a owl:DatatypeProperty ;
    rdfs:label "hasBaselineStepCount" ;
    rdfs:comment "Defines \"Stationary\" as the required activity level." ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasCattleBodyConditionScore a owl:DatatypeProperty ;
    rdfs:label "hasCattleBodyConditionScore" ;
    rdfs:comment "Livestock(Cattle) has some CattleBodyConditionScore" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasCloudService a owl:ObjectProperty ;
    rdfs:label "hasCloudService" ;
    rdfs:comment "DataTransmission has some CloudService" ;
    rdfs:domain LFTDO4:DataTransmission ;
    rdfs:range LFTDO4:CloudService ;
    owl:inverseOf LFTDO4:receivesDataFrom .

LFTDO4:hasCloudServiceDescription a owl:DatatypeProperty ;
    rdfs:label "hasCloudServiceDescription" ;
    rdfs:comment "CloudService has some description" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasCloudServiceProvider a owl:DatatypeProperty ;
    rdfs:label "hasCloudServiceProvider" ;
    rdfs:comment """CloudService has some Provider
To identify if you are using AWS, Azure, or a local TUT server.""" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasCloudServiceType a owl:DatatypeProperty ;
    rdfs:label "hasCloudServiceType" ;
    rdfs:comment "CloudService has some Type" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasCompatibility a owl:DatatypeProperty ;
    rdfs:label "hasCompatibility" ;
    rdfs:comment "SoftwareApplication has some Compatibility" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDataSize a owl:DatatypeProperty ;
    rdfs:label "hasDataSize" ;
    rdfs:comment """SensorData has some DataSize
Measures the packet size (e.g., in KB).""" ;
    rdfs:domain LFTDO4:DataTransmission ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDataTimeStamp a owl:DatatypeProperty ;
    rdfs:label "hasDataTimeStamp" ;
    rdfs:comment """DataTransmission has some DataTimeStamp.

Records exactly when the event happened.""" ;
    rdfs:domain LFTDO4:DataTransmission ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDatabaseAccessControl a owl:DatatypeProperty ;
    rdfs:label "hasDatabaseAccessControl" ;
    rdfs:comment "Database has some AccessControl" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDatabaseBackupAndRecovery a owl:DatatypeProperty ;
    rdfs:label "hasDatabaseBackupAndRecovery" ;
    rdfs:comment "Database has some BackupAndRecovery" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDatabaseSchema a owl:DatatypeProperty ;
    rdfs:label "hasDatabaseSchema" ;
    rdfs:comment "Database has a Schema" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDatabaseStorageCapacity a owl:DatatypeProperty ;
    rdfs:label "hasDatabaseStorageCapacity" ;
    rdfs:comment "Database has some StorageCapacity" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDatabaseType a owl:DatatypeProperty ;
    rdfs:label "hasDatabaseType" ;
    rdfs:comment "Database has some Type" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasDescription a owl:DatatypeProperty ;
    rdfs:label "hasDescription" ;
    rdfs:comment "Software App, Algorithm, Cloud Service has some Description" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasFunctionality a owl:DatatypeProperty ;
    rdfs:label "hasFunctionality" ;
    rdfs:comment "SoftwareApplication has some Functionality" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasGoatBodyConditionScore a owl:DatatypeProperty ;
    rdfs:label "hasGoatBodyConditionScore" ;
    rdfs:comment "Goat has some GoatBodyConditionScore" ;
    rdfs:domain LFTDO4:Goat ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasGoatGrazingSpeedInMS a owl:DatatypeProperty ;
    rdfs:label "hasGoatGrazingSpeedInMS" ;
    rdfs:comment """Speed meanured in meters per seconds(m/s)
hasSpeedInMetersPerSecond shorten to (hasSpeedInMS)""" ;
    rdfs:domain LFTDO4:Grazing ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasInputFeatures a owl:DatatypeProperty ;
    rdfs:label "hasInputFeatures" ;
    rdfs:comment """Algorithm has some InputFeatures
"GPS_Coord, Velocity, Time_of_Day\"""" ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasMaxLon a owl:DatatypeProperty ;
    rdfs:label "hasMaxLon" ;
    rdfs:comment "Eastern Boundary" .

LFTDO4:hasMinLat a owl:DatatypeProperty ;
    rdfs:label "hasMinLat" ;
    rdfs:comment "Southern Boundary" .

LFTDO4:hasMinLon a owl:DatatypeProperty ;
    rdfs:label "hasMinLon" ;
    rdfs:comment "Western Boundary" ;
    rdfs:domain LFTDO4:Location ;
    rdfs:range xsd:decimal .

LFTDO4:hasOutputFormat a owl:DatatypeProperty ;
    rdfs:label "hasOutputFormat" ;
    rdfs:comment "MLAlgorithm has some output format." ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasPowerStatus a owl:DatatypeProperty ;
    rdfs:label "hasPowerStatus" ;
    rdfs:comment "A Device has power status 'On' or 'Off' for a battery or connected to some power outlet. If its 'Off' it can indicate the some TheftIndicator of Sabotage Indicator" ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range xsd:string .

LFTDO4:hasPurpose a owl:DatatypeProperty ;
    rdfs:label "hasPurpose" ;
    rdfs:comment "MLAgorithm has some purpose." ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasResourceRequirements a owl:DatatypeProperty ;
    rdfs:label "hasResourceRequirements" ;
    rdfs:comment "MLA has some resource requirements." ;
    rdfs:domain LFTDO4:Algorithm ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasSensorDataValue a owl:DatatypeProperty ;
    rdfs:label "hasSensorDataValue" ;
    rdfs:comment "SensorData has some value." ;
    rdfs:domain LFTDO4:SensorData ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasSensorTimeStamp a owl:DatatypeProperty ;
    rdfs:label "hasSensorTimeStamp" ;
    rdfs:comment "SensorData has some date and time." ;
    rdfs:domain LFTDO4:SensorData ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasSheepBodyConditionScore a owl:DatatypeProperty ;
    rdfs:label "hasSheepBodyConditionScore" ;
    rdfs:comment "Livestock(Sheep) has some SheepBodyConditionScore" ;
    rdfs:domain LFTDO4:Sheep ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasSoftwareAppName a owl:DatatypeProperty ;
    rdfs:label "hasSoftwareAppName" ;
    rdfs:comment "Software application has a name" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasSoftwareAppType a owl:DatatypeProperty ;
    rdfs:label "hasSoftwareAppType" ;
    rdfs:comment "Software has some Application Type." ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasSoftwareVersion a owl:DatatypeProperty ;
    rdfs:label "hasSoftwareVersion" ;
    rdfs:comment "The software application has some version." ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:hasVersion a owl:DatatypeProperty ;
    rdfs:label "hasVersion" ;
    rdfs:comment "Algorithm has version" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:healthConditionBelongsTo a owl:ObjectProperty ;
    rdfs:label "healthConditionBelongsTo" ;
    rdfs:comment "HealthConditionBelongsTo to a specific Livestock type such Cattle, Sheep or Goat." ;
    rdfs:domain LFTDO4:HealthCondition ;
    rdfs:range LFTDO4:Livestock .

LFTDO4:hostsDatabase a owl:ObjectProperty ;
    rdfs:label "hostsDatabase" ;
    rdfs:comment "Cloud Service hosts some Database" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range LFTDO4:Database ;
    owl:inverseOf LFTDO4:isStoredOn .

LFTDO4:implements a owl:ObjectProperty ;
    rdfs:label "implements" ;
    rdfs:comment """SoftwareApplication implements some DetectionMethod.
A single App (like SoftwareApp001) can contain multiple detection "modules" (e.g., one for Theft, one for Health, one for Heat Detection). It can also exist with Zero methods if it’s just a data-viewer app.""" ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range LFTDO4:DetectionMethod ;
    owl:inverseOf LFTDO4:isImplementedBy .

LFTDO4:initiatesAlert a owl:ObjectProperty ;
    rdfs:label "initiatesAlert" ;
    rdfs:comment "TheftIndicator initiates TheftEvent" ;
    rdfs:domain LFTDO4:LivestockIndicator ;
    rdfs:range LFTDO4:LivestockEvent ;
    owl:inverseOf LFTDO4:isAlertInitiatedBy .

LFTDO4:isAccessedBy a owl:ObjectProperty ;
    rdfs:label "isAccessedBy" ;
    rdfs:comment "Database is accessed by some SoftwareApplication" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range LFTDO4:SoftwareApplication .

LFTDO4:isAffectedBy a owl:ObjectProperty ;
    rdfs:label "isAffectedBy" ;
    rdfs:comment "Livestock or Location or Device isAffectedBy LivestockEvent" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:Device LFTDO4:Livestock LFTDO4:Location ) ] .

LFTDO4:isAnalysedBy a owl:ObjectProperty ;
    rdfs:label "isAnalysedBy" ;
    rdfs:comment "Database is analysed by some DetectionMethod" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range LFTDO4:DetectionMethod .

LFTDO4:isAttachedTo a owl:ObjectProperty ;
    rdfs:label "isAttachedToLivestock" ;
    rdfs:comment "Device(EndDevice) is attached to some Livestock" ;
    rdfs:domain LFTDO4:EndDevice ;
    rdfs:range LFTDO4:Livestock ;
    owl:inverseOf LFTDO4:isAttachedToDevice .

LFTDO4:isBiologicallyAffectedBy a owl:ObjectProperty ;
    rdfs:label "isBiologicallyAffectedBy" ;
    rdfs:comment "Livestock isBiologicallyAffectedBy HealthCondition" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range LFTDO4:HealthCondition ;
    rdfs:subPropertyOf owl:topObjectProperty .

LFTDO4:isComponentOf a owl:ObjectProperty ;
    rdfs:label "Represents the components of securedGuarded RestrictedArea Location",
        "isComponentOf" ;
    rdfs:range LFTDO4:RestrictedArea .

LFTDO4:isContextOf a owl:ObjectProperty ;
    rdfs:label "isContextOf" ;
    rdfs:comment """EnvironmentalCondition is context of some BehaviourState

isContextOf (Passive/Spatio-Temporal): This simply means the behavior and the environment happened at the same time and place.
Example: "The sheep is grazing while it is raining.\"""" ;
    rdfs:domain LFTDO4:EnvironmentalCondition ;
    rdfs:range LFTDO4:BehaviourState .

LFTDO4:isCurrentLocationOf a owl:ObjectProperty ;
    rdfs:label "isCurrentLocationOf" ;
    rdfs:comment "Inverse of hasCurrentLocation to tell which Livestock occupy the location at any point in time." .

LFTDO4:isCurrentStatusOf a owl:ObjectProperty ;
    rdfs:label "isCurrentStatusOf" ;
    rdfs:domain LFTDO4:StatusUpdateEvent ;
    rdfs:range LFTDO4:Livestock .

LFTDO4:isDeployedOn a owl:ObjectProperty ;
    rdfs:label "isDeployedOn" ;
    rdfs:comment "SoftwareApplication is deployed on some cloudservice." ;
    rdfs:domain LFTDO4:SoftwareApplication ;
    rdfs:range LFTDO4:CloudService .

LFTDO4:isDetectedBy a owl:ObjectProperty ;
    rdfs:label "isDetectedBy" ;
    rdfs:comment "System or Livestock Event is detected by some DetectionMethod" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( LFTDO4:LivestockIndicator LFTDO4:SystemEvent ) ] ;
    rdfs:range LFTDO4:DetectionMethod .

LFTDO4:isDeviceOnline a owl:DatatypeProperty ;
    rdfs:label "isDeviceOnline" ;
    rdfs:comment "Device has isDeviceOnline indicator" ;
    rdfs:domain LFTDO4:Device ;
    rdfs:range xsd:boolean .

LFTDO4:isExperiencedBy a owl:ObjectProperty ;
    rdfs:label "isExperiencedBy" ;
    rdfs:comment "HealthCondition isExperiencedBy Livestock" ;
    rdfs:domain LFTDO4:HealthCondition ;
    rdfs:range LFTDO4:Livestock .

LFTDO4:isExternallyAffectedBy a owl:ObjectProperty ;
    rdfs:label "isExternallyAffectedBy" ;
    rdfs:comment "Livestock isExternallyAffectedBy EnvironmentalCondition" ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range LFTDO4:EnvironmentalCondition .

LFTDO4:isIdentifiedBy a owl:ObjectProperty ;
    rdfs:label "isIdentifiedBy" ;
    rdfs:comment "BehaviourState is isIdentifiedBy Detection Method." ;
    rdfs:domain LFTDO4:BehaviourState ;
    rdfs:range LFTDO4:DetectionMethod .

LFTDO4:isImplementedBy a owl:ObjectProperty ;
    rdfs:label "isImplementedBy" ;
    rdfs:comment """DetectionMethod isImplementedBy SoftwareApplication.

Usually, a specific logical Method (the "Theft Logic") is implemented by one specific Software Application. While there could be two apps doing the same thing, it’s rarely efficient in IoT.""" ;
    rdfs:domain LFTDO4:DetectionMethod ;
    rdfs:range LFTDO4:SoftwareApplication .

LFTDO4:isLocationOfIncident a owl:ObjectProperty ;
    rdfs:label "isLocationOfIncident" ;
    rdfs:comment "Location isLocationOf some LivestockEvent" ;
    rdfs:domain LFTDO4:Location ;
    rdfs:range LFTDO4:LivestockEvent .

LFTDO4:isNearBoundary a owl:ObjectProperty ;
    rdfs:label "isNearBoundary" ;
    rdfs:comment "Represent a spatial relationship between an entity (like a Livestock) and a specific Boundary instance." ;
    rdfs:domain LFTDO4:Livestock ;
    rdfs:range LFTDO4:Boundary .

LFTDO4:isSecurelyGuarded a owl:ObjectProperty ;
    rdfs:label "isSecurelyGuarded" ;
    rdfs:comment "This an RestrictedArea or Location that is securely guarded by the EndDevices" ;
    rdfs:domain LFTDO4:Location ;
    rdfs:range LFTDO4:EndDevice .

LFTDO4:isSensorOf a owl:ObjectProperty ;
    rdfs:label "Sensor isSensorOf some Device",
        "isSensorOf" ;
    rdfs:domain LFTDO4:Sensor ;
    rdfs:range LFTDO4:Device .

LFTDO4:isStoredOn a owl:ObjectProperty ;
    rdfs:label "isStoredOn" ;
    rdfs:comment "Database is stored on some cloudservice" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range LFTDO4:CloudService ;
    rdfs:subPropertyOf owl:topObjectProperty .

LFTDO4:isSupportedBy a owl:ObjectProperty ;
    rdfs:label "isSupportedBy" ;
    rdfs:comment "LivestockEvent is supportedby some LivestockIndicator" ;
    rdfs:domain LFTDO4:LivestockEvent ;
    rdfs:range LFTDO4:LivestockIndicator .

LFTDO4:logGeneratedBy a owl:ObjectProperty ;
    rdfs:label "logGeneratedBy" ;
    rdfs:comment "RoutineLogEvent isGeneratedBy some Software" ;
    rdfs:domain LFTDO4:RoutineLogEvent ;
    rdfs:range LFTDO4:SoftwareApplication .

LFTDO4:receivesDataFrom a owl:ObjectProperty ;
    rdfs:label "receivesDataFrom" ;
    rdfs:comment "CloudService receive data from some Data Transmission" ;
    rdfs:domain LFTDO4:CloudService ;
    rdfs:range LFTDO4:DataTransmission .

LFTDO4:recordsEvent a owl:ObjectProperty ;
    rdfs:label "records" ;
    rdfs:comment """LivestockIndicator or Software Application records some RoutineLogEvent in the Database.
The software writes to the log.""" ;
    rdfs:domain LFTDO4:Database ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( LFTDO4:LivestockEvent LFTDO4:SensorData LFTDO4:SystemEvent ) ] .

LFTDO4:representsDataType a owl:DatatypeProperty ;
    rdfs:label "representsDataType" ;
    rdfs:comment """SensorData has present some DataType.
"Motion," "Position," or "Biometric\"""" ;
    rdfs:domain LFTDO4:SensorData ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

LFTDO4:statusInitiatedBy a owl:ObjectProperty ;
    rdfs:label "statusUpdateInitiatedBy" ;
    rdfs:comment "StatusUpdateEvent is initiated by some SoftwareApplication" ;
    rdfs:domain LFTDO4:StatusUpdateEvent ;
    rdfs:range LFTDO4:BehaviourState .

LFTDO4:transmittedSensorDataFrom a owl:ObjectProperty ;
    rdfs:label "transmittedSensorDataFrom" .

LFTDO4:updatesUI a owl:ObjectProperty ;
    rdfs:label "updatesUI" ;
    rdfs:comment "StatusUpdateEvent updates some SoftwareApplication's UserInterface" ;
    rdfs:domain LFTDO4:StatusUpdateEvent ;
    rdfs:range LFTDO4:SoftwareApplication .

:MaxLon a swrl:Variable .

:MinLat a swrl:Variable .

:MinLon a swrl:Variable .

:PosturalOrientation a swrl:Variable .

:SignalStrength a swrl:Variable .

:StepCount a swrl:Variable .

:b a swrl:Variable .

:baseDirection a swrl:Variable .

:baseDiv a swrl:Variable .

:baseIntensity a swrl:Variable .

:basePosturalOrientation a swrl:Variable .

:baseSignalStrength a swrl:Variable .

:baseTemp a swrl:Variable .

:baseV a swrl:Variable .

:cTemp a swrl:Variable .

:direction a swrl:Variable .

:isLocatedIn a swrl:Variable .

:isolation a swrl:Variable .

:movementIntensity a swrl:Variable .

:restless a swrl:Variable .

:sameLocation a swrl:Variable .

:speedDif a swrl:Variable .

:speedDifPercentage a swrl:Variable .

:speedFraction a swrl:Variable .

LFTDO4:BodyTemperature a owl:Class ;
    rdfs:label "BodyTemperature" ;
    rdfs:comment "Body temperature serves as a key vital sign in assessing livestock health, offering important  insights into the physiological status and general well-being of animals." ;
    rdfs:subClassOf LFTDO4:HealthCondition .

LFTDO4:Boundary a owl:Class ;
    rdfs:comment "The RestrictedArea is a location in a farm that isSecuredGuardedBy only EndUser device." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLatitude ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isUsedByFarmer ;
            owl:someValuesFrom LFTDO4:Farmer ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationType ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasFence ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:isMonitoredByDevice ;
            owl:someValuesFrom LFTDO4:Device ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLongitude ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty LFTDO4:hasLocationName ;
            owl:someValuesFrom xsd:string ],
        LFTDO4:Location ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( LFTDO4:Location [ a owl:Restriction ;
                                    owl:onProperty LFTDO4:isAdjacentTo ;
                                    owl:someValuesFrom LFTDO4:Location ] ) ] [ a owl:Restriction ;
                        owl:onProperty LFTDO4:isComponentOf ;
                        owl:someValuesFrom LFTDO4:RestrictedArea ] ) ] .

LFTDO4:Cow001 a owl:NamedIndividual,
        LFTDO4:Cattle ;
    rdfs:label "Cow001"^^xsd:string ;
    rdfs:comment "Cow001"^^xsd:string ;
    LFTDO4:exhibits LFTDO4:cowRunning001 ;
    LFTDO4:experiences LFTDO4:CowWithFever001 ;
    LFTDO4:hasAnimalID "Cow001"^^xsd:string ;
    LFTDO4:hasBodyTemperature 40.0 ;
    LFTDO4:hasBreed "Bonsmara"^^xsd:string ;
    LFTDO4:hasCurrentLocation LFTDO4:OpenFieldLocation001 ;
    LFTDO4:hasRunningSpeed 35.0 ;
    LFTDO4:hasSpecies "Cattle"^^xsd:string ;
    LFTDO4:isAdjacentTo LFTDO4:Farm001BoundaryFence ;
    LFTDO4:isLocatedAtFarm LFTDO4:Farm001 ;
    LFTDO4:isOwnedByFarmer LFTDO4:Farmer001 .

